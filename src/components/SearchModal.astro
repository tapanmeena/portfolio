---
import { Search, X } from "@lucide/astro";
---

<!-- Search Modal -->
<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="search-backdrop" id="search-backdrop"></div>

  <div class="search-stage">
    <div class="search-card">
      <!-- Issue line -->
      <p class="sm-issue">
        <span class="sm-tag">grep</span>
        <span class="dl-sep">·</span>
        <span>writing&nbsp;·&nbsp;projects</span>
        <span class="dl-spacer"></span>
        <span class="sm-kbd-hint"><kbd>ESC</kbd>&nbsp;to close</span>
      </p>

      <div class="sm-rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>

      <!-- Search input -->
      <div class="sm-input-row">
        <span class="sm-prompt" aria-hidden="true">grep&nbsp;»</span>
        <input
          type="text"
          id="search-input"
          class="sm-input"
          placeholder="title, description, tag, tech…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search"
        />
        <button id="search-close" class="sm-close" aria-label="Close search" type="button">
          <X size={14} />
        </button>
      </div>

      <!-- Filter chips -->
      <div class="sm-filters" role="group" aria-label="Filter results">
        <span class="sm-filter-tag">filter</span>
        <button class="sm-chip active" data-filter="all" type="button">all</button>
        <button class="sm-chip" data-filter="blog" type="button">writing</button>
        <button class="sm-chip" data-filter="project" type="button">projects</button>
      </div>

      <!-- Results -->
      <div class="sm-results" id="search-results">
        <!-- Recent searches -->
        <section id="recent-searches" class="sm-recent">
          <header class="sm-section-head">
            <span>recent</span>
            <button id="clear-recent" class="sm-clear" type="button" aria-label="Clear recent searches">— clear</button>
          </header>
          <ul id="recent-list" class="sm-list"></ul>
        </section>

        <!-- Live results -->
        <ul id="results-list" class="sm-list sm-results-list"></ul>

        <!-- No results -->
        <div id="no-results" class="sm-empty hidden">
          <p>— no entries match <em>"<span id="search-query"></span>"</em> —</p>
          <p class="sm-empty-hint">try fewer words, or check the spelling</p>
        </div>

        <!-- Loading -->
        <div id="search-loading" class="sm-loading hidden">
          <span class="sm-loading-dot" aria-hidden="true"></span>
          <span>loading index…</span>
        </div>
      </div>

      <!-- Footer / keymap -->
      <footer class="sm-footer">
        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span class="dl-sep">·</span>
        <span><kbd>↵</kbd> open</span>
        <span class="dl-sep">·</span>
        <span><kbd>ESC</kbd> close</span>
      </footer>
    </div>
  </div>
</div>

<script>
  import Fuse from "fuse.js";
  import type { FuseResult } from "fuse.js";
  import { fuseOptions, saveRecentSearch, getRecentSearches, clearRecentSearches, type SearchItem } from "@utils/search";

  const modal = document.getElementById("search-modal")!;
  const backdrop = document.getElementById("search-backdrop")!;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const closeBtn = document.getElementById("search-close")!;
  const resultsList = document.getElementById("results-list")!;
  const recentSearches = document.getElementById("recent-searches")!;
  const recentList = document.getElementById("recent-list")!;
  const clearRecentBtn = document.getElementById("clear-recent")!;
  const noResults = document.getElementById("no-results")!;
  const searchQuery = document.getElementById("search-query")!;
  const loadingEl = document.getElementById("search-loading")!;
  const filterBtns = document.querySelectorAll(".sm-chip");

  let searchIndex: SearchItem[] | null = null;
  let fuse: Fuse<SearchItem> | null = null;
  let currentFilter: "all" | "blog" | "project" = "all";
  let selectedIndex = -1;
  let debounceTimer: ReturnType<typeof setTimeout>;

  function debounce(fn: () => void, delay: number) {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(fn, delay);
  }

  async function loadSearchIndex() {
    if (searchIndex) return;
    loadingEl.classList.remove("hidden");
    try {
      const response = await fetch("/search-index.json");
      searchIndex = await response.json();
      fuse = new Fuse(searchIndex!, fuseOptions);
    } catch (error) {
      console.error("Failed to load search index:", error);
    } finally {
      loadingEl.classList.add("hidden");
    }
  }

  function openModal() {
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    loadSearchIndex();
    showRecentSearches();
    setTimeout(() => input.focus(), 50);
  }

  function closeModal() {
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    input.value = "";
    resultsList.innerHTML = "";
    selectedIndex = -1;
  }

  function showRecentSearches() {
    const recent = getRecentSearches();
    if (recent.length === 0) {
      recentSearches.classList.add("hidden");
      return;
    }
    recentList.innerHTML = recent
      .map(
        (query, i) => `
        <li class="sm-item sm-item-recent" data-index="${i}" data-query="${escapeHtml(query)}">
          <span class="sm-item-num">${String(i + 1).padStart(2, "0")}</span>
          <span class="sm-item-body">
            <span class="sm-item-title">${escapeHtml(query)}</span>
            <span class="sm-item-desc">recent search · click to repeat</span>
          </span>
          <span class="sm-item-arrow" aria-hidden="true">↺</span>
        </li>`,
      )
      .join("");
    recentSearches.classList.remove("hidden");
    noResults.classList.add("hidden");
    resultsList.innerHTML = "";
  }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function performSearch(query: string) {
    if (!fuse || !query.trim()) {
      showRecentSearches();
      return;
    }
    recentSearches.classList.add("hidden");
    let results = fuse.search(query);
    if (currentFilter !== "all") {
      results = results.filter((r) => r.item.type === currentFilter);
    }
    if (results.length === 0) {
      resultsList.innerHTML = "";
      noResults.classList.remove("hidden");
      searchQuery.textContent = query;
      return;
    }
    noResults.classList.add("hidden");
    renderResults(results);
    selectedIndex = -1;
  }

  function getResultMeta(item: SearchItem): string {
    const meta: string[] = [];
    if (item.tags && item.tags.length > 0) meta.push(...item.tags.slice(0, 3).map((t) => `#${t.toLowerCase().replace(/\s+/g, "-")}`));
    if (item.techStack && item.techStack.length > 0) meta.push(...item.techStack.slice(0, 3).map((t) => t.toLowerCase()));
    if (!meta.length) return "";
    return meta
      .slice(0, 4)
      .map((m) => escapeHtml(m))
      .join(" · ");
  }

  function renderResults(results: FuseResult<SearchItem>[]) {
    resultsList.innerHTML = results
      .map((result, i) => {
        const item = result.item;
        const typeLabel = item.type === "blog" ? "writing" : "project";
        const cat = item.category ? escapeHtml(item.category.toLowerCase()) : "";
        const desc = escapeHtml(item.description.slice(0, 160)) + (item.description.length > 160 ? "…" : "");
        const meta = getResultMeta(item);
        return `
        <li class="sm-item sm-item-result" data-index="${i}" data-url="${escapeHtml(item.url)}">
          <span class="sm-item-num">${String(i + 1).padStart(2, "0")}</span>
          <span class="sm-item-body">
            <span class="sm-item-head">
              <span class="sm-item-type sm-item-type-${item.type}">${typeLabel}</span>
              ${cat ? `<span class="sm-item-cat">${cat}</span>` : ""}
            </span>
            <span class="sm-item-title">${escapeHtml(item.title)}</span>
            <span class="sm-item-desc">${desc}</span>
            ${meta ? `<span class="sm-item-meta">${meta}</span>` : ""}
          </span>
          <span class="sm-item-arrow" aria-hidden="true">→</span>
        </li>`;
      })
      .join("");
  }

  function navigateToResult(url: string, query: string) {
    if (query.trim()) saveRecentSearch(query);
    window.location.href = url;
  }

  function updateSelection(newIndex: number) {
    const items = resultsList.querySelectorAll(".sm-item") as NodeListOf<HTMLElement>;
    if (items.length === 0) return;
    items.forEach((item) => item.classList.remove("selected"));
    if (newIndex >= 0 && newIndex < items.length) {
      selectedIndex = newIndex;
      const selectedItem = items[selectedIndex];
      selectedItem.classList.add("selected");
      selectedItem.scrollIntoView({ block: "nearest" });
    }
  }

  // ── Event listeners ──
  document.getElementById("search-btn")?.addEventListener("click", openModal);
  closeBtn.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      modal.classList.contains("open") ? closeModal() : openModal();
    }
    if (e.key === "Escape" && modal.classList.contains("open")) closeModal();
  });

  input.addEventListener("input", () => debounce(() => performSearch(input.value), 200));

  input.addEventListener("keydown", (e) => {
    const items = resultsList.querySelectorAll(".sm-item");
    if (e.key === "ArrowDown") {
      e.preventDefault();
      updateSelection(Math.min(selectedIndex + 1, items.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      updateSelection(Math.max(selectedIndex - 1, 0));
    } else if (e.key === "Enter" && selectedIndex >= 0) {
      e.preventDefault();
      const selectedItem = items[selectedIndex] as HTMLElement;
      const url = selectedItem.dataset.url;
      if (url) navigateToResult(url, input.value);
    }
  });

  resultsList.addEventListener("click", (e) => {
    const item = (e.target as HTMLElement).closest(".sm-item-result") as HTMLElement;
    if (item?.dataset.url) navigateToResult(item.dataset.url, input.value);
  });

  recentList.addEventListener("click", (e) => {
    const item = (e.target as HTMLElement).closest(".sm-item-recent") as HTMLElement;
    if (item?.dataset.query) {
      input.value = item.dataset.query;
      performSearch(item.dataset.query);
    }
  });

  clearRecentBtn.addEventListener("click", () => {
    clearRecentSearches();
    recentSearches.classList.add("hidden");
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      currentFilter = (btn as HTMLElement).dataset.filter as "all" | "blog" | "project";
      if (input.value.trim()) performSearch(input.value);
    });
  });
</script>

<style is:global>
  @reference "tailwindcss";

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 8vh 1rem 1rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }
  .search-modal.open {
    opacity: 1;
    visibility: visible;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top, color-mix(in srgb, var(--color-accent) 6%, transparent), transparent 60%),
      color-mix(in srgb, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(6px);
  }
  .search-stage {
    position: relative;
    width: min(720px, 100%);
    max-height: calc(100vh - 16vh);
    transform: translateY(8px);
    transition: transform 0.25s ease;
  }
  .search-modal.open .search-stage {
    transform: translateY(0);
  }

  .search-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow:
      0 1px 0 var(--color-border),
      0 22px 60px -22px rgba(0, 0, 0, 0.35);
    color: var(--color-text);
    padding: 1rem 1.1rem 0.9rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 16vh);
    overflow: hidden;
  }

  /* ─── Issue line ─── */
  .sm-issue {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    margin: 0 0 0.5rem;
    font-size: 0.66rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .sm-tag {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }
  .dl-spacer {
    flex: 1;
    min-width: 8px;
  }
  .sm-kbd-hint kbd {
    display: inline-block;
    padding: 1px 5px;
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: 3px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.62rem;
  }

  /* ─── Hairline rule ─── */
  .sm-rule {
    display: flex;
    align-items: center;
    margin: 0.4rem -0.2rem 0.7rem;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 7px;
    background: var(--color-text);
    opacity: 0.85;
  }

  /* ─── Input row ─── */
  .sm-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    margin-bottom: 0.7rem;
  }
  .sm-prompt {
    color: var(--color-muted);
    font-weight: 600;
    user-select: none;
    flex-shrink: 0;
  }
  .sm-input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.92rem;
    padding: 4px 0;
  }
  .sm-input::placeholder {
    color: var(--color-muted);
    opacity: 0.7;
  }
  .sm-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: 0;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .sm-close:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  /* ─── Filters ─── */
  .sm-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 6px;
    padding: 0 0 0.7rem;
    border-bottom: 1px dashed var(--color-border);
    margin-bottom: 0.5rem;
  }
  .sm-filter-tag {
    color: var(--color-muted);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.6rem;
    margin-right: 4px;
  }
  .sm-filter-tag::after {
    content: ":";
    margin-left: 1px;
  }
  .sm-chip {
    padding: 2px 8px;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.74rem;
    border-radius: 0;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .sm-chip:hover {
    color: var(--color-text);
    background: var(--color-bg);
  }
  .sm-chip.active {
    color: var(--color-bg);
    background: var(--color-text);
    font-weight: 600;
  }

  /* ─── Results scroller ─── */
  .sm-results {
    flex: 1;
    overflow-y: auto;
    margin: 0 -0.4rem;
    padding: 0 0.4rem;
    scrollbar-width: thin;
  }

  .sm-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }
  .sm-clear {
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.66rem;
    padding: 0;
  }
  .sm-clear:hover {
    color: var(--color-text);
  }

  .sm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .sm-item {
    display: grid;
    grid-template-columns: 28px 1fr 16px;
    gap: 12px;
    padding: 0.65rem 0.4rem;
    align-items: start;
    cursor: pointer;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    color: inherit;
    text-decoration: none;
    transition: background 0.15s ease;
    position: relative;
  }
  .sm-list .sm-item:first-child {
    border-top: 0;
  }
  .sm-item::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .sm-item:hover,
  .sm-item.selected {
    background: var(--color-bg);
  }
  .sm-item:hover::before,
  .sm-item.selected::before {
    opacity: 1;
  }
  .sm-item.selected .sm-item-title {
    color: var(--color-accent);
  }
  .sm-item.selected .sm-item-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .sm-item-num {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-muted);
    padding-top: 4px;
    font-family: ui-monospace, monospace;
  }
  .sm-item-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sm-item-head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 2px;
  }
  .sm-item-type {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid currentColor;
    line-height: 1;
  }
  .sm-item-type-blog {
    color: #3b82f6;
  }
  .sm-item-type-project {
    color: #10b981;
  }
  .sm-item-cat {
    display: inline;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  .sm-item-cat::before {
    content: "· ";
    color: var(--color-border);
  }
  .sm-item-title {
    display: block;
    font-family: "Merriweather", Georgia, serif;
    font-style: normal;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-text);
  }
  .sm-item-desc {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .sm-item-meta {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-top: 2px;
    word-break: break-word;
  }
  .sm-item-arrow {
    align-self: center;
    color: var(--color-muted);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
    font-size: 0.85rem;
  }
  .sm-item:hover .sm-item-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  /* ─── Empty / loading ─── */
  .sm-empty {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .sm-empty p {
    margin: 0;
    font-style: italic;
  }
  .sm-empty em {
    font-family: "Merriweather", Georgia, serif;
    color: var(--color-text);
    font-style: italic;
  }
  .sm-empty-hint {
    margin-top: 6px !important;
    font-size: 0.72rem;
  }
  .sm-empty.hidden {
    display: none;
  }

  .sm-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 2rem;
    color: var(--color-muted);
    font-size: 0.82rem;
  }
  .sm-loading.hidden {
    display: none;
  }
  .sm-loading-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: sm-pulse 1s infinite ease-in-out;
  }
  @keyframes sm-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .sm-recent.hidden {
    display: none;
  }

  /* ─── Footer keymap ─── */
  .sm-footer {
    margin-top: 0.6rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
    font-size: 0.66rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .sm-footer kbd {
    display: inline-block;
    padding: 1px 5px;
    margin: 0 1px;
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: 3px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.62rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-stage,
    .sm-loading-dot {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
