---
import { Moon, Sun, Search, Menu, X } from "@lucide/astro";
import "@styles/global.css";

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "home", abbr: "00" },
  { href: "/projects", label: "projects", abbr: "01" },
  { href: "/blog", label: "writing log", abbr: "02" },
  { href: "/cursed-knowledge", label: "cursed", abbr: "03" },
  { href: "/about", label: "about", abbr: "04" },
  { href: "/contact", label: "contact", abbr: "05" },
];

const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header id="site-header" class="site-header">
  <div class="scroll-progress" id="scroll-progress"></div>

  <div class="header-inner">
    <!-- Logo / wordmark -->
    <a href="/" class="logo" aria-label="Home">
      <span class="logo-mono">tm</span>
      <span class="logo-divider" aria-hidden="true"></span>
      <span class="logo-name">
        <span class="logo-pre">the</span>
        <span class="logo-main">workshop log</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a href={link.href} class:list={["nav-link", { active: isActive(link.href) }]}>
            <span class="nav-num">{link.abbr}</span>
            <span class="nav-label">{link.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="actions">
      <button id="search-btn" aria-label="Search" class="action-btn search-btn" type="button">
        <Search size={13} />
        <span class="sr-text">search</span>
        <kbd class="kbd">
          <span class="kbd-mod"></span>K
        </kbd>
      </button>

      <button id="theme-toggle" aria-label="Toggle theme" class="action-btn icon-only" type="button">
        <Sun
          size={15}
          class="absolute transition-all duration-300 text-amber-500 opacity-100 rotate-0 scale-100 dark:opacity-0 dark:rotate-90 dark:scale-75"
        />
        <Moon
          size={15}
          class="absolute transition-all duration-300 text-indigo-300 opacity-0 -rotate-90 scale-75 dark:opacity-100 dark:rotate-0 dark:scale-100"
        />
      </button>

      <button id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" class="action-btn icon-only md:hidden!" type="button">
        <Menu size={16} class="menu-open-icon" />
        <X size={16} class="menu-close-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-nav" class="mobile-nav md:hidden!" aria-label="Primary mobile">
    {
      navLinks.map((link) => (
        <a href={link.href} class:list={["mobile-link", { active: isActive(link.href) }]}>
          <span class="mobile-num">{link.abbr}</span>
          <span class="mobile-label">{link.label}</span>
        </a>
      ))
    }
  </nav>
</header>

<div id="menu-backdrop" class="menu-backdrop"></div>

<script is:inline>
  const header = document.getElementById("site-header");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const menuBackdrop = document.getElementById("menu-backdrop");
  const scrollProgress = document.getElementById("scroll-progress");

  const onScroll = () => {
    header.classList.toggle("is-scrolled", window.scrollY > 16);
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const p = docH > 0 ? (window.scrollY / docH) * 100 : 0;
    scrollProgress.style.width = p + "%";
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  onScroll();

  document.getElementById("theme-toggle").addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  const openMenu = () => {
    header.classList.add("menu-open");
    mobileNav.classList.add("menu-open");
    menuToggle.classList.add("menu-open");
    menuBackdrop.classList.add("visible");
    menuToggle.setAttribute("aria-expanded", "true");
  };
  const closeMenu = () => {
    header.classList.remove("menu-open");
    mobileNav.classList.remove("menu-open");
    menuToggle.classList.remove("menu-open");
    menuBackdrop.classList.remove("visible");
    menuToggle.setAttribute("aria-expanded", "false");
  };
  menuToggle.addEventListener("click", () => {
    mobileNav.classList.contains("menu-open") ? closeMenu() : openMenu();
  });
  menuBackdrop.addEventListener("click", closeMenu);
  mobileNav.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
</script>

<style>
  @reference "tailwindcss";

  /* ─── HEADER SHELL ─── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .site-header.menu-open {
    border-bottom-color: var(--color-border);
    background: var(--color-bg);
  }

  .scroll-progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 1px;
    width: 0%;
    background: var(--color-text);
    transition: width 0.1s linear;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ─── LOGO ─── */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .logo-mono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-text);
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 900;
    font-size: 0.92rem;
    line-height: 1;
    color: var(--color-text);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .logo:hover .logo-mono {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .logo-divider {
    width: 1px;
    height: 24px;
    background: var(--color-border);
  }
  .logo-name {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1;
  }
  .logo-pre {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .logo-main {
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    letter-spacing: -0.005em;
  }
  @media (max-width: 540px) {
    .logo-divider,
    .logo-name {
      display: none;
    }
  }

  /* ─── DESKTOP NAV ─── */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 2px;
  }
  @media (min-width: 880px) {
    .nav-desktop {
      display: flex;
    }
  }
  .nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: 5px 10px;
    text-decoration: none;
    color: var(--color-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    transition:
      color 0.15s ease,
      background 0.15s ease;
    border-radius: 3px;
  }
  .nav-num {
    font-size: 0.62rem;
    color: var(--color-border);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .nav-label {
    font-weight: 500;
  }
  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .nav-link:hover .nav-num {
    color: var(--color-muted);
  }
  .nav-link.active {
    color: var(--color-text);
    font-weight: 600;
  }
  .nav-link.active .nav-num {
    color: var(--color-accent);
  }

  /* ─── ACTIONS ─── */
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 30px;
    padding: 0 10px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
    border-radius: 4px;
  }
  .action-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }
  .icon-only {
    width: 30px;
    padding: 0;
    position: relative;
  }
  .sr-text {
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .search-btn:hover .sr-text {
    color: var(--color-text);
  }
  @media (max-width: 720px) {
    .sr-text {
      display: none;
    }
  }
  .kbd {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 1px 5px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: var(--color-bg);
    font-size: 0.64rem;
    color: var(--color-muted);
    font-family: ui-monospace, monospace;
  }
  .kbd-mod::before {
    content: "Ctrl";
    margin-right: 2px;
  }
  @supports (-webkit-touch-callout: none) {
    .kbd-mod::before {
      content: "⌘";
      margin-right: 1px;
    }
  }
  @media (max-width: 720px), (pointer: coarse) {
    .kbd {
      display: none;
    }
  }

  /* ─── MOBILE NAV ─── */
  .menu-open-icon,
  .menu-close-icon {
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .menu-close-icon {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg);
  }
  .menu-open .menu-open-icon {
    opacity: 0;
    transform: rotate(90deg);
  }
  .menu-open .menu-close-icon {
    opacity: 1;
    transform: rotate(0);
  }

  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    transition:
      max-height 0.3s ease,
      border-color 0.3s ease,
      padding 0.3s ease;
    padding: 0 1.25rem;
    background: var(--color-bg);
  }
  .mobile-nav.menu-open {
    max-height: 500px;
    border-top-color: var(--color-border);
    padding: 0.5rem 1.25rem 1rem;
  }
  .mobile-link {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 8px;
    align-items: baseline;
    padding: 0.7rem 0.2rem;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 1px dashed var(--color-border);
    font-family: ui-monospace, monospace;
    transition:
      padding-left 0.15s ease,
      color 0.15s ease;
  }
  .mobile-link:last-child {
    border-bottom: 0;
  }
  .mobile-link:hover {
    padding-left: 6px;
    color: var(--color-accent);
  }
  .mobile-num {
    font-size: 0.66rem;
    color: var(--color-border);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .mobile-label {
    font-size: 0.92rem;
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 700;
  }
  .mobile-link.active {
    color: var(--color-text);
  }
  .mobile-link.active .mobile-num {
    color: var(--color-accent);
  }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(0, 0, 0, 0);
    pointer-events: none;
    transition: background 0.25s ease;
  }
  .menu-backdrop.visible {
    background: rgba(0, 0, 0, 0.4);
    pointer-events: auto;
  }
  @media (min-width: 880px) {
    .menu-backdrop,
    #mobile-nav {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress,
    .menu-open-icon,
    .menu-close-icon,
    .mobile-nav {
      transition: none !important;
    }
  }
</style>
