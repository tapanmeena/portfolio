---
import { Github, Twitter, Linkedin, Rss, Mail, ArrowUp } from "@lucide/astro";
import { authors } from "@data/authors";

const currentYear = new Date().getFullYear();
const author = authors["tapan-meena"];
const buildDate = new Date().toISOString().slice(0, 10);

const browse = [
  { href: "/", label: "home", abbr: "00" },
  { href: "/projects", label: "projects", abbr: "01" },
  { href: "/blog", label: "writing log", abbr: "02" },
  { href: "/cursed-knowledge", label: "cursed", abbr: "03" },
];
const more = [
  { href: "/about", label: "about", abbr: "04" },
  { href: "/contact", label: "contact", abbr: "05" },
  { href: "/rss.xml", label: "rss feed", abbr: "06" },
];

const socials: { href?: string; label: string; handle: string; icon: any }[] = [
  { href: author.social?.github, label: "github", handle: "tapanmeena", icon: Github },
  { href: author.social?.linkedin, label: "linkedin", handle: "in/tapanmeena", icon: Linkedin },
  { href: author.social?.twitter, label: "twitter", handle: "tapanmeena3", icon: Twitter },
  { href: author.email ? `mailto:${author.email}` : undefined, label: "email", handle: author.email ?? "", icon: Mail },
  { href: "/rss.xml", label: "rss", handle: "/rss.xml", icon: Rss },
];
const socialLinks = socials.filter((s) => s.href);
---

<footer class="footer">
  <div class="footer-inner">
    <!-- Hairline rule (matches site mastheads) -->
    <div class="rule" aria-hidden="true">
      <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
    </div>

    <!-- Sign-off masthead -->
    <div class="signoff">
      <p class="signoff-pre">end of issue</p>
      <p class="signoff-main">
        <em>thanks for reading.</em>
      </p>
      <p class="signoff-by">
        <span>compiled by</span>
        <span class="signoff-name">{author.name}</span>
        <span class="dot">·</span>
        <span>{author.location?.toLowerCase()}</span>
      </p>
    </div>

    <!-- Columns -->
    <div class="cols">
      <section class="col col-brand">
        <h3 class="col-head">colophon</h3>
        <p class="col-bio">
          {author.title}. Building scalable backends and developer tools, writing about the parts that didn't go to plan.
        </p>
        <p class="col-meta">
          set in <em>inter</em> &amp; <em>merriweather</em><br />
          static-rendered with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">astro</a>
        </p>
      </section>

      <section class="col">
        <h3 class="col-head">browse</h3>
        <ul class="col-list">
          {
            browse.map((l) => (
              <li>
                <a href={l.href}>
                  <span class="col-num">{l.abbr}</span>
                  <span class="col-label">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="col">
        <h3 class="col-head">more</h3>
        <ul class="col-list">
          {
            more.map((l) => (
              <li>
                <a href={l.href}>
                  <span class="col-num">{l.abbr}</span>
                  <span class="col-label">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="col col-elsewhere">
        <h3 class="col-head">elsewhere</h3>
        <ul class="col-list">
          {
            socialLinks.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.href?.startsWith("http") ? "_blank" : undefined}
                  rel={s.href?.startsWith("http") ? "noopener noreferrer" : undefined}
                  aria-label={s.label}
                >
                  <span class="col-icon">
                    <s.icon size={11} />
                  </span>
                  <span class="col-handle">{s.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Status / dateline strip -->
    <div class="status">
      <span class="status-cell">
        <span class="status-dot" aria-hidden="true"></span>
        <span>vol.&nbsp;01</span>
      </span>
      <span class="dot">·</span>
      <span class="status-cell">build&nbsp;<b>{buildDate}</b></span>
      <span class="dot">·</span>
      <span class="status-cell">node&nbsp;<b>20</b></span>
      <span class="status-cell status-grow">
        © {currentYear}
        {author.name} ·
        <em>crafted in vim, deployed on a friday</em>
      </span>
      <button id="back-to-top" class="status-top" type="button" aria-label="Back to top">
        <ArrowUp size={11} /> top
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById("back-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style>
  @reference "tailwindcss";

  .footer {
    margin-top: auto;
    background: var(--color-bg);
    overflow-x: hidden;
  }
  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.25rem 1.25rem;
    color: var(--color-text);
  }

  /* ─── Rule (matches mastheads) ─── */
  .rule {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0 0 1.6rem;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  /* ─── Sign-off masthead ─── */
  .signoff {
    text-align: center;
    margin: 0 0 2rem;
  }
  .signoff-pre {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 6px;
  }
  .signoff-main {
    margin: 0 0 6px;
    font-family: "Merriweather", Georgia, serif;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-text);
  }
  .signoff-main em {
    font-style: italic;
  }
  .signoff-by {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .signoff-name {
    color: var(--color-text);
    font-weight: 700;
  }
  .dot {
    color: var(--color-border);
    margin: 0 4px;
  }

  /* ─── Columns ─── */
  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem 2rem;
    padding: 1.4rem 0;
    border-top: 1px dashed var(--color-border);
  }
  @media (min-width: 640px) {
    .cols {
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    }
  }
  .col {
    min-width: 0;
  }
  .col-head {
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.7rem;
    font-weight: 600;
  }
  .col-bio {
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0 0 0.6rem;
    max-width: 320px;
  }
  .col-meta {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .col-meta em {
    font-style: italic;
    color: var(--color-text);
  }
  .col-meta a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .col-meta a:hover {
    color: var(--color-accent);
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .col-list a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    align-items: baseline;
    padding: 3px 0;
    font-family: ui-monospace, monospace;
    font-size: 0.82rem;
    color: var(--color-text);
    text-decoration: none;
    transition:
      padding-left 0.15s ease,
      color 0.15s ease;
  }
  .col-list a:hover {
    color: var(--color-accent);
    padding-left: 4px;
  }
  .col-num {
    font-size: 0.62rem;
    color: var(--color-border);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .col-list a:hover .col-num {
    color: var(--color-muted);
  }
  .col-label,
  .col-handle {
    font-size: 0.82rem;
  }

  .col-elsewhere .col-list a {
    grid-template-columns: 16px 1fr;
    gap: 8px;
    align-items: center;
  }
  .col-icon {
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .col-elsewhere .col-list a:hover .col-icon {
    color: var(--color-accent);
  }

  /* ─── Status strip ─── */
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    padding: 0.9rem 0 0;
    margin-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .status-cell {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }
  .status-cell b {
    color: var(--color-text);
    font-weight: 700;
  }
  .status-grow {
    flex: 1;
    min-width: 8px;
  }
  .status-grow em {
    font-style: italic;
  }
  @media (max-width: 640px) {
    .status {
      font-size: 0.65rem;
    }
    .status-grow {
      flex: 1 1 100%;
      order: 5;
    }
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    display: inline-block;
    box-shadow: 0 0 0 0 #16a34a;
    animation: footPulse 2s infinite;
  }
  @keyframes footPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(22, 163, 74, 0);
    }
  }
  .status-top {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.68rem;
    border-radius: 3px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .status-top:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none !important;
    }
  }
</style>
