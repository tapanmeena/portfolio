---
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  openGymStats,
  tomeStats,
  latestLifeSyncIso,
  buildUnifiedHeatmap52w,
  computeSpineDimensions,
  formatCalendarDay,
  formatShortMonthDay,
  formatDurationMinutes,
  formatWordCountCompact,
  formatHalfStars,
  playingShelf,
} from "@data/life";

const pageDescription =
  "Training consistency from self-hosted openGym, reading telemetry and shelves from Tome, and slow media in rotation off-screen.";

const {
  anchorIso,
  months,
  cells,
  combinedActiveDays52w,
  ytdCombinedDays,
  ytdDualDays,
  ytdElapsedDays,
  d90CombinedDays,
  d90DualDays,
  latestActive,
} = buildUnifiedHeatmap52w(openGymStats, tomeStats);

const ytdYear = anchorIso.slice(0, 4);
const clearedGamesCount = playingShelf.filter((g) => g.status === "cleared").length;
const ytdPctOfYear = Math.round((ytdCombinedDays / ytdElapsedDays) * 100);
const d90PctOfWindow = Math.round((d90CombinedDays / 90) * 100);

const activeDevices = [
  ...new Set(tomeStats.currentlyReading.map((b) => b.device).filter((d): d is string => Boolean(d))),
];
const devicesSubhead =
  activeDevices.length > 0 ? `synced across ${activeDevices.join(" & ")}` : "synced via tome";

const spineItems = tomeStats.stacks.map((item, idx) => {
  const { widthPx, heightPct } = computeSpineDimensions(item);
  const topTag = item.active
    ? "now"
    : item.hours >= 1
      ? `${Math.round(item.hours)}h`
      : formatWordCountCompact(item.wordCount) ?? item.scaleLabel;
  return {
    ...item,
    widthPx,
    heightPct,
    topTag,
    stars: formatHalfStars(item.rating),
    dateLabel: item.lastDate ? formatShortMonthDay(item.lastDate) : null,
    isDefaultSelected: idx === 0,
  };
});

const defaultSpine = spineItems[0] ?? null;
const totalWordsCompact = formatWordCountCompact(tomeStats.totalWordsIndexed);
const hasMarginalia = tomeStats.marginalia.length > 0;

const ytdDualSuffix =
  ytdDualDays > 0
    ? `${ytdDualDays} dual iron+page ${ytdDualDays === 1 ? "day" : "days"}`
    : `${ytdCombinedDays}/${ytdElapsedDays} calendar days`;
const d90DualSuffix =
  d90DualDays > 0
    ? `${d90DualDays} dual iron+page ${d90DualDays === 1 ? "day" : "days"}`
    : `${d90CombinedDays}/90 calendar days`;

const initialStats = [
  {
    v: ytdCombinedDays.toLocaleString(),
    u: "days",
    k: `off-screen active (${ytdYear} ytd)`,
    sub: `${ytdPctOfYear}% of ${ytdYear} · ${ytdDualSuffix}`,
    accent: "both",
  },
  {
    v: tomeStats.windows.ytd.hours.toLocaleString(),
    u: "hrs",
    k: "pages turned (tome)",
    sub: `${tomeStats.windows.ytd.activeDays} reading days · ${tomeStats.streak.bestDays}d best streak`,
    accent: "read",
  },
  {
    v: openGymStats.windows.ytd.tonnage.toLocaleString(),
    u: "t",
    k: "iron moved (opengym)",
    sub: `${openGymStats.windows.ytd.sessions} sessions · ${openGymStats.windows.ytd.sets.toLocaleString()} working sets`,
    accent: "gym",
  },
  {
    v:
      clearedGamesCount > 0
        ? `${tomeStats.windows.ytd.booksFinished} + ${clearedGamesCount}`
        : tomeStats.windows.ytd.booksFinished.toLocaleString(),
    u: clearedGamesCount > 0 ? "" : "vols",
    k: `completed (${ytdYear})`,
    sub:
      clearedGamesCount > 0
        ? `${tomeStats.windows.ytd.booksFinished} volumes read · ${clearedGamesCount} game cleared`
        : `${tomeStats.windows.ytd.booksFinished} volumes finished in tome`,
    accent: "both",
  },
];

const clientPayload = JSON.stringify({
  kickers: {
    combined: {
      title: "52-week off-screen rhythm",
      rest: ` · ${combinedActiveDays52w} active days · ★ pr session · ◆ book finished`,
    },
    iron: {
      title: "52-week iron consistency",
      rest: ` · ${openGymStats.activeDays52w} training days · ★ marks pr session`,
    },
    pages: {
      title: "52-week reading consistency",
      rest: ` · ${tomeStats.activeDays52w} reading days · ◆ marks volume finished`,
    },
  },
  stats: {
    combined: {
      ytd: initialStats,
      "90d": [
        {
          v: d90CombinedDays.toLocaleString(),
          u: "days",
          k: "off-screen active (90d)",
          sub: `${d90PctOfWindow}% of window · ${d90DualSuffix}`,
          accent: "both",
        },
        {
          v: tomeStats.windows.d90.hours.toLocaleString(),
          u: "hrs",
          k: "pages turned (90d)",
          sub: `${tomeStats.windows.d90.activeDays} reading days · ${tomeStats.streak.currentDays}d streak`,
          accent: "read",
        },
        {
          v: openGymStats.windows.d90.tonnage.toLocaleString(),
          u: "t",
          k: "iron moved (90d)",
          sub: `${openGymStats.windows.d90.sessions} sessions · avg ${openGymStats.windows.d90.avgPerWeek} / week`,
          accent: "gym",
        },
        {
          v: tomeStats.windows.d90.booksFinished.toLocaleString(),
          u: tomeStats.windows.d90.booksFinished === 1 ? "vol" : "vols",
          k: "finished (90d)",
          sub:
            tomeStats.windows.d90.pagesTurned > 0
              ? `${tomeStats.windows.d90.pagesTurned.toLocaleString()} live e-ink/web pages`
              : `${tomeStats.windows.d90.sessions} reading sessions`,
          accent: "read",
        },
      ],
    },
    iron: {
      ytd: [
        {
          v: openGymStats.windows.ytd.sessions.toLocaleString(),
          u: "",
          k: `sessions (${ytdYear} ytd)`,
          sub: `avg ${openGymStats.windows.ytd.avgPerWeek} / week`,
          accent: "gym",
        },
        {
          v: openGymStats.streak.currentWeeks.toLocaleString(),
          u: "wks",
          k: "active streak",
          sub: `≥ ${openGymStats.streak.minPerWeek}x / wk · best ${openGymStats.streak.bestWeeks} wks`,
          accent: "gym",
        },
        {
          v: openGymStats.windows.ytd.sets.toLocaleString(),
          u: "",
          k: "working sets",
          sub: "warm-up sets excluded",
          accent: "gym",
        },
        {
          v: openGymStats.windows.ytd.tonnage.toLocaleString(),
          u: "t",
          k: "volume moved",
          sub: `~${openGymStats.windows.ytd.avgTonnage} t / session`,
          accent: "gym",
        },
      ],
      "90d": [
        {
          v: openGymStats.windows.d90.sessions.toLocaleString(),
          u: "",
          k: "sessions (90d)",
          sub: `avg ${openGymStats.windows.d90.avgPerWeek} / week`,
          accent: "gym",
        },
        {
          v: openGymStats.streak.currentWeeks.toLocaleString(),
          u: "wks",
          k: "active streak",
          sub: `≥ ${openGymStats.streak.minPerWeek}x / wk · best ${openGymStats.streak.bestWeeks} wks`,
          accent: "gym",
        },
        {
          v: openGymStats.windows.d90.sets.toLocaleString(),
          u: "",
          k: "working sets (90d)",
          sub: "warm-up sets excluded",
          accent: "gym",
        },
        {
          v: openGymStats.windows.d90.tonnage.toLocaleString(),
          u: "t",
          k: "volume moved (90d)",
          sub: `~${openGymStats.windows.d90.avgTonnage} t / session`,
          accent: "gym",
        },
      ],
    },
    pages: {
      ytd: [
        {
          v: tomeStats.windows.ytd.hours.toLocaleString(),
          u: "hrs",
          k: `reading time (${ytdYear} ytd)`,
          sub: `avg ~${tomeStats.windows.ytd.avgHoursPerWeek} hrs / week`,
          accent: "read",
        },
        {
          v: tomeStats.streak.currentDays.toLocaleString(),
          u: "days",
          k: "reading streak",
          sub: `best ${tomeStats.streak.bestDays} days · ${tomeStats.rolloverHour}am rollover`,
          accent: "read",
        },
        {
          v: tomeStats.windows.ytd.activeDays.toLocaleString(),
          u: "days",
          k: `active days (${ytdYear})`,
          sub: `${tomeStats.windows.ytd.sessions.toLocaleString()} sittings logged`,
          accent: "read",
        },
        {
          v: tomeStats.windows.ytd.booksFinished.toLocaleString(),
          u: "vols",
          k: "volumes finished",
          sub: `${tomeStats.libraryCount} books in tome library`,
          accent: "read",
        },
      ],
      "90d": [
        {
          v: tomeStats.windows.d90.hours.toLocaleString(),
          u: "hrs",
          k: "reading time (90d)",
          sub: `avg ~${tomeStats.windows.d90.avgHoursPerWeek} hrs / week`,
          accent: "read",
        },
        {
          v: tomeStats.streak.currentDays.toLocaleString(),
          u: "days",
          k: "reading streak",
          sub: `best ${tomeStats.streak.bestDays} days · ${tomeStats.rolloverHour}am rollover`,
          accent: "read",
        },
        {
          v: tomeStats.windows.d90.activeDays.toLocaleString(),
          u: "days",
          k: "active days (90d)",
          sub: `${tomeStats.windows.d90.sessions.toLocaleString()} sittings logged`,
          accent: "read",
        },
        {
          v: tomeStats.windows.d90.booksFinished.toLocaleString(),
          u: tomeStats.windows.d90.booksFinished === 1 ? "vol" : "vols",
          k: "finished (90d)",
          sub:
            tomeStats.windows.d90.pagesTurned > 0
              ? `${tomeStats.windows.d90.pagesTurned.toLocaleString()} live pages turned`
              : "synced across devices",
          accent: "read",
        },
      ],
    },
  },
});

const syncedLabel = formatCalendarDay(latestLifeSyncIso, false);
const sourceHost = tomeStats.sourceHost || openGymStats.sourceHost;
const latestDateShort = latestActive ? formatCalendarDay(latestActive.date, false) : null;

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today
  .toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  })
  .toLowerCase();

function pad2(n: number): string {
  return String(n).padStart(2, "0");
}

function cellAriaLabel(cell: (typeof cells)[number]): string {
  if (cell.isFuture) return `${cell.labelDate}: upcoming`;
  const parts: string[] = [];
  if (cell.trained) parts.push(`${cell.routine}, ${cell.sets} sets`);
  if (cell.read) {
    const primary = cell.readTitles[0] ?? "reading";
    parts.push(`${primary}, ${formatDurationMinutes(cell.readMinutes)}`);
  }
  return parts.length > 0 ? `${cell.labelDate}: ${parts.join("; ")}` : `${cell.labelDate}: quiet day`;
}
---

<BaseLayout pageTitle="Life Off-Screen — Tapan Meena" description={pageDescription}>
  <div class="page">
    <!-- ─────────── DATELINE ─────────── -->
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;F&nbsp;//&nbsp;off-screen</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
      <span class="dl-spacer"></span>
      <span class="sync-badge" id="sync-badge">
        <span class="sync-dots" aria-hidden="true">
          <span class="sync-dot" title="openGym"></span>
          <span class="sync-dot read" title="Tome"></span>
        </span>
        <span id="sync-label">opengym + tome · snapshot {syncedLabel} ({sourceHost})</span>
      </span>
    </p>

    <!-- ─────────── MASTHEAD ─────────── -->
    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">field notes from</span>
        <span class="mast-main">life off-screen</span>
      </h1>
      <p class="mast-by">
        <span><i class="swatch-inline gym" aria-hidden="true"></i>iron moved</span>
        <span class="dl-sep">·</span>
        <span><i class="swatch-inline read" aria-hidden="true"></i>pages turned</span>
        <span class="dl-sep">·</span>
        <span>logged on <strong>{sourceHost}</strong>, stripped for public view</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <!-- ─────────── INTRO ─────────── -->
    <section class="intro" aria-label="Overview">
      <p class="lede">
        Most of this site documents software running on a Raspberry Pi in the next room. This page is the ledger for the operator — barbell volume
        from a self-hosted <a href="https://opengym.ch" target="_blank" rel="noopener noreferrer">openGym</a> instance, reading telemetry and shelves
        from <a href="https://github.com/bndct-devops/tome" target="_blank" rel="noopener noreferrer">Tome</a>, and whatever is in rotation when the
        laptop lid closes.
      </p>
      <ul class="jump-links">
        <li>
          <a href="#training"><span class="jump-num">§01</span>the daily ledger (iron + pages)</a>
        </li>
        <li>
          <a href="#nightstand"><span class="jump-num">§02</span>nightstand &amp; stacks (tome)</a>
        </li>
        <li>
          <a href="#backlog"><span class="jump-num">§03</span>{hasMarginalia ? "marginalia & backlog" : "in rotation & backlog"}</a>
        </li>
      </ul>
    </section>

    <!-- ─────────── § 01 THE UNIFIED DAILY LEDGER ─────────── -->
    <section class="block" id="training" aria-labelledby="ledger-heading">
      <header class="block-head">
        <h2 id="ledger-heading"><span class="bh-mark">§</span> the daily ledger</h2>

        <div class="ledger-controls" aria-label="Display controls">
          <div class="ctl-group" role="group" aria-label="Activity lens">
            <span class="ctl-label">lens</span>
            <button class="ctl-btn active" data-lens-btn="combined" type="button">combined</button>
            <button class="ctl-btn" data-lens-btn="iron" type="button">
              <i class="swatch-inline gym tight" aria-hidden="true"></i>iron
            </button>
            <button class="ctl-btn" data-lens-btn="pages" type="button">
              <i class="swatch-inline read tight" aria-hidden="true"></i>pages
            </button>
          </div>

          <div class="ctl-group" role="group" aria-label="Time window">
            <span class="ctl-label">window</span>
            <button class="ctl-btn active" data-window="ytd" type="button">{ytdYear} ytd</button>
            <button class="ctl-btn" data-window="90d" type="button">90 days</button>
          </div>
        </div>
      </header>

      <!-- Adaptive 4-Cell Stat Strip -->
      <ul class="stats" id="stat-strip" aria-label="Off-screen summary">
        {
          initialStats.map((st, idx) => (
            <li class="stat" data-stat-cell={idx} data-accent={st.accent}>
              <span class="stat-v">
                <span data-stat-v>{st.v}</span>
                <span class="stat-unit" data-stat-u hidden={!st.u}>
                  {st.u}
                </span>
              </span>
              <span class="stat-k" data-stat-k>
                {st.k}
              </span>
              <span class="stat-sub" data-stat-sub>
                {st.sub}
              </span>
            </li>
          ))
        }
      </ul>

      <!-- Unified 52-Week Consistency Heatmap -->
      <div class="heatmap-wrap" id="heatmap-wrap" data-lens="combined">
        <div class="heatmap-top">
          <span class="heatmap-kicker">
            <strong id="hm-kicker-title">52-week off-screen rhythm</strong>
            <span id="hm-kicker-rest"> · {combinedActiveDays52w} active days · ★ pr session · ◆ book finished</span>
          </span>

          <span class="heatmap-legend" aria-hidden="true">
            <span>rest</span>
            <span class="leg-cell leg-rest"></span>
            <span class="leg-group leg-gym">
              <span class="leg-sep">·</span>
              <span>iron</span>
              <span class="leg-cell leg-g1"></span>
              <span class="leg-cell leg-g2"></span>
              <span class="leg-cell leg-g3"></span>
            </span>
            <span class="leg-group leg-read">
              <span class="leg-sep">·</span>
              <span>pages</span>
              <span class="leg-cell leg-r1"></span>
              <span class="leg-cell leg-r2"></span>
              <span class="leg-cell leg-r3"></span>
            </span>
            <span class="leg-group leg-both">
              <span class="leg-sep">·</span>
              <span>both</span>
              <span class="leg-cell leg-dual"></span>
            </span>
          </span>
        </div>

        <div class="heatmap-scroll">
          <div class="heatmap-months" aria-hidden="true">
            <span></span>
            {months.map((m) => <span>{m}</span>)}
          </div>
          <div class="heatmap-body">
            <div class="heatmap-days" aria-hidden="true">
              <span></span>
              <span>mon</span>
              <span></span>
              <span>wed</span>
              <span></span>
              <span>fri</span>
              <span></span>
            </div>
            <div class="heatmap-grid" id="hm-grid" role="grid" aria-label="52-week off-screen consistency">
              {
                cells.map((cell) => {
                  const primaryBook = cell.readTitles[0] ?? "";
                  const extraBooks = cell.readTitles.length > 1 ? cell.readTitles.length - 1 : 0;
                  const firstFinished = cell.finishedTitles[0] ?? "";
                  return (
                    <button
                      type="button"
                      class:list={["hm-cell", { "is-future": cell.isFuture }]}
                      data-date={cell.date}
                      data-label={cell.labelDate}
                      data-glv={cell.gymLevel}
                      data-rlv={cell.readLevel}
                      data-trained={cell.trained ? "1" : "0"}
                      data-routine={cell.routine ?? ""}
                      data-sets={cell.sets}
                      data-mins={cell.durationMin ?? ""}
                      data-pr={cell.prs > 0 ? "1" : "0"}
                      data-prs={cell.prs}
                      data-read={cell.read ? "1" : "0"}
                      data-rmins={cell.readMinutes}
                      data-rpages={cell.readPages}
                      data-rbook={primaryBook}
                      data-rextra={extraBooks}
                      data-fin={cell.finishedTitles.length > 0 ? "1" : "0"}
                      data-fincount={cell.finishedTitles.length}
                      data-fintitle={firstFinished}
                      disabled={cell.isFuture}
                      aria-label={cellAriaLabel(cell)}
                    />
                  );
                })
              }
            </div>
          </div>
        </div>

        <div class="heatmap-readout" id="hm-readout" aria-live="polite">
          <span id="hm-readout-left">hover or click any square to inspect workouts &amp; reading sittings</span>
          {
            latestActive && (
              <span id="hm-readout-right">
                latest //{" "}
                <b>
                  {latestDateShort}
                  {latestActive.trained && ` · ${latestActive.routine?.toLowerCase()} (${latestActive.sets} sets)`}
                  {latestActive.read && ` · ${formatDurationMinutes(latestActive.readMinutes)} read`}
                </b>
                {latestActive.prs > 0 && (
                  <span class="pr-chip">
                    {" "}
                    ★ {latestActive.prs} PR{latestActive.prs === 1 ? "" : "s"}
                  </span>
                )}
                {latestActive.finishedTitles.length > 0 && (
                  <span class="fin-chip">
                    {" "}
                    ◆ finished {latestActive.finishedTitles[0].split(":")[0].toLowerCase()}
                  </span>
                )}
              </span>
            )
          }
        </div>
      </div>
    </section>

    <!-- ─────────── § 02 NIGHTSTAND & STACKS (TOME) ─────────── -->
    <section class="block" id="nightstand" aria-labelledby="nightstand-heading">
      <header class="block-head">
        <h2 id="nightstand-heading"><span class="bh-mark">§</span> on the nightstand &amp; stacks</h2>

        <div class="ledger-controls">
          <span class="block-meta">tome · {tomeStats.rolloverHour}am ist rollover</span>
          <div class="ctl-group" role="group" aria-label="Stacks layout">
            <button class="ctl-btn active" data-shelf-view="spines" type="button">spine rack</button>
            <button class="ctl-btn" data-shelf-view="table" type="button">table ledger</button>
          </div>
        </div>
      </header>

      <div class="subhead">
        <h3>currently open</h3>
        <span>{devicesSubhead}</span>
      </div>

      {
        tomeStats.currentlyReading.length > 0 ? (
          <div class="active-reads">
            {tomeStats.currentlyReading.map((book, idx) => {
              const wordsCompact = book.wordCount ? `${book.wordCount.toLocaleString()} words` : null;
              const leftCompact = formatWordCountCompact(book.wordsLeft);
              const seriesMeta =
                book.series && book.seriesIndex !== null
                  ? `${book.series.toLowerCase()} · #${book.seriesIndex}`
                  : book.series
                    ? book.series.toLowerCase()
                    : book.category;
              return (
                <article class="read-card">
                  <div class="book-plate" aria-hidden="true">
                    <span>fig. {pad2(idx + 1)}</span>
                    <strong>{book.progressPct}%</strong>
                  </div>
                  <div class="rc-body">
                    <div class="rc-top">
                      <span>{seriesMeta}</span>
                      <span class="rc-live">● reading{book.device ? ` · ${book.device}` : ""}</span>
                    </div>
                    <h4 class="rc-title">{book.title}</h4>
                    <p class="rc-author">
                      {book.author.toLowerCase()}
                      {wordsCompact ? ` · ${wordsCompact}` : ""}
                    </p>
                    <div class="prog-track" role="progressbar" aria-valuenow={book.progressPct} aria-valuemin={0} aria-valuemax={100}>
                      <div class="prog-fill" style={`width: ${Math.max(2, book.progressPct)}%`} />
                    </div>
                    <div class="rc-foot">
                      <span>
                        <b>{book.progressPct}%</b>
                        {leftCompact ? ` · ~${leftCompact} words left` : ""}
                      </span>
                      <span>
                        {book.estHoursLeft !== null ? `~${book.estHoursLeft}h est` : ""}
                        {book.estHoursLeft !== null && book.lastReadDate ? " · " : ""}
                        {book.lastReadDate ? formatShortMonthDay(book.lastReadDate) : ""}
                      </span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="empty-note">— between books right now —</p>
        )
      }

      <div class="subhead">
        <h3>the {ytdYear} stacks</h3>
        <span>width scaled by word count &amp; hours · series collapsed</span>
      </div>

      <div class="stacks-box" id="stacks-box" data-view="spines">
        <div class="spine-shelf" id="spine-shelf" role="group" aria-label="Books logged in Tome">
          {
            spineItems.map((sp) => (
              <button
                type="button"
                class:list={["spine", { "is-active": sp.isDefaultSelected }]}
                style={`width:${sp.widthPx}px;height:${sp.heightPct}%`}
                data-tone={sp.tone}
                data-title={sp.title}
                data-author={sp.author.toLowerCase()}
                data-category={sp.category}
                data-hours={sp.hours}
                data-scale={sp.scaleLabel}
                data-stars={sp.rating ? sp.stars : ""}
                data-status={sp.status}
                data-date={sp.dateLabel ?? ""}
                aria-label={`${sp.title} by ${sp.author}`}
              >
                <span class="spine-hrs">{sp.topTag}</span>
                <span class="spine-label">{sp.shortTitle}</span>
                {sp.active ? <span class="spine-dot" title="Currently reading" /> : <span />}
              </button>
            ))
          }

          <div class="bookend" aria-hidden="true">
            <strong>stack // {ytdYear}</strong>
            <span>{tomeStats.libraryCount} books in tome</span>
            {totalWordsCompact && <span>~{totalWordsCompact} words indexed</span>}
            <span>click spine to inspect</span>
          </div>
        </div>

        {
          defaultSpine && (
            <div class="spine-detail" id="spine-detail" aria-live="polite">
              <div>
                <span class="spine-detail-title" id="sp-title">
                  {defaultSpine.title}
                </span>
                <span id="sp-by">
                  by {defaultSpine.author.toLowerCase()} · {defaultSpine.category}
                </span>
              </div>
              <div id="sp-meta">
                <b>{defaultSpine.hours} hrs</b> logged · {defaultSpine.scaleLabel}
                {defaultSpine.rating && <span class="stars"> · {defaultSpine.stars}</span>}
                {defaultSpine.dateLabel && <span> · {defaultSpine.dateLabel}</span>}
              </div>
            </div>
          )
        }

        <div class="table-scroll">
          <table class="ledger-table">
            <thead>
              <tr>
                <th>title / series</th>
                <th>author</th>
                <th>scale</th>
                <th>logged</th>
                <th>rating</th>
                <th>state</th>
              </tr>
            </thead>
            <tbody>
              {
                spineItems.map((sp) => (
                  <tr>
                    <td class="t-book">{sp.title}</td>
                    <td>{sp.author.toLowerCase()}</td>
                    <td>{sp.scaleLabel}</td>
                    <td>{sp.hours}h</td>
                    <td>
                      <span class="stars">{sp.stars}</span>
                    </td>
                    <td>{sp.active ? <span class="tag-read">● reading</span> : sp.status}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ─────────── § 03 MARGINALIA & BACKLOG ─────────── -->
    <section class="block" id="backlog" aria-labelledby="backlog-heading">
      <header class="block-head">
        <h2 id="backlog-heading">
          <span class="bh-mark">§</span> {hasMarginalia ? "marginalia & backlog" : "in rotation & backlog"}
        </h2>
        <span class="block-meta">— slow media, zero infinite scroll</span>
      </header>

      <div class:list={["bottom-grid", { "has-marginalia": hasMarginalia }]}>
        {
          hasMarginalia && (
            <div>
              <div class="subhead">
                <h3>commonplace // highlights</h3>
                <span>from shared tome shelves</span>
              </div>
              <div class="marginalia-list">
                {tomeStats.marginalia.slice(0, 3).map((m) => (
                  <blockquote class="quote-card">
                    <p class="quote-text">“{m.text}”</p>
                    <footer class="quote-cite">
                      — <b>{m.bookTitle}</b> · {m.author.toLowerCase()}
                      {m.chapter ? ` · ${m.chapter.toLowerCase()}` : ""}
                      {m.date ? ` · ${formatShortMonthDay(m.date)}` : ""}
                    </footer>
                  </blockquote>
                ))}
              </div>
            </div>
          )
        }

        <div>
          <div class="subhead">
            <h3>playing // controller</h3>
            <span>via beat-the-backlog</span>
          </div>
          <ul class="shelf-list">
            {
              playingShelf.map((item) => (
                <li class="shelf-item">
                  <div>
                    <span class="shelf-title">{item.title}</span>
                    <span class="shelf-by">{item.meta}</span>
                  </div>
                  <span class:list={["shelf-status", { active: item.active }]}>
                    {item.active ? `● ${item.status}` : item.status}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ clientPayload }}>
    const cfg = JSON.parse(clientPayload);
    let currentLens = "combined";
    let currentWindow = "ytd";

    const wrap = document.getElementById("heatmap-wrap");
    const kickerTitle = document.getElementById("hm-kicker-title");
    const kickerRest = document.getElementById("hm-kicker-rest");
    const leftOut = document.getElementById("hm-readout-left");
    const rightOut = document.getElementById("hm-readout-right");

    function fmtMins(mins) {
      if (!mins || mins <= 0) return "0m";
      const h = Math.floor(mins / 60);
      const r = Math.round(mins % 60);
      if (h <= 0) return r + "m";
      return r > 0 ? h + "h " + r + "m" : h + "h";
    }

    function applyStatsAndLens() {
      if (wrap) wrap.setAttribute("data-lens", currentLens);
      const k = cfg.kickers[currentLens];
      if (k && kickerTitle && kickerRest) {
        kickerTitle.textContent = k.title;
        kickerRest.textContent = k.rest;
      }

      const cells = (cfg.stats[currentLens] || {})[currentWindow] || [];
      cells.forEach((item, idx) => {
        const li = document.querySelector(`[data-stat-cell="${idx}"]`);
        if (!li) return;
        li.setAttribute("data-accent", item.accent);
        const vEl = li.querySelector("[data-stat-v]");
        const uEl = li.querySelector("[data-stat-u]");
        const kEl = li.querySelector("[data-stat-k]");
        const sEl = li.querySelector("[data-stat-sub]");
        if (vEl) vEl.textContent = item.v;
        if (uEl) {
          uEl.textContent = item.u || "";
          uEl.hidden = !item.u;
        }
        if (kEl) kEl.textContent = item.k;
        if (sEl) sEl.textContent = item.sub;
      });
    }

    function renderReadout(btn, lockSelection) {
      if (!leftOut || !rightOut || !btn || btn.disabled) return;
      if (lockSelection) {
        document.querySelectorAll("#hm-grid .hm-cell.is-selected").forEach((b) => b.classList.remove("is-selected"));
        btn.classList.add("is-selected");
      }

      const label = btn.getAttribute("data-label") || "";
      const trained = btn.getAttribute("data-trained") === "1" && currentLens !== "pages";
      const read = btn.getAttribute("data-read") === "1" && currentLens !== "iron";
      const fin = btn.getAttribute("data-fin") === "1" && currentLens !== "iron";

      leftOut.textContent = "";
      rightOut.textContent = "";

      const dateStrong = document.createElement("b");
      dateStrong.textContent = label;
      leftOut.appendChild(dateStrong);

      let hasActivity = false;

      if (trained) {
        hasActivity = true;
        leftOut.appendChild(document.createTextNode(" · "));
        const tag = document.createElement("span");
        tag.className = "tag-gym";
        tag.textContent = "iron";
        leftOut.appendChild(tag);

        const routine = (btn.getAttribute("data-routine") || "session").toLowerCase();
        const sets = btn.getAttribute("data-sets") || "0";
        const mins = btn.getAttribute("data-mins");
        const durSuffix = mins ? ` (${mins}m)` : "";
        leftOut.appendChild(document.createTextNode(` ${routine} · ${sets} sets${durSuffix}`));

        const prs = parseInt(btn.getAttribute("data-prs") || "0", 10);
        if (prs > 0) {
          const prSpan = document.createElement("span");
          prSpan.className = "pr-chip";
          prSpan.textContent = `★ ${prs} PR${prs === 1 ? "" : "s"}`;
          rightOut.appendChild(prSpan);
        }
      }

      if (read) {
        leftOut.appendChild(document.createTextNode(hasActivity ? "  //  " : " · "));
        hasActivity = true;
        const tag = document.createElement("span");
        tag.className = "tag-read";
        tag.textContent = "pages";
        leftOut.appendChild(tag);

        const rawBook = btn.getAttribute("data-rbook") || "reading";
        const shortBook = rawBook.length > 38 ? rawBook.slice(0, 36).trimEnd() + "…" : rawBook;
        const extra = parseInt(btn.getAttribute("data-rextra") || "0", 10);
        const rmins = parseInt(btn.getAttribute("data-rmins") || "0", 10);
        const extraSuffix = extra > 0 ? ` +${extra}` : "";
        leftOut.appendChild(document.createTextNode(` ${shortBook.toLowerCase()}${extraSuffix} · ${fmtMins(rmins)}`));
      }

      if (fin) {
        const finCount = parseInt(btn.getAttribute("data-fincount") || "1", 10);
        const finTitle = (btn.getAttribute("data-fintitle") || "volume").split(":")[0].toLowerCase();
        if (rightOut.childNodes.length > 0) {
          rightOut.appendChild(document.createTextNode(" "));
        }
        const finSpan = document.createElement("span");
        finSpan.className = "fin-chip";
        finSpan.textContent = finCount > 1 ? `◆ finished ${finCount} volumes` : `◆ finished ${finTitle}`;
        rightOut.appendChild(finSpan);
      }

      if (!hasActivity && !fin) {
        const quietNote =
          currentLens === "iron"
            ? " · rest / recovery day"
            : currentLens === "pages"
              ? " · no logged pages"
              : " · quiet day (no logged sets or pages)";
        leftOut.appendChild(document.createTextNode(quietNote));
        rightOut.textContent = "off-ledger";
      }
    }

    document.querySelectorAll("#hm-grid .hm-cell").forEach((btn) => {
      btn.addEventListener("mouseenter", () => renderReadout(btn, false));
      btn.addEventListener("focus", () => renderReadout(btn, false));
      btn.addEventListener("click", () => renderReadout(btn, true));
    });

    document.querySelectorAll("[data-lens-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-lens-btn]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentLens = btn.getAttribute("data-lens-btn") || "combined";
        applyStatsAndLens();
        const selected = document.querySelector("#hm-grid .hm-cell.is-selected");
        if (selected) renderReadout(selected, false);
      });
    });

    document.querySelectorAll("[data-window]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-window]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentWindow = btn.getAttribute("data-window") || "ytd";
        applyStatsAndLens();
      });
    });

    // Spine Rack & Table Ledger view switch + spine inspection
    const stacksBox = document.getElementById("stacks-box");
    document.querySelectorAll("[data-shelf-view]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-shelf-view]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        if (stacksBox) stacksBox.setAttribute("data-view", btn.getAttribute("data-shelf-view") || "spines");
      });
    });

    function selectSpine(btn) {
      document.querySelectorAll("#spine-shelf .spine.is-active").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      const titleEl = document.getElementById("sp-title");
      const byEl = document.getElementById("sp-by");
      const metaEl = document.getElementById("sp-meta");
      if (!titleEl || !byEl || !metaEl) return;

      titleEl.textContent = btn.getAttribute("data-title") || "";
      byEl.textContent = `by ${btn.getAttribute("data-author") || ""} · ${btn.getAttribute("data-category") || ""}`;

      metaEl.textContent = "";
      const hrsStrong = document.createElement("b");
      hrsStrong.textContent = `${btn.getAttribute("data-hours") || "0"} hrs`;
      metaEl.appendChild(hrsStrong);
      metaEl.appendChild(document.createTextNode(` logged · ${btn.getAttribute("data-scale") || ""}`));

      const stars = btn.getAttribute("data-stars");
      if (stars) {
        metaEl.appendChild(document.createTextNode(" · "));
        const starSpan = document.createElement("span");
        starSpan.className = "stars";
        starSpan.textContent = stars;
        metaEl.appendChild(starSpan);
      }

      const dateLabel = btn.getAttribute("data-date");
      if (dateLabel) {
        metaEl.appendChild(document.createTextNode(` · ${dateLabel}`));
      }
    }

    document.querySelectorAll("#spine-shelf .spine").forEach((btn) => {
      btn.addEventListener("mouseenter", () => selectSpine(btn));
      btn.addEventListener("focus", () => selectSpine(btn));
      btn.addEventListener("click", () => selectSpine(btn));
    });

    // Support URL hash lens pre-selection (#iron or #pages)
    if (window.location.hash === "#iron" || window.location.hash === "#pages") {
      const lensTarget = window.location.hash.slice(1);
      const btn = document.querySelector(`[data-lens-btn="${lensTarget}"]`);
      if (btn) btn.click();
      const ledgerSection = document.getElementById("training");
      if (ledgerSection) ledgerSection.scrollIntoView({ behavior: "smooth" });
    }
  </script>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .page {
    --color-gym: #10b981;
    --gym-1: #b9f3d4;
    --gym-2: #48bb78;
    --gym-3: #226c47;

    --color-read: #b45309;
    --read-1: #fde6b0;
    --read-2: #ea9a28;
    --read-3: #b45309;

    --color-pr: #d97706;
    --color-fin: #1a202c;
    --heat-0: #eaeff5;
    --surface-subtle: #f4f6f9;

    max-width: 1080px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 5rem;
    color: var(--color-text);
  }

  :global(.dark) .page {
    --color-gym: #34d399;
    --gym-1: #1d4438;
    --gym-2: #1f7a5c;
    --gym-3: #34d399;

    --color-read: #f59e0b;
    --read-1: #3e3020;
    --read-2: #8a5618;
    --read-3: #f59e0b;

    --color-pr: #fbbf24;
    --color-fin: #f8fafc;
    --heat-0: #232d3d;
    --surface-subtle: #1e2634;
  }

  /* ─── Shared broadsheet atoms (rule, dateline, mast) ─── */
  .rule {
    display: flex;
    align-items: center;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }
  .dl-spacer {
    flex: 1;
    min-width: 8px;
  }

  .sync-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    color: var(--color-muted);
  }
  .sync-dots {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gym);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45);
    animation: syncPulse 2.4s infinite;
  }
  .sync-dot.read {
    background: var(--color-read);
    animation-delay: 1.2s;
  }
  @keyframes syncPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  .swatch-inline {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 1px;
    margin-right: 5px;
    vertical-align: middle;
    transform: translateY(-1px);
  }
  .swatch-inline.tight {
    margin-right: 0;
  }
  .swatch-inline.gym {
    background: var(--color-gym);
  }
  .swatch-inline.read {
    background: var(--color-read);
  }

  /* ─── Masthead ─── */
  .mast {
    margin-bottom: 1.5rem;
  }
  .mast-title {
    text-align: center;
    margin: 0.85rem 0 0.55rem;
    line-height: 1;
    font-family: "Merriweather", Georgia, serif;
  }
  .mast-pre {
    display: block;
    font-family: ui-monospace, monospace;
    font-style: normal;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .mast-main {
    display: inline-block;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2.1rem, 5.6vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.05;
  }
  .mast-by {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 10px;
    text-align: center;
    margin: 0.4rem 0 0.65rem;
    font-family: ui-monospace, monospace;
    font-size: 0.76rem;
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }
  .mast-by strong {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ─── Intro ─── */
  .intro {
    padding: 0.4rem 0 1.2rem;
  }
  .lede {
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.04rem;
    line-height: 1.72;
    color: var(--color-text);
    margin: 0 0 0.9rem;
    max-width: 68ch;
  }
  .lede a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }
  .lede a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .jump-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-family: ui-monospace, monospace;
    font-size: 0.76rem;
  }
  .jump-links a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .jump-links a:hover {
    color: var(--color-accent);
  }
  .jump-num {
    color: var(--color-border);
    font-weight: 700;
    margin-right: 5px;
  }

  /* ─── Section blocks ─── */
  .block {
    margin: 2.2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 1rem;
  }
  .block-head h2 {
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.48rem;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-text);
  }
  .bh-mark {
    color: var(--color-accent);
    font-style: normal;
    font-weight: 400;
    opacity: 0.85;
    margin-right: 0.22em;
  }
  .block-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .ledger-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
  }
  .ctl-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ctl-label {
    color: var(--color-muted);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-right: 2px;
  }
  .ctl-btn {
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    padding: 2px 8px;
    cursor: pointer;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .ctl-btn:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
  }
  .ctl-btn.active {
    color: var(--color-bg);
    background: var(--color-text);
    border-color: var(--color-text);
    font-weight: 600;
  }

  /* ─── 4-Cell Adaptive Stat Strip ─── */
  .stats {
    list-style: none;
    margin: 0 0 1.4rem;
    padding: 0.95rem 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 1.4rem;
    font-family: ui-monospace, monospace;
  }
  @media (min-width: 680px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 0.6rem;
