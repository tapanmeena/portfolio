  }
  .stat[data-accent="read"] {
    border-left-color: var(--color-read);
  }
  .stat[data-accent="both"] {
    border-image: linear-gradient(to bottom, var(--color-gym) 50%, var(--color-read) 50%) 1;
  }
  .stat-v {
    font-size: 1.52rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .stat-unit {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-muted);
    margin-left: 3px;
  }
  .stat-k {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 2px;
  }
  .stat-sub {
    font-size: 0.68rem;
    color: var(--color-muted);
    opacity: 0.88;
  }

  /* ─── Unified 52-Week Heatmap ─── */
  .heatmap-wrap {
    margin: 0;
    padding: 1rem 1.1rem 0.85rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .heatmap-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    margin-bottom: 0.72rem;
    font-family: ui-monospace, monospace;
  }
  .heatmap-kicker {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .heatmap-kicker strong {
    color: var(--color-text);
  }
  .heatmap-legend {
    display: inline-flex;
    flex-wrap: wrap;
