---
import PreviewShell from "@components/preview/PreviewShell.astro";
import { getCollection } from "astro:content";
import { getPublishedProjects } from "@utils/projects";
import { labEntries } from "@data/lab";
import { curses } from "@data/curses";

const allProjects = await getCollection("projects");
const projects = getPublishedProjects(allProjects);
const allPosts = await getCollection("blog");
const posts = allPosts.filter((p) => !p.data.draft).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const nowBuilding = projects.find((p) => p.id === "cultbot") ?? projects.find((p) => p.data.status === "in-progress") ?? projects[0];
const tracks = projects.slice(0, 10);
const sideA = tracks.slice(0, Math.ceil(tracks.length / 2));
const sideB = tracks.slice(Math.ceil(tracks.length / 2));
const bsides = posts.slice(0, 5);

const pad2 = (n: number) => String(n).padStart(2, "0");
const yr = (d: Date) => new Date(d).getFullYear();
const dur = (s: string) => `${2 + (s.length % 6)}:${pad2(s.length % 60)}`;
const totalRun = `${34 + projects.length}:${pad2(projects.length * 3)}`;
const now = new Date();
---

<PreviewShell
  title="14 · vinyl — theme mockup"
  active="vinyl"
  bg="#161210"
  fg="#efe6d5"
  fontHref="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
>
  <div class="vy">
    <div class="grain" aria-hidden="true"></div>

    <!-- ── LABEL BAR ── -->
    <header class="labelbar">
      <span class="lb-mark">TM<i>RECORDS</i></span>
      <span class="lb-cat">CAT. NO. TM-001 · 180g · STEREO</span>
      <nav class="lb-nav">
        <a href="#" class="on">A-SIDE</a><a href="#">B-SIDES</a><a href="#">STUDIO</a><a href="#">MARKET</a><a href="#">CREDITS</a>
      </nav>
    </header>

    <!-- ── SLEEVE ── -->
    <section class="sleeve">
      <div class="cover">
        <div class="disc" aria-hidden="true">
          <span class="grooves"></span>
          <span class="clabel"></span>
          <span class="spindle"></span>
        </div>
        <div class="art">
          <p class="art-k">LONG PLAY · 2019—2026</p>
          <h1 class="art-t">THE<br />WORKSHOP<br />SESSIONS</h1>
          <p class="art-by">TAPAN MEENA</p>
          <span class="art-badge">A COLLECTION OF {projects.length} BUILDS</span>
        </div>
      </div>

      <div class="sleeve-r">
        <p class="sl-k">SLEEVE NOTES</p>
        <h2 class="sl-t">Backends, tools, and one machine that trades while I sleep.</h2>
        <p class="sl-b">
          Recorded in Hyderabad between 2019 and now. Senior software engineer and project lead by day; developer tooling, self-hosted infrastructure
          and a Raspberry&nbsp;Pi that watches the Indian markets by night. Every track here shipped — sleeve notes include the takes that didn't.
        </p>
        <dl class="specs">
          <div><dt>RUNNING TIME</dt><dd>{totalRun}</dd></div>
          <div><dt>TRACKS</dt><dd>{projects.length}</dd></div>
          <div><dt>SLEEVE NOTES</dt><dd>{posts.length}</dd></div>
          <div><dt>PRESSED IN</dt><dd>HYDERABAD, IN</dd></div>
        </dl>
        <div class="sl-acts">
          <a class="vbtn" href="/projects">PLAY ALL ▶</a>
          <a class="vbtn ghost" href="/contact">BOOK THE STUDIO</a>
        </div>
      </div>
    </section>

    <!-- ── NOW SPINNING ── -->
    {
      nowBuilding && (
        <section class="spinning">
          <div class="turntable" aria-hidden="true">
            <span class="platter">
              <span class="grooves sm" />
              <span class="clabel sm" />
              <span class="spindle sm" />
            </span>
            <span class="tonearm" />
          </div>
          <div class="sp-b">
            <p class="sp-k">
              <i class="eq">
                <b />
                <b />
                <b />
                <b />
              </i>
              NOW SPINNING
            </p>
            <h2>{nowBuilding.data.title}</h2>
            <p class="sp-d">{nowBuilding.data.description}</p>
            <div class="scrub">
              <span class="scrub-t">
                <i style="width:77%" />
              </span>
              <span class="scrub-n">
                {dur(nowBuilding.data.description)} / {dur(nowBuilding.id)}
              </span>
            </div>
            <p class="sp-s">{nowBuilding.data.techStack.slice(0, 6).join(" · ")}</p>
          </div>
        </section>
      )
    }

    <!-- ── TRACKLIST ── -->
    <section class="tracklist">
      <div class="side">
        <header class="side-h">
          <span class="side-l">SIDE A</span>
          <span class="side-r">{sideA.length} TRACKS</span>
        </header>
        <ol class="tracks">
          {
            sideA.map((p, i) => (
              <li>
                <a href={`/projects/${p.id}`}>
                  <span class="tk-n">A{i + 1}</span>
                  <span class="tk-t">{p.data.title}</span>
                  <span class="tk-c">{(p.data.category ?? "misc").toLowerCase()}</span>
                  <span class="tk-y">{yr(p.data.startDate)}</span>
                  <span class="tk-d">{dur(p.data.description)}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="side">
        <header class="side-h">
          <span class="side-l">SIDE B</span>
          <span class="side-r">{sideB.length} TRACKS</span>
        </header>
        <ol class="tracks">
          {
            sideB.map((p, i) => (
              <li>
                <a href={`/projects/${p.id}`}>
                  <span class="tk-n">B{i + 1}</span>
                  <span class="tk-t">{p.data.title}</span>
                  <span class="tk-c">{(p.data.category ?? "misc").toLowerCase()}</span>
                  <span class="tk-y">{yr(p.data.startDate)}</span>
                  <span class="tk-d">{dur(p.data.description)}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ── B-SIDES ── -->
    <section class="bsides">
      <h2 class="vh">B-SIDES &amp; RARITIES <span class="vh-r">the writing</span></h2>
      <ul class="bs">
        {
          bsides.map((p, i) => (
            <li>
              <a href={`/blog/${p.id}`}>
                <span class="bs-n">{pad2(i + 1)}</span>
                <span class="bs-b">
                  <b>{p.data.title}</b>
                  <span>{p.data.description}</span>
                </span>
                <span class="bs-m">
                  {p.data.category.toUpperCase()}
                  <i>{new Date(p.data.publishedAt).getFullYear()}</i>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── STUDIO ── -->
    <section class="studio">
      <h2 class="vh">THE STUDIO <span class="vh-r">equipment &amp; racks</span></h2>
      <ul class="gear">
        {
          labEntries.map((e, i) => (
            <li>
              <span class="gr-n">{pad2(i + 1)}</span>
              <b>{e.title}</b>
              <span class="gr-d">{e.description}</span>
              <span class="gr-s">{e.stack.join(" · ")}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── MISPRESSINGS ── -->
    <section class="mispress">
      <h2 class="vh">MISPRESSINGS <span class="vh-r">things that ruined a take</span></h2>
      <ul class="mp">
        {
          curses.slice(0, 4).map((c) => (
            <li>
              <span class="mp-s">TAKE {c.severity}</span>
              <p>{c.title}</p>
              <span class="mp-m">
                {c.project} · {c.date}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── CREDITS ── -->
    <footer class="credits">
      <h2 class="cr-t">CREDITS</h2>
      <div class="cr-grid">
        <div><span>WRITTEN &amp; PERFORMED BY</span><b>Tapan Meena</b></div>
        <div><span>PRODUCED AT</span><b>MAQ Software, Hyderabad</b></div>
        <div><span>MASTERED ON</span><b>.NET · TypeScript · Azure · SQL</b></div>
        <div><span>ADDITIONAL ENGINEERING</span><b>Assorted artificial friends</b></div>
        <div><span>PRESSED</span><b>{now.getFullYear()} · 180g · No trackers</b></div>
        <div><span>BOOKINGS</span><b><a href="mailto:tapanmeena1998@gmail.com">tapanmeena1998@gmail.com</a></b></div>
      </div>
      <nav class="cr-n">
        <a href="#">GITHUB</a><span>·</span><a href="#">LINKEDIN</a><span>·</span><a href="#">TWITTER</a><span>·</span><a href="/rss.xml">RSS</a>
      </nav>
      <p class="cr-f">℗ &amp; © {now.getFullYear()} TM RECORDS · ALL TRACKS SELF-RELEASED · UNAUTHORISED DUPLICATION IS ENCOURAGED</p>
    </footer>
  </div>
</PreviewShell>

<style>
  .vy {
    --bg: #161210;
    --pan: #1e1815;
    --cream: #efe6d5;
    --rust: #d9622b;
    --gold: #c9a227;
    --mut: #9a8b78;
    --line: #322822;
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--cream);
    font-family: "Inter", system-ui, sans-serif;
    overflow-x: hidden;
  }
  .vy :global(a) {
    text-decoration: none;
  }
  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='150'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3'/></filter><rect width='150' height='150' filter='url(%23g)' opacity='0.5'/></svg>");
    mix-blend-mode: overlay;
  }
  .vy > * {
    position: relative;
    z-index: 2;
  }

  /* ── label bar ── */
  .labelbar {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    padding: 12px 22px;
    border-bottom: 1px solid var(--line);
    background: #12100e;
  }
  .lb-mark {
    font-family: "Bebas Neue", sans-serif;
    font-size: 22px;
    letter-spacing: 0.08em;
    color: var(--gold);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .lb-mark i {
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--mut);
  }
  .lb-cat {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: var(--mut);
  }
  .lb-nav {
    margin-left: auto;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .lb-nav a {
    font-family: "Bebas Neue", sans-serif;
    font-size: 15px;
    letter-spacing: 0.14em;
    padding: 2px 12px;
    color: var(--mut);
    border: 1px solid transparent;
  }
  .lb-nav a:hover {
    color: var(--cream);
    border-color: var(--line);
  }
  .lb-nav a.on {
    color: #12100e;
    background: var(--gold);
  }

  /* ── sleeve ── */
  .sleeve {
    max-width: 1180px;
    margin: 0 auto;
    padding: 44px 22px 40px;
    display: grid;
    gap: 40px;
  }
  @media (min-width: 940px) {
    .sleeve {
      grid-template-columns: 460px 1fr;
      gap: 56px;
      align-items: center;
    }
  }
  .cover {
    position: relative;
    aspect-ratio: 1;
    max-width: 460px;
  }
  .art {
    position: relative;
    z-index: 2;
    height: 100%;
    background: linear-gradient(150deg, #241c17 0%, #14100e 60%, #2a1a12 100%);
    border: 1px solid var(--line);
    padding: 32px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow:
      inset 0 0 60px rgba(0, 0, 0, 0.6),
      0 24px 50px -20px rgba(0, 0, 0, 0.8);
  }
  .art::after {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(201, 162, 39, 0.25);
    pointer-events: none;
  }
  .art-k {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--gold);
  }
  .art-t {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    line-height: 0.86;
    letter-spacing: 0.01em;
    margin: 16px 0 14px;
    color: var(--cream);
  }
  .art-by {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.2rem, 3.4vw, 1.9rem);
    letter-spacing: 0.28em;
    color: var(--rust);
  }
  .art-badge {
    display: inline-block;
    margin-top: 20px;
    font-size: 9.5px;
    letter-spacing: 0.22em;
    color: var(--mut);
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }
  .disc {
    position: absolute;
    top: 50%;
    right: -26%;
    transform: translateY(-50%);
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #0b0908;
    z-index: 1;
    animation: spin 6s linear infinite;
    box-shadow: 0 18px 40px -18px #000;
  }
  .grooves {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #171310 0 1px, #0c0a09 1px 4px);
  }
  .clabel {
    position: absolute;
    inset: 35%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--rust), #8f3a13);
  }
  .spindle {
    position: absolute;
    inset: 48.4%;
    border-radius: 50%;
    background: #161210;
  }
  @keyframes spin {
    to {
      transform: translateY(-50%) rotate(360deg);
    }
  }

  .sleeve-r {
    position: relative;
    z-index: 4;
  }
  .sl-k {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--gold);
  }
  .sl-t {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    line-height: 1.02;
    letter-spacing: 0.01em;
    margin: 14px 0 16px;
  }
  .sl-b {
    font-size: 1rem;
    line-height: 1.75;
    color: #cbbda8;
    max-width: 58ch;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin: 26px 0 24px;
  }
  @media (min-width: 700px) {
    .specs {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .specs > div {
    border-top: 1px solid var(--line);
    padding: 11px 12px 11px 0;
  }
  .specs dt {
    font-size: 9.5px;
    letter-spacing: 0.2em;
    color: var(--mut);
  }
  .specs dd {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    margin-top: 5px;
    color: var(--cream);
  }
  .sl-acts {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .vbtn {
    font-family: "Bebas Neue", sans-serif;
    font-size: 16px;
    letter-spacing: 0.14em;
    padding: 9px 22px;
    background: var(--rust);
    color: #14100e;
  }
  .vbtn:hover {
    background: var(--gold);
  }
  .vbtn.ghost {
    background: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .vbtn.ghost:hover {
    background: transparent;
    color: var(--gold);
    box-shadow: inset 0 0 0 1px var(--gold);
  }

  /* ── now spinning ── */
  .spinning {
    max-width: 1180px;
    margin: 0 auto;
    padding: 34px 22px 38px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 30px;
    align-items: center;
  }
  @media (min-width: 840px) {
    .spinning {
      grid-template-columns: 210px 1fr;
      gap: 44px;
    }
  }
  .turntable {
    position: relative;
    width: 190px;
    aspect-ratio: 1;
  }
  .platter {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #0b0908;
    animation: spin2 4s linear infinite;
    box-shadow: 0 14px 30px -14px #000;
  }
  @keyframes spin2 {
    to {
      transform: rotate(360deg);
    }
  }
  .grooves.sm,
  .clabel.sm,
  .spindle.sm {
    position: absolute;
  }
  .tonearm {
    position: absolute;
    top: 8%;
    right: 2%;
    width: 4px;
    height: 62%;
    background: linear-gradient(#c9c2b6, #6d675d);
    transform-origin: top center;
    transform: rotate(24deg);
    border-radius: 3px;
  }
  .tonearm::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: -4px;
    width: 12px;
    height: 12px;
    background: var(--gold);
    border-radius: 2px;
  }
  .sp-k {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: var(--gold);
  }
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 13px;
  }
  .eq b {
    width: 3px;
    background: var(--rust);
    display: block;
    animation: eq 0.9s ease-in-out infinite alternate;
  }
  .eq b:nth-child(2) {
    animation-delay: 0.15s;
  }
  .eq b:nth-child(3) {
    animation-delay: 0.3s;
  }
  .eq b:nth-child(4) {
    animation-delay: 0.45s;
  }
  @keyframes eq {
    from {
      height: 20%;
    }
    to {
      height: 100%;
    }
  }
  .spinning h2 {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(2rem, 5.4vw, 3.4rem);
    letter-spacing: 0.02em;
    margin: 10px 0 10px;
  }
  .sp-d {
    font-size: 0.98rem;
    line-height: 1.7;
    color: #cbbda8;
    max-width: 62ch;
  }
  .scrub {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 20px 0 12px;
  }
  .scrub-t {
    flex: 1;
    height: 3px;
    background: var(--line);
    position: relative;
  }
  .scrub-t i {
    display: block;
    height: 100%;
    background: var(--rust);
  }
  .scrub-t i::after {
    content: "";
    position: absolute;
    top: -4px;
    left: 77%;
    width: 11px;
    height: 11px;
    background: var(--gold);
    border-radius: 50%;
  }
  .scrub-n {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--mut);
    font-variant-numeric: tabular-nums;
  }
  .sp-s {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mut);
  }

  /* ── tracklist ── */
  .tracklist {
    max-width: 1180px;
    margin: 0 auto;
    padding: 44px 22px 20px;
    display: grid;
    gap: 34px;
  }
  @media (min-width: 900px) {
    .tracklist {
      grid-template-columns: repeat(2, 1fr);
      gap: 46px;
    }
  }
  .side-h {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--gold);
  }
  .side-l {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.8rem;
    letter-spacing: 0.16em;
    color: var(--gold);
  }
  .side-r {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--mut);
  }
  .tracks li {
    border-bottom: 1px solid var(--line);
  }
  .tracks a {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    gap: 3px 12px;
    padding: 11px 4px;
    align-items: baseline;
  }
  .tracks a:hover {
    background: rgba(217, 98, 43, 0.08);
  }
  .tk-n {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--rust);
  }
  .tk-t {
    font-size: 1.02rem;
    font-weight: 500;
  }
  .tracks a:hover .tk-t {
    color: var(--gold);
  }
  .tk-d {
    font-size: 11.5px;
    color: var(--mut);
    font-variant-numeric: tabular-nums;
  }
  .tk-c,
  .tk-y {
    grid-column: 2;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mut);
  }
  .tk-y {
    grid-column: 3;
    grid-row: 2;
    text-align: right;
  }

  /* ── shared head ── */
  .vh {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.7rem, 4.4vw, 2.6rem);
    letter-spacing: 0.1em;
    padding-bottom: 10px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .vh-r {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mut);
  }

  /* ── b-sides ── */
  .bsides,
  .studio,
  .mispress {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 22px 10px;
  }
  .bs li {
    border-bottom: 1px solid var(--line);
  }
  .bs a {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 6px 16px;
    padding: 16px 4px;
