---
import PreviewShell from "@components/preview/PreviewShell.astro";

type Mock = {
  key: string;
  num: string;
  round: 1 | 2 | 3 | 4;
  name: string;
  tagline: string;
  pitch: string;
  vibe: string[];
  palette: string[];
  bg: string;
  fg: string;
  ui: string;
  fontClass: string;
  sample: string;
  good: string;
  cost: string;
};

const mocks: Mock[] = [
  {
    key: "terminal",
    num: "01",
    round: 1,
    name: "Terminal",
    tagline: "the whole site is a shell session",
    pitch:
      "Every section is a command and its output. Projects render as `ls -lh`, posts as a tailed log, the homelab as `systemctl status`. CRT scanlines, phosphor green, blinking cursor.",
    vibe: ["engineer-coded", "dark only", "high personality"],
    palette: ["#080b0a", "#4ade80", "#22d3ee", "#fbbf24", "#f472b6"],
    bg: "#080b0a",
    fg: "#4ade80",
    ui: "#4ade80",
    fontClass: "f-jet",
    sample: "$ ls -lh ~/projects",
    good: "Instantly memorable, screams backend engineer, trivially extends to every page.",
    cost: "Monospace everywhere hurts long-form reading; needs a softer 'article mode'.",
  },
  {
    key: "brutalist",
    num: "02",
    round: 1,
    name: "Brutalist Press",
    tagline: "loud type, hard rules, one angry red",
    pitch:
      "Archivo Black at 11rem, hairline grids, a scrolling red ticker, hover states that invert whole rows. Confident and physical — closer to a printed poster than a website.",
    vibe: ["bold", "light mode", "high contrast"],
    palette: ["#f2efe6", "#0d0d0d", "#ff2d16", "#8c887c", "#ffffff"],
    bg: "#f2efe6",
    fg: "#0d0d0d",
    ui: "#ff2d16",
    fontClass: "f-archivo-black",
    sample: "BUILDS BACKENDS.",
    good: "Enormous personality, great for portfolio/hiring impact, very fast to read.",
    cost: "Loud. Needs discipline on dense pages like the trading curriculum.",
  },
  {
    key: "blueprint",
    num: "03",
    round: 1,
    name: "Blueprint",
    tagline: "the site as an engineering drawing",
    pitch:
      "Navy sheet with a real drafting grid, dimension lines, callout balloons, a schedule-of-works table, and a proper title block in the footer. Content is 'issued', not 'posted'.",
    vibe: ["technical", "dark", "systematic"],
    palette: ["#08131f", "#5fc8f0", "#ffb454", "#6f93ab", "#d6ecfa"],
    bg: "#08131f",
    fg: "#5fc8f0",
    ui: "#5fc8f0",
    fontClass: "f-plex",
    sample: "FIG. 03 — SCHEDULE",
    good: "Tables, specs, and the trading curriculum fit this frame perfectly.",
    cost: "Strong metaphor — every new section has to earn a place on the drawing.",
  },
  {
    key: "aurora",
    num: "04",
    round: 1,
    name: "Aurora Bento",
    tagline: "glass cards over a drifting gradient sky",
    pitch:
      "Modern product-site energy: floating pill nav, gradient display type, and an asymmetric bento grid where each card is a live surface — now-building, stats, stack marquee, homelab LEDs.",
    vibe: ["polished", "dark", "recruiter-friendly"],
    palette: ["#06060a", "#a78bfa", "#22d3ee", "#f472b6", "#e9e9ef"],
    bg: "#06060a",
    fg: "#a78bfa",
    ui: "#a78bfa",
    fontClass: "f-inter-tight",
    sample: "the quiet systems",
    good: "The safest 'wow' — reads as senior and current, scales to any page.",
    cost: "Least unique of the ten; lots of sites look adjacent to this in 2026.",
  },
  {
    key: "atelier",
    num: "05",
    round: 1,
    name: "Atelier",
    tagline: "a gallery catalogue for software",
    pitch:
      "Warm paper, Playfair Display, huge whitespace. Projects become numbered plates with museum labels (medium, commenced, state). Posts are 'notebooks'. Quiet, expensive-feeling.",
    vibe: ["editorial", "light mode", "calm"],
    palette: ["#f7f3ea", "#1a1714", "#b0522a", "#6a6157", "#f1ece0"],
    bg: "#f7f3ea",
    fg: "#b0522a",
    ui: "#e08a5a",
    fontClass: "f-playfair",
    sample: "Software, made carefully",
    good: "Best long-form reading of the set; ages extremely well.",
    cost: "Understated — less immediate impact than 02 or 04.",
  },
  {
    key: "desk",
    num: "06",
    round: 2,
    name: "Trading Desk",
    tagline: "a Bloomberg terminal for your career",
    pitch:
      "Black panels, amber command line, `<GO>` function keys and a scrolling tape. Projects become a watchlist with tickers, % change and sparklines; posts are the news wire; the homelab is a load monitor; cursed knowledge is the alert queue.",
    vibe: ["dense", "dark", "finance-coded"],
    palette: ["#050505", "#ff9d00", "#26c6f5", "#00e07a", "#ff4d4d"],
    bg: "#050505",
    fg: "#ff9d00",
    ui: "#ff9d00",
    fontClass: "f-roboto-mono",
    sample: "TPMN <EQUITY> DES",
    good: "Ties the trading curriculum and StalkMarket straight into the identity. Huge information density.",
    cost: "Intense. Needs a calmer reading view for the long-form curriculum pages.",
  },
  {
    key: "zine",
    num: "07",
    round: 2,
    name: "Riso Zine",
    tagline: "photocopied, misregistered, stapled",
    pitch:
      "Two-colour risograph print: halftone dots, off-register pink/blue shadows, taped-down cut-outs at slight angles, marker scrawl, rubber stamps and a hand-set colophon. Projects are literal paper cut-outs.",
    vibe: ["playful", "light mode", "very unusual"],
    palette: ["#f2ecdd", "#141414", "#2b4bd8", "#ff3d8b", "#ffd400"],
    bg: "#f2ecdd",
    fg: "#ff3d8b",
    ui: "#ff3d8b",
    fontClass: "f-anton",
    sample: "THE WORKSHOP ZINE",
    good: "Nothing else on the internet looks like this. Memorable and genuinely fun.",
    cost: "Hardest to keep readable at scale; risky for a hiring audience.",
  },
  {
    key: "desktop",
    num: "08",
    round: 2,
    name: "Desktop OS",
    tagline: "your portfolio, as an operating system",
    pitch:
      "Menu bar with a live clock, desktop icons, a magnifying dock, and real app windows: README.rtf, a Finder list of projects with Kind/Date/Size columns, a Console tailing writing.log, Activity Monitor for the homelab, and a sticky note for cursed knowledge.",
    vibe: ["interactive", "colourful", "playful-pro"],
    palette: ["#1a2364", "#57265c", "#0a6cff", "#ffffff", "#ffec6b"],
    bg: "#1e2a63",
    fg: "#ffffff",
    ui: "#5aa9ff",
    fontClass: "f-inter",
