---
import PreviewShell from "@components/preview/PreviewShell.astro";
import { getCollection } from "astro:content";
import { getPublishedProjects } from "@utils/projects";
import { labEntries } from "@data/lab";
import { curses } from "@data/curses";
import { ArrowUpRight, Github, Linkedin, Twitter, Mail, Rss } from "@lucide/astro";

const allProjects = await getCollection("projects");
const projects = getPublishedProjects(allProjects);
const allPosts = await getCollection("blog");
const posts = allPosts.filter((p) => !p.data.draft).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const nowBuilding = projects.find((p) => p.id === "cultbot") ?? projects.find((p) => p.data.status === "in-progress") ?? projects[0];
const featured = projects.filter((p) => p.id !== nowBuilding?.id).slice(0, 2);
const writing = posts.slice(0, 5);

const stack = ["TypeScript", ".NET", "Azure", "Node.js", "React", "PostgreSQL", "Docker", "Python", "SQL Server", "Redis"];
const shortDate = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric" });

const catHue: Record<string, string> = {
  Fintech: "152 70% 55%",
  "Web Apps": "217 85% 65%",
  "Mobile Apps": "265 80% 70%",
  "Desktop Apps": "190 85% 60%",
  "CLI Tools": "38 92% 60%",
  Libraries: "330 80% 68%",
  Games: "0 84% 66%",
  "ML/AI": "280 80% 70%",
  "IoT/Security": "172 75% 55%",
};
const hue = (c?: string) => (c && catHue[c]) || "240 70% 68%";
---

<PreviewShell
  title="04 · aurora — theme mockup"
  active="aurora"
  bg="#06060a"
  fg="#e9e9ef"
  fontHref="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
>
  <div class="au">
    <div class="sky" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
      <span class="noise"></span>
    </div>

    <!-- ── NAV ── -->
    <header class="navwrap">
      <nav class="nav glass">
        <a class="brand" href="/"><span class="brand-dot"></span>tapan</a>
        <span class="nav-links">
          <a href="#">work</a>
          <a href="#">writing</a>
          <a href="#">trading</a>
          <a href="#">lab</a>
          <a href="#">about</a>
        </span>
        <a class="nav-cta" href="/contact">let's talk</a>
      </nav>
    </header>

    <main class="wrap">
      <!-- ── HERO ── -->
      <section class="hero">
        <span class="badge glass">
          <span class="dot"></span>
          available for interesting work
        </span>
        <h1 class="h1">
          I build the <em>quiet</em> systems<br /> that keep loud products <em>running.</em>
        </h1>
        <p class="sub">
          Senior software engineer in Hyderabad. Scalable backends, developer tooling, and a Raspberry&nbsp;Pi that trades the NSE while I sleep.
        </p>
        <div class="acts">
          <a class="btn primary" href="/projects">Explore the work <ArrowUpRight size={16} /></a>
          <a class="btn ghost glass" href="/blog">Read the writing</a>
        </div>
      </section>

      <!-- ── BENTO ── -->
      <section class="bento">
        <!-- now building -->
        {
          nowBuilding && (
            <a class="cell glass c-now" href={`/projects/${nowBuilding.id}`} style={`--h:${hue(nowBuilding.data.category)}`}>
              <span class="halo" aria-hidden="true" />
              <span class="cell-k">
                <span class="live" />
                now building
              </span>
              <h2 class="now-t">{nowBuilding.data.title}</h2>
              <p class="now-d">{nowBuilding.data.description}</p>
              <div class="prog">
                <span class="prog-bar">
                  <i style="width:77%" />
                </span>
                <span class="prog-n">77%</span>
              </div>
              <ul class="tags">
                {nowBuilding.data.techStack.slice(0, 5).map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <span class="go">
                <ArrowUpRight size={17} />
              </span>
            </a>
          )
        }

        <!-- stats -->
        <div class="cell glass c-stats">
          <span class="cell-k">by the numbers</span>
          <ul class="stats">
            <li><b>{projects.length}</b><span>projects</span></li>
            <li><b>{posts.length}</b><span>writeups</span></li>
            <li><b>6+</b><span>years</span></li>
            <li><b>{labEntries.length}</b><span>services</span></li>
          </ul>
          <p class="stats-note">Everything here is real, shipped, and mostly still running.</p>
        </div>

        <!-- stack marquee -->
        <div class="cell glass c-stack">
          <span class="cell-k">daily drivers</span>
          <div class="mq">
            <div class="mq-t">
              {
                [0, 1].map(() => (
                  <span class="mq-set">
                    {stack.map((s) => (
                      <span class="pill">{s}</span>
                    ))}
                  </span>
                ))
              }
            </div>
          </div>
          <div class="mq rev">
            <div class="mq-t">
              {
                [0, 1].map(() => (
                  <span class="mq-set">
                    {[...stack].reverse().map((s) => (
                      <span class="pill">{s}</span>
                    ))}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <!-- featured projects -->
        {
          featured.map((p) => (
            <a class="cell glass c-proj" href={`/projects/${p.id}`} style={`--h:${hue(p.data.category)}`}>
              <span class="halo" aria-hidden="true" />
              <span class="cell-k">{(p.data.category ?? "project").toLowerCase()}</span>
              <h3 class="pj-t">{p.data.title}</h3>
              <p class="pj-d">{p.data.description}</p>
              <span class="pj-f">
                <span class="pj-stack">{p.data.techStack.slice(0, 3).join(" · ")}</span>
                <ArrowUpRight size={15} />
              </span>
            </a>
          ))
        }

        <!-- writing -->
        <div class="cell glass c-write">
          <span class="cell-k">from the log</span>
          <ul class="wlist">
            {
              writing.map((p) => (
                <li>
                  <a href={`/blog/${p.id}`}>
                    <span class="w-t">{p.data.title}</span>
                    <span class="w-m">
                      {p.data.category.toLowerCase()} <i>·</i> {shortDate(new Date(p.data.publishedAt))}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="cell-more" href="/blog">All writing <ArrowUpRight size={13} /></a>
        </div>

        <!-- machine room -->
        <div class="cell glass c-lab">
          <span class="cell-k">the machine room</span>
          <ul class="labs">
            {
              labEntries.map((e) => (
                <li>
                  <span class="lb-led" style={`--c:${e.accent}`} />
                  <span class="lb-t">{e.title}</span>
                  <span class="lb-s">{e.access.replace("-", " ")}</span>
                </li>
              ))
            }
          </ul>
          <p class="lab-note">self-hosted on a shelf · uptime is a hobby</p>
        </div>

        <!-- cursed -->
        <div class="cell glass c-curse">
          <span class="cell-k">cursed knowledge</span>
          <p class="curse-q">“{curses[0].title}”</p>
          <span class="curse-m">— {curses[0].project.toLowerCase()} · severity {curses[0].severity}</span>
          <a class="cell-more" href="/cursed-knowledge">{curses.length} things that cost me a weekend <ArrowUpRight size={13} /></a>
        </div>

        <!-- contact -->
        <div class="cell glass c-cta">
          <span class="halo cta-halo" aria-hidden="true"></span>
          <div class="cta-l">
            <h3 class="cta-t">Building something<br /><em>difficult?</em></h3>
            <p class="cta-d">Backend architecture, broker/API integrations, developer tooling. I reply within a day.</p>
          </div>
          <div class="cta-r">
            <a class="btn primary" href="mailto:tapanmeena1998@gmail.com"><Mail size={15} /> tapanmeena1998@gmail.com</a>
            <div class="socials">
              <a href="#" aria-label="GitHub"><Github size={15} /></a>
              <a href="#" aria-label="LinkedIn"><Linkedin size={15} /></a>
              <a href="#" aria-label="Twitter"><Twitter size={15} /></a>
              <a href="/rss.xml" aria-label="RSS"><Rss size={15} /></a>
            </div>
            <p class="cta-note">Hyderabad · IST (UTC+5:30) — usually replies within 24h on weekdays.</p>
          </div>
        </div>
      </section>

      <footer class="foot">
        <span>© 2026 Tapan Meena</span>
        <span>Hyderabad · IST</span>
        <span>Built with Astro</span>
      </footer>
    </main>
  </div>
</PreviewShell>

<style>
  .au {
    --bg: #06060a;
    --fg: #ececf3;
    --mut: #8e8ea3;
    --line: rgba(255, 255, 255, 0.09);
    --glass: rgba(255, 255, 255, 0.035);
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: "Inter Tight", system-ui, sans-serif;
    overflow-x: hidden;
  }
  .au :global(a) {
    text-decoration: none;
  }
  em {
    font-family: "Instrument Serif", Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }

  /* ── sky ── */
  .sky {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
  }
  .b1 {
    width: 46vw;
    height: 46vw;
    min-width: 340px;
    min-height: 340px;
    top: -14vw;
    left: -6vw;
    background: radial-gradient(circle, #6d3bff, transparent 68%);
    animation: drift1 22s ease-in-out infinite alternate;
  }
  .b2 {
    width: 40vw;
    height: 40vw;
    min-width: 300px;
    min-height: 300px;
    top: 4vw;
    right: -8vw;
    background: radial-gradient(circle, #12b5c9, transparent 68%);
    animation: drift2 26s ease-in-out infinite alternate;
  }
  .b3 {
    width: 38vw;
    height: 38vw;
    min-width: 280px;
    min-height: 280px;
    top: 46vh;
    left: 32vw;
    background: radial-gradient(circle, #ff3d78, transparent 70%);
    opacity: 0.32;
    animation: drift3 30s ease-in-out infinite alternate;
  }
  @keyframes drift1 {
    to {
      transform: translate3d(9vw, 7vh, 0) scale(1.14);
    }
  }
  @keyframes drift2 {
    to {
      transform: translate3d(-8vw, 10vh, 0) scale(1.1);
    }
  }
  @keyframes drift3 {
    to {
      transform: translate3d(-12vw, -8vh, 0) scale(0.88);
    }
  }
  .noise {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.5'/></svg>");
    mix-blend-mode: overlay;
  }

  .glass {
    background: var(--glass);
    border: 1px solid var(--line);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  /* ── nav ── */
  .navwrap {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 16px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 7px 7px 16px;
    border-radius: 999px;
    max-width: 100%;
  }
  .brand {
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-right: 6px;
  }
  .brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8b5cf6, #22d3ee);
    box-shadow: 0 0 12px #8b5cf6;
  }
  .nav-links {
    display: none;
    gap: 2px;
  }
  @media (min-width: 720px) {
    .nav-links {
      display: flex;
    }
  }
  .nav-links a {
    padding: 6px 13px;
    font-size: 13.5px;
    color: var(--mut);
    border-radius: 999px;
    transition: 0.16s ease;
  }
  .nav-links a:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-cta {
    padding: 7px 15px;
    font-size: 13.5px;
    font-weight: 500;
    border-radius: 999px;
    background: #f2f2f7;
    color: #08080c;
    transition: 0.16s ease;
  }
  .nav-cta:hover {
    box-shadow: 0 0 24px -4px rgba(255, 255, 255, 0.5);
  }

  .wrap {
    position: relative;
    z-index: 2;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 18px;
  }

  /* ── hero ── */
  .hero {
    text-align: center;
    padding: 52px 0 56px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 11px;
    border-radius: 999px;
    font-size: 12.5px;
    color: #c9c9d8;
    letter-spacing: 0.01em;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 7px rgba(52, 211, 153, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0);
    }
  }
  .h1 {
    margin: 24px auto 18px;
    font-size: clamp(2.3rem, 6.4vw, 4.7rem);
    line-height: 1.03;
    letter-spacing: -0.038em;
    font-weight: 600;
    max-width: 16ch;
    background: linear-gradient(180deg, #ffffff 20%, #a5a5c4 115%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .h1 em {
    background: linear-gradient(100deg, #a78bfa, #22d3ee 55%, #f472b6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    max-width: 58ch;
    margin: 0 auto;
    font-size: clamp(0.98rem, 1.5vw, 1.12rem);
    line-height: 1.62;
    color: var(--mut);
  }
  .acts {
    display: flex;
    justify-content: center;
    gap: 11px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    transition: 0.18s ease;
  }
  .btn.primary {
    background: linear-gradient(135deg, #f5f5fa, #d7d7e6);
    color: #08080c;
    box-shadow: 0 8px 30px -10px rgba(255, 255, 255, 0.5);
  }
  .btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px -10px rgba(255, 255, 255, 0.55);
  }
  .btn.ghost {
    color: var(--fg);
  }
  .btn.ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  /* ── bento ── */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    padding-bottom: 40px;
  }
  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(12, 1fr);
    }
  }
  .cell {
    position: relative;
    border-radius: 20px;
    padding: 20px 21px 21px;
    overflow: hidden;
    grid-column: span 2;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  a.cell:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .halo {
    position: absolute;
    top: -60%;
    right: -30%;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, hsl(var(--h, 240 70% 68%) / 0.4), transparent 66%);
    filter: blur(46px);
    opacity: 0.5;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  a.cell:hover .halo {
    opacity: 0.95;
  }
  .cell-k {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mut);
    font-weight: 500;
  }
  .cell-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--mut);
    transition: color 0.16s ease;
  }
  .cell-more:hover {
    color: var(--fg);
  }

  @media (min-width: 900px) {
    .c-now {
      grid-column: span 7;
      grid-row: span 2;
    }
    .c-stats {
      grid-column: span 5;
    }
    .c-stack {
      grid-column: span 5;
    }
    .c-proj {
      grid-column: span 4;
    }
    .c-write {
      grid-column: span 4;
      grid-row: span 2;
    }
    .c-lab {
      grid-column: span 4;
    }
    .c-curse {
      grid-column: span 4;
    }
    .c-cta {
      grid-column: span 12;
    }
  }

  /* now */
  .c-now {
    display: block;
    min-height: 250px;
  }
  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 10px #34d399;
    animation: ping 2s ease-out infinite;
  }
  .now-t {
    font-size: clamp(1.7rem, 3.6vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 14px 0 10px;
  }
  .now-d {
    color: #b6b6c9;
    line-height: 1.6;
    max-width: 52ch;
    font-size: 0.95rem;
  }
  .prog {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 20px 0 16px;
  }
  .prog-bar {
    flex: 1;
    height: 4px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.09);
    overflow: hidden;
  }
  .prog-bar i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, #a78bfa, #22d3ee);
  }
  .prog-n {
    font-size: 12px;
    color: var(--mut);
    font-variant-numeric: tabular-nums;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-size: 11.5px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: #b6b6c9;
  }
  .go {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    color: var(--mut);
    transition: 0.18s ease;
  }
  a.cell:hover .go {
    color: #08080c;
    background: #f2f2f7;
    border-color: transparent;
  }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 16px 0 14px;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .stats b {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    background: linear-gradient(180deg, #fff, #9c9cbd);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats span {
    font-size: 11.5px;
    color: var(--mut);
  }
  .stats-note {
    font-size: 12.5px;
    color: var(--mut);
    line-height: 1.5;
  }

  /* stack marquee */
  .c-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mq {
    overflow: hidden;
    margin: 0 -21px;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .mq-t {
    display: flex;
    width: max-content;
    animation: run 26s linear infinite;
  }
  .mq.rev .mq-t {
    animation-direction: reverse;
  }
  .mq-set {
    display: flex;
    gap: 7px;
    padding-right: 7px;
  }
  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }
  .pill {
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: #c5c5d6;
    white-space: nowrap;
  }

  /* projects */
  .c-proj {
    display: flex;
    flex-direction: column;
    min-height: 178px;
  }
  .pj-t {
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 11px 0 7px;
  }
  .pj-d {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--mut);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pj-f {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 16px;
    font-size: 11.5px;
    color: var(--mut);
  }
  a.cell:hover .pj-f {
    color: var(--fg);
  }

  /* writing */
  .c-write {
    display: flex;
