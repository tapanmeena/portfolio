---
import BaseLayout from "@layouts/BaseLayout.astro";

type Severity = 1 | 2 | 3;

interface Curse {
  date: string; // YYYY-MM
  project: string;
  projectSlug?: string;
  tags: string[];
  severity: Severity;
  title: string;
  body: string;
}

// Newest → oldest. Severity: 1 = mildly cursed, 2 = deeply cursed, 3 = eldritch.
const curses: Curse[] = [
  // ── 2026-07 — GitHub Actions ──
  {
    date: "2026-07",
    project: "GitHub Actions",
    tags: ["CI/CD", "Scheduling"],
    severity: 2,
    title: "GitHub Actions cron is a suggestion, not an appointment",
    body: "A scheduled workflow is not guaranteed to run at the specified time. Jobs can be delayed—or even dropped—during periods of high load, especially at the start of the hour. Pick an odd minute, make the job idempotent, and use an external scheduler when timing is a requirement rather than a preference.",
  },

  // ── 2026-04 — StalkMarket ──
  {
    date: "2026-04",
    project: "StalkMarket",
    projectSlug: "stalkmarket",
    tags: ["Auth", "Brokers"],
    severity: 3,
    title: "Indian broker auth is four different religions in a trenchcoat",
    body: "Angel One = TOTP. Upstox + Zerodha = OAuth. Groww = API keys. There is no unified standard, and there will not be one. Hide the chaos behind a provider interface and refresh tokens proactively — never wait for the 401.",
  },

  // ── 2025-10 — Finalyze ──
  {
    date: "2025-10",
    project: "Finalyze",
    projectSlug: "finalyze",
    tags: ["SQLite", "Performance"],
    severity: 3,
    title: "Batch inserts without a transaction = one fsync per row",
    body: "A 200-row import takes 8 seconds. Wrap it in `BEGIN`/`COMMIT` and the same import takes 40ms. The cost of forgetting is 200×.",
  },

  // ── 2025-08 — ScreenSage ──
  {
    date: "2025-08",
    project: "ScreenSage",
    projectSlug: "screensage-macos",
    tags: ["macOS", "OCR"],
    severity: 1,
    title: "Apple Vision OCR has zero reason to lose to Tesseract on macOS",
    body: "Free, local, fast, shockingly accurate, no model download. There is no scenario in 2025 where shipping Tesseract on macOS is the right call.",
  },
];

const projectList = Array.from(new Set(curses.map((c) => c.project))).sort();
const totalCurses = curses.length;
const eldritchCount = curses.filter((c) => c.severity === 3).length;
const projectCount = projectList.length;
const earliest = curses[curses.length - 1].date.slice(0, 4);
const latest = curses[0].date.slice(0, 4);

const pad = (n: number) => String(n).padStart(2, "0");

const severityWord: Record<Severity, string> = {
  1: "mildly cursed",
  2: "deeply cursed",
  3: "eldritch",
};
const severityGlyph: Record<Severity, string> = {
  1: "†",
  2: "‡",
  3: "✝",
};
const severityColor: Record<Severity, string> = {
  1: "#f59e0b",
  2: "#ef4444",
  3: "#a855f7",
};

function formatDate(date: string) {
  const [y, m] = date.split("-");
  const months = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
  return `${months[parseInt(m, 10) - 1]}\u00a0${y}`;
}
function monthShort(date: string) {
  const m = date.split("-")[1];
  return ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"][parseInt(m, 10) - 1].toUpperCase();
}

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();
---

<BaseLayout pageTitle="Cursed Knowledge — Tapan Meena">
  <div class="page">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;X&nbsp;//&nbsp;the&nbsp;grimoire</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
      <span class="dl-spacer"></span>
      <span class="dl-warn">⚠ contents may scar</span>
    </p>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">a chronological grimoire of</span>
        <span class="mast-main"><em>cursed&nbsp;knowledge</em></span>
      </h1>
      <p class="mast-by">
        <span>things i learned at <strong>02:47</strong> while something was on fire</span>
        <span class="dl-sep">·</span>
        <span>one scar per entry</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <!-- ── STATS STRIP ── -->
    <ul class="stats" aria-label="Grimoire stats">
      <li class="stat">
        <span class="stat-v">{pad(totalCurses)}</span>
        <span class="stat-k">total curses</span>
      </li>
      <li class="stat">
        <span class="stat-v"><span class="sev-mark sev-3">{severityGlyph[3]}</span>{pad(eldritchCount)}</span>
        <span class="stat-k">eldritch tier</span>
      </li>
      <li class="stat">
        <span class="stat-v">{pad(projectCount)}</span>
        <span class="stat-k">haunted projects</span>
      </li>
      <li class="stat">
        <span class="stat-v">{earliest}<span class="dim">–</span>{latest}</span>
        <span class="stat-k">years of regret</span>
      </li>
    </ul>

    <!-- ── CONTROLS ── -->
    <section class="controls" aria-label="Filter curses">
      <div class="ctl-row">
        <span class="ctl-tag">severity</span>
        <button class="dl active" data-sev="all" type="button">all</button>
        <button class="dl" data-sev="3" type="button"><span class="sev-mark sev-3">{severityGlyph[3]}</span>eldritch</button>
        <button class="dl" data-sev="2" type="button"><span class="sev-mark sev-2">{severityGlyph[2]}</span>deeply</button>
        <button class="dl" data-sev="1" type="button"><span class="sev-mark sev-1">{severityGlyph[1]}</span>mildly</button>
        <span class="ctl-spacer"></span>
        <button id="random-curse" class="dl ghost" type="button">↯ summon random</button>
      </div>
      <div class="ctl-row ctl-line">
        <span class="ctl-tag">project</span>
        <button class="dl active" data-proj="all" type="button">all</button>
        {
          projectList.map((p) => (
            <button class="dl" data-proj={p} type="button">
              {p.toLowerCase()}
            </button>
          ))
        }
      </div>
      <p class="ctl-foot">
        <span class="dim">// psst —</span>
        type <kbd>e</kbd><kbd>x</kbd><kbd>o</kbd><kbd>r</kbd><kbd>c</kbd><kbd>i</kbd><kbd>s</kbd><kbd>e</kbd>
        to attempt a banishment.
      </p>
    </section>

    <!-- ── TIMELINE ── -->
    <ol class="entries grimoire">
      {
        curses.map((c, i) => (
          <li class="entry curse" data-sev={c.severity} data-proj={c.project} style={`--accent:${severityColor[c.severity]}`}>
            <div class="entry-link">
              <div class="e-gutter">
                <span class="e-num">№{pad(i + 1)}</span>
                <span class="e-month">
                  {monthShort(c.date)}&nbsp;{c.date.slice(0, 4)}
                </span>
                <span class="e-sev" title={severityWord[c.severity]} aria-label={severityWord[c.severity]}>
                  {Array.from({ length: c.severity }).map(() => (
                    <span class={`sev-mark sev-${c.severity}`}>{severityGlyph[c.severity]}</span>
                  ))}
                </span>
              </div>
              <div class="e-body">
                <div class="e-line">
                  <h3 class="e-title">{c.title}</h3>
                  <span class="e-status">— {severityWord[c.severity]}</span>
                </div>
                <p class="e-desc">{c.body}</p>
                <p class="e-meta">
                  {c.projectSlug ? (
                    <a class="e-proj" href={`/projects/${c.projectSlug}`}>
                      <span class="e-proj-tag">project&nbsp;//</span>
                      {c.project}
                      <span class="e-proj-arrow">→</span>
                    </a>
                  ) : (
                    <span class="e-proj e-proj-static">
                      <span class="e-proj-tag">project&nbsp;//</span>
                      {c.project}
                    </span>
                  )}
                  <span class="e-tags">
                    <span class="e-tags-tag">tags&nbsp;//</span>
                    {c.tags.map((t, ti) => (
                      <>
                        {ti > 0 && (
                          <span class="e-tag-sep" aria-hidden="true">
                            {" "}
                            ·{" "}
                          </span>
                        )}
                        <span class="e-tag">#{t.toLowerCase().replace(/\s+/g, "-")}</span>
                      </>
                    ))}
                  </span>
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div id="empty-state" class="empty hidden">
      <p>—&nbsp;no curses match those filters&nbsp;—</p>
      <button id="empty-reset" type="button" class="dl ghost">reset filters</button>
    </div>

    <!-- ── END RULE ── -->
    <footer class="grimoire-end">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <p class="end-line">
        <em>end of grimoire</em>
        <span class="dl-sep">·</span>
        <span>for now</span>
      </p>
      <p class="meta-lesson">
        the cure isn't a better memory — it's the habit of treating <q>huh, that was annoying</q>
        as a signal to open a notes file before fixing the next bug.
      </p>
    </footer>
  </div>

  <!-- ── BANISHMENT RITUAL MODAL ── -->
  <div id="ritual-modal" class="ritual-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ritual-title">
    <div class="ritual-backdrop"></div>
    <div class="ritual-stage">
      <span class="rune rune-1">†</span>
      <span class="rune rune-2">✱</span>
      <span class="rune rune-3">§</span>
      <span class="rune rune-4">❧</span>
      <span class="rune rune-5">‡</span>
      <span class="rune rune-6">¶</span>

      <svg class="ritual-circle" viewBox="0 0 200 200" aria-hidden="true">
        <circle class="ring ring-outer" cx="100" cy="100" r="94"></circle>
        <circle class="ring ring-inner" cx="100" cy="100" r="62"></circle>
        <polygon class="pentagram" points="100,18 122,82 188,82 134,122 156,186 100,146 44,186 66,122 12,82 78,82"></polygon>
        <g class="ticks">
          {
            Array.from({ length: 24 }).map((_, i) => {
              const a = (i * 360) / 24;
              return <line x1="100" y1="4" x2="100" y2="12" transform={`rotate(${a} 100 100)`} />;
            })
          }
        </g>
      </svg>

      <article class="ritual-card">
        <p class="ritual-issue">
          <span class="ri-tag">grimoire</span>
          <span class="dl-sep">·</span>
          <span>incident report</span>
          <span class="dl-sep">·</span>
          <span>file&nbsp;¶&nbsp;001</span>
        </p>

        <div class="ritual-rule" aria-hidden="true">
          <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
        </div>

        <p class="ritual-eyebrow">— ritual failed —</p>
        <h2 id="ritual-title" class="ritual-title">
          <em>Nice&nbsp;try.</em>
        </h2>
        <p class="ritual-line">the curses always come back.</p>

        <div class="ritual-rule" aria-hidden="true">
          <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
        </div>

        <dl class="ritual-facts">
          <div class="rf">
            <dt>verdict</dt>
            <dd>knowledge cannot be returned</dd>
          </div>
          <div class="rf">
            <dt>note</dt>
            <dd>you cannot <span class="strike">unlearn</span> what you have lived through.</dd>
          </div>
        </dl>

        <div class="ritual-meter">
          <div class="meter-label">
            <span>banishment progress</span>
            <span class="meter-value">0<span class="dim">%</span></span>
          </div>
          <div class="meter-track">
            <div class="meter-fill"></div>
          </div>
          <p class="meter-foot"><span class="dim">// procedure halted at threshold.</span></p>
        </div>

        <button id="ritual-close" class="ritual-btn" type="button">
          <span>accept the curse →</span>
        </button>

        <p class="ritual-sig">
          <span class="dim">filed by</span>
          <span class="sig-name"><em>the&nbsp;editor</em></span>
          <span class="dl-sep">·</span>
          <span>section&nbsp;X</span>
        </p>
      </article>
    </div>
  </div>

  <script is:inline>
    // ── Filtering ────────────────────────────────────────────────────────
    const curses = Array.from(document.querySelectorAll(".curse"));
    let activeSev = "all";
    let activeProj = "all";
    const emptyEl = document.getElementById("empty-state");

    function applyFilters() {
      let visible = 0;
      curses.forEach((el) => {
        const sevOk = activeSev === "all" || el.dataset.sev === activeSev;
        const projOk = activeProj === "all" || el.dataset.proj === activeProj;
        const ok = sevOk && projOk;
        el.classList.toggle("hidden", !ok);
        if (ok) visible++;
      });
      emptyEl?.classList.toggle("hidden", visible > 0);
    }

    document.querySelectorAll("[data-sev]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-sev]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeSev = btn.dataset.sev;
        applyFilters();
      });
    });
    document.querySelectorAll("[data-proj]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-proj]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeProj = btn.dataset.proj;
        applyFilters();
      });
    });

    function resetAll() {
      activeSev = "all";
      activeProj = "all";
      document.querySelectorAll("[data-sev]").forEach((b) => b.classList.toggle("active", b.dataset.sev === "all"));
      document.querySelectorAll("[data-proj]").forEach((b) => b.classList.toggle("active", b.dataset.proj === "all"));
      applyFilters();
    }
    document.getElementById("empty-reset")?.addEventListener("click", resetAll);

    // ── Random curse ─────────────────────────────────────────────────────
    document.getElementById("random-curse")?.addEventListener("click", () => {
      const visible = curses.filter((c) => !c.classList.contains("hidden"));
      if (!visible.length) return;
      const pick = visible[Math.floor(Math.random() * visible.length)];
      pick.scrollIntoView({ behavior: "smooth", block: "center" });
      pick.classList.add("flash");
      setTimeout(() => pick.classList.remove("flash"), 1600);
    });

    // ── Reveal on scroll ─────────────────────────────────────────────────
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );
    curses.forEach((c) => io.observe(c));

    // ── Banishment ritual modal ──────────────────────────────────────────
    const target = "exorcise";
    let buffer = "";
    let ritualActive = false;
    const modal = document.getElementById("ritual-modal");
    const modalClose = document.getElementById("ritual-close");
    const meterFill = modal?.querySelector(".meter-fill");
    const meterValue = modal?.querySelector(".meter-value");

    function openRitual() {
      if (!modal) return;
      modal.classList.add("open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      let pct = 0;
      const tick = setInterval(() => {
        pct += Math.random() * 9 + 3;
        if (pct >= 99) {
          pct = 99;
          clearInterval(tick);
          modal.classList.add("failed");
        }
        if (meterFill) meterFill.style.width = pct + "%";
        if (meterValue) meterValue.firstChild.textContent = Math.floor(pct).toString();
      }, 110);
      modal._tick = tick;
    }
    function closeRitual() {
      if (!modal) return;
      modal.classList.remove("open", "failed");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (modal._tick) clearInterval(modal._tick);
      if (meterFill) meterFill.style.width = "0%";
      if (meterValue) meterValue.firstChild.textContent = "0";
      ritualActive = false;
    }
    modalClose?.addEventListener("click", closeRitual);
    modal?.querySelector(".ritual-backdrop")?.addEventListener("click", closeRitual);
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal?.classList.contains("open")) closeRitual();
    });

    window.addEventListener("keydown", (e) => {
      if (e.target && /input|textarea/i.test(e.target.tagName)) return;
      if (ritualActive) return;
      if (e.key.length !== 1) return;
      buffer = (buffer + e.key.toLowerCase()).slice(-target.length);
      if (buffer === target) {
        ritualActive = true;
        document.body.classList.add("banishing");
        const visible = curses.filter((c) => !c.classList.contains("hidden"));
        visible.forEach((c, i) => setTimeout(() => c.classList.add("banished"), i * 60));
        setTimeout(
          () => {
            openRitual();
            setTimeout(() => {
              visible.forEach((c) => c.classList.remove("banished"));
              document.body.classList.remove("banishing");
            }, 600);
          },
          visible.length * 60 + 800,
        );
      }
    });
  </script>

  <style>
    @reference "tailwindcss";

    .page {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1.25rem 1.25rem 0.8rem;
      color: var(--color-text);
    }

    /* ─── Shared atoms ─── */
    .rule {
      display: flex;
      align-items: center;
      margin: 0.4rem 0;
    }
    .rule-line {
      flex: 1;
      height: 1px;
      background: var(--color-text);
      opacity: 0.85;
    }
    .rule-tick {
      width: 1px;
      height: 8px;
      background: var(--color-text);
      opacity: 0.85;
    }

    .dateline {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 8px;
      margin: 0 0 0.6rem;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      color: var(--color-muted);
      letter-spacing: 0.04em;
    }
    .dl-issue {
      color: var(--color-text);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .dl-sep {
      opacity: 0.5;
    }
    .dl-spacer {
      flex: 1;
      min-width: 8px;
    }
    .dl-warn {
      color: #ef4444;
      font-weight: 600;
    }
    .dim {
      color: var(--color-muted);
    }

    .mast {
      margin-bottom: 1.6rem;
    }
    .mast-title {
      text-align: center;
      margin: 0.8rem 0;
      line-height: 1;
      font-family: "Merriweather", Georgia, serif;
    }
    .mast-pre {
      display: block;
      font-family: ui-monospace, monospace;
      font-style: normal;
      font-weight: 400;
      font-size: 0.72rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 0.7rem;
    }
    .mast-main {
      display: inline-block;
      font-weight: 700;
      font-style: italic;
      font-size: clamp(2.2rem, 6vw, 3.8rem);
      letter-spacing: -0.02em;
      color: var(--color-text);
      line-height: 1.05;
    }
    .mast-by {
      text-align: center;
      margin: 0.4rem 0 0.5rem;
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--color-muted);
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }
    .mast-by strong {
      color: var(--color-text);
      font-weight: 700;
    }

    /* ─── Severity glyph ─── */
    .sev-mark {
      display: inline-block;
      font-family: "Merriweather", Georgia, serif;
      line-height: 1;
      vertical-align: -0.05em;
    }
    .sev-1 {
      color: #f59e0b;
    }
    .sev-2 {
      color: #ef4444;
    }
    .sev-3 {
      color: #a855f7;
    }

    /* ─── Stats strip ─── */
    .stats {
      list-style: none;
      margin: 0 0 1.6rem;
      padding: 0.9rem 0;
      border-top: 1px dashed var(--color-border);
      border-bottom: 1px dashed var(--color-border);
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.7rem 1.2rem;
      font-family: ui-monospace, monospace;
    }
    @media (min-width: 640px) {
      .stats {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    .stat {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .stat-v {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--color-text);
      line-height: 1;
      display: inline-flex;
      align-items: baseline;
      gap: 4px;
    }
    .stat-k {
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    /* ─── Controls ─── */
    .controls {
      margin: 0 0 2rem;
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
    }
    .ctl-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 10px;
      padding: 6px 0;
    }
    .ctl-line {
      border-top: 1px dashed var(--color-border);
    }
    .ctl-tag {
      color: var(--color-muted);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-size: 0.66rem;
      margin-right: 2px;
      user-select: none;
    }
    .ctl-tag::after {
      content: ":";
      margin-left: 2px;
    }
    .ctl-spacer {
      flex: 1;
      min-width: 8px;
    }

    .dl {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border: 0;
      background: transparent;
      color: var(--color-muted);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.78rem;
      border-radius: 3px;
      transition:
        color 0.15s ease,
        background 0.15s ease;
    }
    .dl:hover {
      color: var(--color-text);
      background: var(--color-surface);
    }
    .dl.active {
      color: var(--color-bg);
      background: var(--color-text);
      font-weight: 600;
    }
    .dl.active .sev-mark {
      color: var(--color-bg);
    }
    .dl.ghost {
      border: 1px solid var(--color-border);
      padding: 3px 10px;
      color: var(--color-text);
    }
    .dl.ghost:hover {
      border-color: #a855f7;
      color: #a855f7;
      background: transparent;
    }
    .ctl-foot {
      margin: 0.7rem 0 0;
      padding-top: 0.6rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.74rem;
      color: var(--color-text);
    }
    .ctl-foot kbd {
      display: inline-block;
      padding: 1px 5px;
      margin: 0 1px;
      font-size: 0.66rem;
      font-family: inherit;
      border: 1px solid var(--color-border);
      border-bottom-width: 2px;
      border-radius: 3px;
      background: var(--color-surface);
      color: var(--color-text);
    }

    /* ─── Entries (workshop-log style, sev-tinted) ─── */
    .entries {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }
    .curse {
      border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.45s ease,
        transform 0.45s ease;
    }
    .curse.revealed {
      opacity: 1;
      transform: none;
    }
    .curse:first-child {
      border-top: 0;
    }
    .curse.hidden {
      display: none !important;
    }

    .entry-link {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 14px;
      padding: 1rem 0.4rem;
      position: relative;
      transition: background 0.18s ease;
    }
    @media (min-width: 600px) {
      .entry-link {
        grid-template-columns: 100px 1fr;
        gap: 24px;
      }
    }
    .entry-link::before {
      content: "";
      position: absolute;
      left: -8px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.18s ease;
    }
    .curse:hover .entry-link {
      background: var(--color-surface);
    }
    .curse:hover .entry-link::before {
      opacity: 1;
    }

    .e-gutter {
      display: flex;
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
      font-family: ui-monospace, monospace;
      padding-top: 2px;
    }
    .e-num {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text);
    }
    .e-month {
      font-size: 0.66rem;
      color: var(--color-muted);
      letter-spacing: 0.16em;
    }
    .e-sev {
      display: inline-flex;
      gap: 1px;
      font-size: 1.05rem;
      line-height: 1;
      margin-top: 4px;
    }
    .sev-3 .e-sev {
      animation: sevPulse 2.4s ease-in-out infinite;
    }

    .e-body {
      min-width: 0;
    }
    .e-line {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .e-title {
      font-family: "Merriweather", Georgia, serif;
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.3;
      margin: 0 0 4px;
      color: var(--color-text);
      max-width: 720px;
    }
    .curse:hover .e-title {
      color: var(--accent);
    }
    .e-status {
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      color: var(--accent);
      text-transform: lowercase;
      letter-spacing: 0.04em;
      flex-shrink: 0;
    }
    .e-desc {
      margin: 6px 0 10px;
      font-size: 0.94rem;
      line-height: 1.65;
      color: var(--color-muted);
      max-width: 720px;
    }
    .e-desc :global(code) {
      font-family: ui-monospace, monospace;
      font-size: 0.85em;
      padding: 1px 5px;
      border-radius: 3px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text);
    }
    .e-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 14px;
      margin: 0;
      font-family: ui-monospace, monospace;
      font-size: 0.72rem;
      color: var(--color-muted);
    }
    .e-proj-tag,
    .e-tags-tag {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
      font-weight: 600;
      margin-right: 4px;
    }
    .e-proj {
      display: inline-flex;
      align-items: baseline;
      gap: 4px;
      color: var(--color-text);
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .e-proj:hover {
      color: var(--accent);
    }
    .e-proj-static {
      color: var(--color-text);
    }
    .e-proj-arrow {
      transition: transform 0.18s ease;
    }
    .e-proj:hover .e-proj-arrow {
      transform: translateX(2px);
      color: var(--accent);
    }
    .e-tags {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: baseline;
    }
    .e-tag-sep {
      color: var(--color-border);
      user-select: none;
    }
    .e-tag {
      color: var(--color-text);
    }

    /* Flash on random pick */
    .curse.flash .entry-link {
      background: color-mix(in srgb, var(--accent) 10%, var(--color-surface));
      animation: flash 1.6s ease;
    }
    @keyframes flash {
      0%,
      100% {
        box-shadow: inset 3px 0 0 0 var(--accent);
      }
      50% {
        box-shadow:
          inset 3px 0 0 0 var(--accent),
          0 0 24px color-mix(in srgb, var(--accent) 40%, transparent);
      }
    }

    /* Banishment animation */
    .curse.banished .entry-link {
      animation: banish 1.2s forwards;
    }
    @keyframes banish {
      to {
        opacity: 0;
        transform: translateY(-30px) scale(0.95);
        filter: blur(4px);
      }
    }
    body.banishing {
      cursor: wait;
    }

    @keyframes sevPulse {
      0%,
      100% {
        text-shadow: 0 0 0 transparent;
        opacity: 0.95;
      }
      50% {
        text-shadow: 0 0 8px color-mix(in srgb, #a855f7 60%, transparent);
        opacity: 1;
      }
    }

    /* ─── Empty state ─── */
    .empty {
      padding: 3rem 1rem;
      text-align: center;
      font-family: ui-monospace, monospace;
      color: var(--color-muted);
    }
    .empty.hidden {
      display: none;
    }
    .empty p {
      font-style: italic;
      margin: 0 0 10px;
    }

    /* ─── End of grimoire ─── */
    .grimoire-end {
      margin-top: 3rem;
      text-align: center;
    }
    .end-line {
      margin: 0.6rem 0 0.8rem;
      font-family: "Merriweather", Georgia, serif;
      font-size: 1.1rem;
      color: var(--color-text);
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: 6px;
    }
    .end-line em {
      font-style: italic;
    }
    .end-line span:not(.dl-sep) {
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--color-muted);
    }
    .meta-lesson {
      max-width: 580px;
      margin: 0.6rem auto 0;
      font-family: "Merriweather", Georgia, serif;
      font-style: italic;
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--color-muted);
    }

    /* ─── Reduced motion ─── */
    @media (prefers-reduced-motion: reduce) {
      .curse,
      .sev-3 .e-sev,
      .curse.banished .entry-link {
        animation: none !important;
        transition: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }

    /* ─────────── BANISHMENT RITUAL MODAL ─────────── */
    .ritual-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .ritual-modal.open {
      opacity: 1;
      pointer-events: auto;
    }
    .ritual-backdrop {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at center, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 65%),
        color-mix(in srgb, var(--color-bg) 88%, transparent);
      backdrop-filter: blur(6px);
    }
    .ritual-stage {
      position: relative;
      width: min(440px, 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      transform: scale(0.96) translateY(8px);
      transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ritual-modal.open .ritual-stage {
      transform: scale(1) translateY(0);
    }

    /* Pentagram — muted ink, no neon */
    .ritual-circle {
      position: absolute;
      inset: -28px;
      width: calc(100% + 56px);
      height: calc(100% + 56px);
      max-width: 540px;
      max-height: 540px;
      pointer-events: none;
      opacity: 0.32;
      animation: ritual-spin 60s linear infinite;
    }
    .ritual-circle .ring,
    .ritual-circle .pentagram {
      fill: none;
      stroke: var(--color-text);
      stroke-width: 0.5;
    }
    .ritual-circle .ring-outer {
      stroke-dasharray: 3 3;
    }
    .ritual-circle .ring-inner {
      stroke-dasharray: 1 3;
      opacity: 0.6;
    }
    .ritual-circle .pentagram {
      stroke-linejoin: round;
      opacity: 0.7;
    }
    .ritual-circle .ticks line {
      stroke: var(--color-muted);
      stroke-width: 0.5;
    }
    @keyframes ritual-spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* Runes — typographic glyphs in muted ink */
    .rune {
      position: absolute;
      font-family: "Merriweather", Georgia, serif;
      font-size: 1.2rem;
      color: var(--color-muted);
      pointer-events: none;
      opacity: 0.55;
      animation: rune-float 6s ease-in-out infinite;
    }
    .rune-1 {
      top: -34px;
      left: 14%;
      animation-delay: 0s;
    }
    .rune-2 {
      top: 8%;
      right: -28px;
      animation-delay: 0.7s;
    }
    .rune-3 {
      bottom: 12%;
      left: -32px;
      animation-delay: 1.4s;
    }
    .rune-4 {
      bottom: -28px;
      right: 22%;
      animation-delay: 2.1s;
    }
    .rune-5 {
      top: 40%;
      left: -36px;
      animation-delay: 2.8s;
    }
    .rune-6 {
      top: 60%;
      right: -32px;
      animation-delay: 3.5s;
    }
    @keyframes rune-float {
      0%,
      100% {
        transform: translateY(0);
        opacity: 0.4;
      }
      50% {
        transform: translateY(-6px);
        opacity: 0.75;
      }
    }

    /* Card — paper page, no rounded corners, no halo */
    .ritual-card {
      position: relative;
      z-index: 2;
      width: 100%;
      padding: 1.4rem 1.6rem 1.5rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      box-shadow:
        0 1px 0 var(--color-border),
        0 22px 50px -22px rgba(0, 0, 0, 0.35);
      color: var(--color-text);
      text-align: center;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .ritual-issue {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: 4px 8px;
      margin: 0 0 0.5rem;
      font-size: 0.66rem;
      letter-spacing: 0.04em;
      color: var(--color-muted);
    }
    .ri-tag {
      color: var(--color-text);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .ritual-rule {
      display: flex;
      align-items: center;
      gap: 0;
      margin: 0.4rem -0.2rem 0.6rem;
    }
    .ritual-rule .rule-line {
      flex: 1;
      height: 1px;
      background: var(--color-text);
      opacity: 0.85;
    }
    .ritual-rule .rule-tick {
      width: 1px;
      height: 7px;
      background: var(--color-text);
      opacity: 0.85;
    }

    .ritual-eyebrow {
      margin: 0.6rem 0 0.4rem;
      font-size: 0.62rem;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .ritual-title {
      margin: 0 0 0.4rem;
      font-family: "Merriweather", Georgia, serif;
      font-size: clamp(2rem, 5.5vw, 2.8rem);
      font-weight: 700;
      line-height: 1;
      color: var(--color-text);
    }
    .ritual-title em {
      font-style: italic;
    }
    .ritual-line {
      margin: 0 0 0.6rem;
      font-family: "Merriweather", Georgia, serif;
      font-style: italic;
      font-size: 1rem;
      color: var(--color-text);
    }

    /* Facts — same dt/dd rail used elsewhere */
    .ritual-facts {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      margin: 0.4rem auto 1rem;
      max-width: 360px;
      text-align: left;
    }
    .rf {
      display: grid;
      grid-template-columns: 70px 1fr;
      gap: 12px;
      padding: 7px 0;
      border-bottom: 1px dashed var(--color-border);
      align-items: baseline;
    }
    .rf:last-child {
      border-bottom: 0;
    }
    .rf dt {
      margin: 0;
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
      font-weight: 600;
    }
    .rf dd {
      margin: 0;
      font-size: 0.78rem;
      color: var(--color-text);
      line-height: 1.5;
    }
    .strike {
      text-decoration: line-through;
      text-decoration-color: var(--color-muted);
      text-decoration-thickness: 1.5px;
      color: var(--color-muted);
    }

    /* Meter — thin rule, monospace label */
    .ritual-meter {
      margin: 0 auto 1.2rem;
      max-width: 320px;
      text-align: left;
    }
    .meter-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 5px;
    }
    .meter-value {
      font-size: 0.78rem;
      color: var(--color-text);
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .ritual-modal.failed .meter-value {
      color: #ef4444;
    }
    .meter-track {
      height: 4px;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      overflow: hidden;
      position: relative;
    }
    .meter-fill {
      height: 100%;
      width: 0%;
      background: var(--color-text);
      transition:
        width 0.18s ease,
        background 0.4s ease;
    }
    .ritual-modal.failed .meter-fill {
      background: repeating-linear-gradient(45deg, #ef4444 0 4px, color-mix(in srgb, #ef4444 60%, transparent) 4px 8px);
      animation: meter-shake 0.4s ease-in-out 3;
    }
    @keyframes meter-shake {
      0%,
      100% {
        transform: translateX(0);
      }
      25% {
        transform: translateX(-2px);
      }
      75% {
        transform: translateX(2px);
      }
    }
    .meter-foot {
      margin: 6px 0 0;
      font-size: 0.66rem;
      color: var(--color-muted);
    }

    /* Button — same vocabulary as workshop-log primary actions */
    .ritual-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 14px;
      border: 1px solid var(--color-text);
      background: var(--color-text);
      color: var(--color-bg);
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition:
        background 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease;
    }
    .ritual-btn:hover {
      background: var(--color-bg);
      color: var(--color-text);
    }

    .ritual-sig {
      margin: 1rem 0 0;
      padding-top: 0.7rem;
      border-top: 1px dashed var(--color-border);
      font-size: 0.66rem;
      color: var(--color-muted);
      letter-spacing: 0.04em;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: 4px 6px;
    }
    .sig-name {
      font-family: "Merriweather", Georgia, serif;
      color: var(--color-text);
      font-size: 0.78rem;
    }
    .sig-name em {
      font-style: italic;
    }

    @media (prefers-reduced-motion: reduce) {
      .ritual-circle,
      .rune {
        animation: none !important;
      }
      .ritual-stage {
        transition: none !important;
      }
    }
  </style>
</BaseLayout>
