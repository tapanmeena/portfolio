---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Cctv, ChartCandlestick, ExternalLink, FileText, Gauge, Globe, Images, LockKeyhole, ShieldCheck, Workflow } from "@lucide/astro";
import { labEntries, labGroups } from "@data/lab";

const pageDescription = "A field guide to the self-hosted services, Raspberry Pi projects, and quiet infrastructure running behind the workshop.";

const serviceIcons = {
  market: ChartCandlestick,
  camera: Cctv,
  media: Images,
  workflow: Workflow,
  gauge: Gauge,
};

const accessIcons = {
  public: Globe,
  "case-study": FileText,
  private: LockKeyhole,
  restricted: ShieldCheck,
};

const accessLabels = {
  public: "public",
  "case-study": "case study",
  private: "private",
  restricted: "restricted",
};

const groupedEntries = labGroups.map((group) => ({
  ...group,
  entries: labEntries.filter((entry) => entry.group === group.id),
}));
const numberOf = new Map(labEntries.map((entry, index) => [entry.id, index + 1]));
const pad = (value: number) => String(value).padStart(2, "0");

const builtCount = labEntries.filter((entry) => entry.group === "built").length;
const publicCount = labEntries.filter((entry) => entry.access === "public").length;

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today
  .toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  })
  .toLowerCase();
---

<BaseLayout pageTitle="The Machine Room - Tapan Meena" description={pageDescription}>
  <div class="lab-shell">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;E&nbsp;//&nbsp;the&nbsp;machine&nbsp;room</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
      <span class="dl-spacer"></span>
      <span>{pad(labEntries.length)}&nbsp;systems</span>
    </p>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <p class="mast-pre">a field inventory of</p>
      <h1 class="mast-title">
        <span class="mast-main">the machine room</span>
      </h1>
      <p class="mast-sub">small systems, kept alive</p>
      <p class="mast-policy">
        self-hosted <span>·</span> private by default <span>·</span> public on purpose
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <ul class="stats" aria-label="Machine room summary">
      <li class="stat">
        <span class="stat-value">{pad(labEntries.length)}</span>
        <span class="stat-label">entries</span>
      </li>
      <li class="stat">
        <span class="stat-value">{pad(builtCount)}</span>
        <span class="stat-label">built here</span>
      </li>
      <li class="stat">
        <span class="stat-value">{pad(publicCount)}</span>
        <span class="stat-label">public</span>
      </li>
      <li class="stat">
        <span class="stat-value stat-word">private</span>
        <span class="stat-label">default</span>
      </li>
    </ul>

    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="section-kicker">field note&nbsp;//&nbsp;01</p>
        <h2 id="intro-title">Systems with a public story and a private edge.</h2>
        <p class="lede">
          Some things I build are meant to be read about. Others have to survive reboots, expiring tokens, full disks, and my own bad decisions. This
          is the small stack running behind the workshop: public experiments, private media, and the machinery that keeps both alive.
        </p>
      </div>

      <aside class="access-key" aria-labelledby="access-title">
        <h2 id="access-title">access key</h2>
        <ul>
          <li>
            <Globe size={12} aria-hidden="true" /><span>public</span><small>open application</small>
          </li>
          <li>
            <FileText size={12} aria-hidden="true" /><span>case study</span><small>notes only</small>
          </li>
          <li>
            <LockKeyhole size={12} aria-hidden="true" /><span>private</span><small>trusted devices</small>
          </li>
          <li>
            <ShieldCheck size={12} aria-hidden="true" /><span>restricted</span><small>operators only</small>
          </li>
        </ul>
      </aside>
    </section>

    <div class="catalogue">
      {
        groupedEntries.map((group, groupIndex) => (
          <section class="lab-group" aria-labelledby={`group-${group.id}`}>
            <header class="group-head">
              <div class="group-title">
                <span>{pad(groupIndex + 1)}&nbsp;//</span>
                <h2 id={`group-${group.id}`}>{group.label}</h2>
              </div>
              <span>
                {pad(group.entries.length)} {group.entries.length === 1 ? "entry" : "entries"}
              </span>
            </header>

            <ol class="machine-list">
              {group.entries.map((entry) => {
                const ServiceIcon = serviceIcons[entry.icon];
                const AccessIcon = accessIcons[entry.access];
                const projectActionLabel = entry.id === "stalkmarket" ? "read the build" : "read case study";

                return (
                  <li class="machine-entry" style={`--entry-accent:${entry.accent}`}>
                    <article class="entry-shell">
                      <div class="entry-gutter" aria-hidden="true">
                        <span class="entry-number">{pad(numberOf.get(entry.id)!)}</span>
                        <span class="entry-code">{entry.group === "built" ? "made" : entry.group === "hosted" ? "host" : "ops"}</span>
                      </div>

                      <div class="entry-body">
                        <div class="entry-title-row">
                          <span class="service-icon" aria-hidden="true">
                            <ServiceIcon size={18} />
                          </span>
                          <h3>{entry.title}</h3>
                        </div>
                        <p class="entry-description">{entry.description}</p>
                        <p class="entry-stack">{entry.stack.join(" · ")}</p>
                      </div>

                      <div class="entry-side">
                        <span class="access-label">
                          <AccessIcon size={12} aria-hidden="true" />
                          {accessLabels[entry.access]}
                        </span>
                        {(entry.projectUrl || entry.liveUrl) && (
                          <div class="entry-actions">
                            {entry.projectUrl && (
                              <a href={entry.projectUrl}>
                                <FileText size={13} aria-hidden="true" />
                                <span>{projectActionLabel}</span>
                              </a>
                            )}
                            {entry.liveUrl && (
                              <a href={entry.liveUrl} target="_blank" rel="noopener noreferrer">
                                <ExternalLink size={13} aria-hidden="true" />
                                <span>open public demo</span>
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    </article>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }
    </div>

    <section class="map-section" aria-labelledby="map-title">
      <header class="section-head">
        <div>
          <span class="section-kicker">field diagram&nbsp;//&nbsp;02</span>
          <h2 id="map-title">How traffic reaches the machine room</h2>
        </div>
        <span class="section-index">not to scale</span>
      </header>

      <figure class="traffic-map" aria-describedby="map-caption">
        <div class="map-origins">
          <div class="map-node map-origin">
            <span class="map-index">01</span>
            <strong>public visitor</strong>
            <small>public route</small>
          </div>
          <div class="map-node map-origin">
            <span class="map-index">02</span>
            <strong>trusted device</strong>
            <small>identity gate</small>
          </div>
        </div>

        <span class="map-flow" aria-hidden="true">&#8595;</span>

        <div class="map-node map-edge">
          <span class="map-index">edge</span>
          <strong>Cloudflare edge</strong>
          <small>policy and routing</small>
        </div>

        <span class="map-flow" aria-hidden="true">&#8595;</span>
        <span class="map-route">secure tunnel</span>
        <span class="map-flow" aria-hidden="true">&#8595;</span>

        <div class="map-node map-home">
          <span class="map-index">node</span>
          <strong>home node / Docker</strong>
          <small>private network boundary</small>
        </div>

        <span class="map-flow map-branch-flow" aria-hidden="true">&#8595;</span>

        <ul class="map-branches" aria-label="System groups">
          <li><span>01</span><strong>built</strong></li>
          <li><span>02</span><strong>media</strong></li>
          <li><span>03</span><strong>automation</strong></li>
          <li><span>04</span><strong>operations</strong></li>
        </ul>

        <figcaption id="map-caption">
          A deliberately incomplete map: enough to explain the trust boundary, not enough to inventory the network.
        </figcaption>
      </figure>
    </section>

    <aside class="field-note" aria-label="Publication policy">
      <span>field note&nbsp;//&nbsp;public by exception</span>
      <p>Public links are the exception. Private systems get an explanation, never a doorway.</p>
    </aside>
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .lab-shell {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 5rem;
    color: var(--color-text);
  }

  .rule {
    display: flex;
    align-items: center;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }
  .dl-spacer {
    flex: 1;
    min-width: 8px;
  }

  .mast {
    margin-bottom: 1.5rem;
  }
  .mast-title {
    margin: 0 0 0.45rem;
    text-align: center;
    font-family: "Merriweather", Georgia, serif;
    line-height: 1.05;
  }
  .mast-pre {
    display: block;
    margin: 1rem 0 0.75rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .mast-main {
    display: block;
    font-size: 2.35rem;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text);
  }
  .mast-sub {
    margin: 0 0 0.4rem;
    text-align: center;
    font-family: "Merriweather", Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    color: var(--color-muted);
  }
  .mast-policy {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px;
    margin: 0 0 0.8rem;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  .mast-policy span {
    opacity: 0.45;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.2rem;
    margin: 0 0 2rem;
    padding: 1rem 0;
    list-style: none;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .stat-value {
    font-family: ui-monospace, monospace;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-text);
  }
  .stat-word {
    font-size: 1rem;
    line-height: 1.45rem;
  }
  .stat-label {
    font-family: ui-monospace, monospace;
    font-size: 0.64rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 3rem;
    margin-bottom: 2.8rem;
  }
  .section-kicker {
    display: block;
    margin: 0 0 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .intro-copy h2,
  .section-head h2 {
    margin: 0 0 0.65rem;
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-text);
  }
  .lede {
    max-width: 680px;
    margin: 0;
    font-family: "Merriweather", Georgia, serif;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .access-key {
    padding: 0.8rem 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
  }
  .access-key h2 {
    margin: 0 0 0.65rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .access-key ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .access-key li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    column-gap: 5px;
    min-width: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--color-text);
  }
  .access-key small {
    grid-column: 2;
    color: var(--color-muted);
  }

  .lab-group {
    margin-bottom: 2.35rem;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 0.75rem;
    border-bottom: 1px dashed var(--color-border);
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .group-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .group-title > span {
    color: var(--color-muted);
  }
  .group-title h2 {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .machine-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .machine-entry {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 65%, transparent);
  }
  .machine-entry:first-child {
    border-top: 0;
  }
  .entry-shell {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 0 14px;
    padding: 1.1rem 0.4rem;
  }
  .entry-shell::before {
    position: absolute;
    top: 1.1rem;
    bottom: 1.1rem;
    left: -8px;
    width: 2px;
    background: var(--entry-accent);
    content: "";
  }
  .entry-gutter {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 2px;
    font-family: ui-monospace, monospace;
  }
  .entry-number {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .entry-code {
    font-size: 0.62rem;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .entry-body {
    min-width: 0;
  }
  .entry-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0.35rem;
  }
  .service-icon {
    display: inline-flex;
    flex: 0 0 22px;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: var(--entry-accent);
  }
  .entry-title-row h3 {
    margin: 0;
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-text);
  }
  .entry-description {
    max-width: 680px;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .entry-stack {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .entry-side {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.7rem;
  }
  .access-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: lowercase;
    color: var(--color-muted);
  }
  .entry-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .entry-actions a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    gap: 6px;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    text-decoration: none;
    background: transparent;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }
  .entry-actions a:hover {
    border-color: var(--entry-accent);
    background: var(--color-surface);
  }
  .entry-actions a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .map-section {
    margin-top: 3.1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .section-index {
    flex: 0 0 auto;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    color: var(--color-muted);
  }

  .traffic-map {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
  }
  .map-origins {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
    width: min(100%, 560px);
  }
  .map-node {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    width: min(100%, 330px);
    min-height: 64px;
    align-content: center;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: ui-monospace, monospace;
  }
  .map-origin {
    width: 100%;
  }
  .map-index {
    grid-row: 1 / span 2;
    align-self: center;
    font-size: 0.62rem;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .map-node strong {
    min-width: 0;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .map-node small {
    font-size: 0.64rem;
    color: var(--color-muted);
  }
  .map-edge {
    border-left: 2px solid #3b82f6;
  }
  .map-home {
    border-left: 2px solid #10b981;
  }
  .map-flow {
    display: block;
    height: 27px;
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    line-height: 27px;
    color: var(--color-muted);
  }
  .map-route {
    padding: 0.15rem 0.45rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    color: var(--color-muted);
  }
  .map-branch-flow {
    height: 35px;
    line-height: 35px;
  }
  .map-branches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .map-branches li {
    display: flex;
    min-width: 0;
    min-height: 48px;
    align-items: center;
    gap: 8px;
    padding: 0.55rem 0.65rem;
    border-top: 2px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-family: ui-monospace, monospace;
  }
  .map-branches li:nth-child(1) {
    border-top-color: #10b981;
  }
  .map-branches li:nth-child(2) {
    border-top-color: #3b82f6;
  }
  .map-branches li:nth-child(3) {
    border-top-color: #f59e0b;
  }
  .map-branches li:nth-child(4) {
    border-top-color: #06b6d4;
  }
  .map-branches span {
    flex: 0 0 auto;
    font-size: 0.6rem;
    color: var(--color-muted);
  }
  .map-branches strong {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .traffic-map figcaption {
    width: 100%;
    margin-top: 1.25rem;
    padding: 0.8rem 0;
    border-top: 1px dashed var(--color-border);
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .field-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.45rem 1.5rem;
    margin-top: 2.2rem;
