---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { authors } from "@data/authors";
import ProjectCard from "@components/projects/ProjectCard.astro";
import Button from "@components/ui/Button.astro";
import { getFeaturedProjects } from "@utils/projects";
import { Github, Linkedin, Twitter, ArrowRight, ArrowUpRight, Mail, MapPin, Skull, Terminal, Rss } from "@lucide/astro";

const author = authors["tapan-meena"];

// Latest blog posts (non-draft, newest first)
const allPosts = await getCollection("blog");
const posts = allPosts.filter((p) => !p.data.draft).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const [featuredPost, ...restPosts] = posts;
const sidePosts = restPosts.slice(0, 3);

// Currently building: pick the most-recent in-progress project
const allProjects = await getCollection("projects");
const inProgress = allProjects
  .filter((p) => !p.data.draft && p.data.status === "in-progress")
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const nowBuilding = inProgress[0];

const featuredProjects = getFeaturedProjects(allProjects).slice(0, 3);

// Compact stack: a few hand-picked categories
const stackGroups = (author.skills ?? [])
  .filter((g) => ["Programming Languages", "Backend Development", "Cloud & DevOps", "Databases"].includes(g.name))
  .map((g) => ({ name: g.name, skills: g.skills.slice(0, 5) }));

function fmtMonth(d: Date) {
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

<BaseLayout pageTitle="Home">
  <div class="home">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__intro">
        <p class="prompt">
          <Terminal size={14} />
          <span>~/tapan</span><span class="caret">▍</span>
        </p>
        <h1 class="hero__name">
          Hi, I'm <span class="hero__name-mark">Tapan</span>.
        </h1>
        <p class="hero__lede">
          Senior software engineer in <strong>Hyderabad</strong>, building scalable backends, developer tools, and the occasional Raspberry-Pi trading
          bot. I write about what I learn — including the parts that made me regret things.
        </p>

        <div class="hero__cta">
          <Button href="/blog" variant="primary" size="lg">
            Read the blog
            <ArrowRight slot="icon-right" size={18} />
          </Button>
          <Button href="/projects" variant="outline" size="lg"> See projects </Button>
        </div>

        <ul class="hero__socials" aria-label="Social links">
          {
            author.social?.github && (
              <li>
                <a href={author.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                  <Github size={18} /> <span>GitHub</span>
                </a>
              </li>
            )
          }
          {
            author.social?.linkedin && (
              <li>
                <a href={author.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <Linkedin size={18} /> <span>LinkedIn</span>
                </a>
              </li>
            )
          }
          {
            author.social?.twitter && (
              <li>
                <a href={author.social.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                  <Twitter size={18} /> <span>Twitter</span>
                </a>
              </li>
            )
          }
          <li>
            <a href="/rss.xml" aria-label="RSS feed">
              <Rss size={18} />
              <span>RSS</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- NOW panel -->
      <aside class="now" aria-label="Now">
        <header class="now__header">
          <span class="now__dot" aria-hidden="true"></span>
          <h2 class="now__title">Now</h2>
          <span class="now__meta">
            <MapPin size={12} /> Hyderabad · IST
          </span>
        </header>

        <dl class="now__list">
          {
            nowBuilding && (
              <div class="now__row">
                <dt>Building</dt>
                <dd>
                  <a href={`/projects/${nowBuilding.id}`}>
                    {nowBuilding.data.title} <ArrowUpRight size={14} />
                  </a>
                  <p>{nowBuilding.data.description}</p>
                </dd>
              </div>
            )
          }

          {
            featuredPost && (
              <div class="now__row">
                <dt>Latest write-up</dt>
                <dd>
                  <a href={`/blog/${featuredPost.id}`}>
                    {featuredPost.data.title} <ArrowUpRight size={14} />
                  </a>
                  <p>
                    {fmtMonth(featuredPost.data.publishedAt)} ·{featuredPost.data.category}
                  </p>
                </dd>
              </div>
            )
          }

          <div class="now__row">
            <dt>Cursed lesson</dt>
            <dd>
              <a href="/cursed-knowledge">
                Things I wish I'd known earlier <ArrowUpRight size={14} />
              </a>
              <p>A growing index of self-inflicted developer pain.</p>
            </dd>
          </div>
        </dl>
      </aside>
    </section>

    <!-- LATEST WRITING -->
    {
      posts.length > 0 && (
        <section class="block">
          <header class="block__header">
            <div>
              <p class="kicker">§ Writing</p>
              <h2 class="block__title">From the blog</h2>
            </div>
            <a href="/blog" class="block__more">
              All posts <ArrowRight size={16} />
            </a>
          </header>

          <ol class="post-list">
            {featuredPost && (
              <li class="post post--lead">
                <span class="post__num">01</span>
                <a href={`/blog/${featuredPost.id}`} class="post__link">
                  <p class="post__meta">
                    <time datetime={featuredPost.data.publishedAt.toISOString()}>{fmtMonth(featuredPost.data.publishedAt)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{featuredPost.data.category}</span>
                  </p>
                  <h3 class="post__title">{featuredPost.data.title}</h3>
                  <p class="post__excerpt">{featuredPost.data.description}</p>
                </a>
              </li>
            )}

            {sidePosts.map((post, i) => (
              <li class="post">
                <span class="post__num">{String(i + 2).padStart(2, "0")}</span>
                <a href={`/blog/${post.id}`} class="post__link">
                  <p class="post__meta">
                    <time datetime={post.data.publishedAt.toISOString()}>{fmtMonth(post.data.publishedAt)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{post.data.category}</span>
                  </p>
                  <h3 class="post__title">{post.data.title}</h3>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- BUILDING -->
    {
      featuredProjects.length > 0 && (
        <section class="block">
          <header class="block__header">
            <div>
              <p class="kicker">§ Building</p>
              <h2 class="block__title">Selected projects</h2>
            </div>
            <a href="/projects" class="block__more">
              All projects <ArrowRight size={16} />
            </a>
          </header>

          <div class="projects-grid">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }

    <!-- CURSED KNOWLEDGE TEASER -->
    <section class="cursed">
      <a href="/cursed-knowledge" class="cursed__link">
        <div class="cursed__head">
          <Skull size={20} />
          <p class="kicker kicker--invert">§ Cursed Knowledge</p>
        </div>
        <h2 class="cursed__title">A growing index of things I learned the hard way.</h2>
        <p class="cursed__sub">
          Auth gone wrong, SQLite at 1× speed, OCR backed by zero reasoning — tagged by project and severity, sortable by regret.
        </p>
        <span class="cursed__cta">
          Open the grimoire <ArrowRight size={16} />
        </span>
      </a>
    </section>

    <!-- STACK -->
    {
      stackGroups.length > 0 && (
        <section class="block">
          <header class="block__header">
            <div>
              <p class="kicker">§ Stack</p>
              <h2 class="block__title">What I reach for</h2>
            </div>
            <a href="/about" class="block__more">
              More about me <ArrowRight size={16} />
            </a>
          </header>

          <div class="stack">
            {stackGroups.map((g) => (
              <div class="stack__col">
                <h3 class="stack__name">{g.name}</h3>
                <ul class="stack__items">
                  {g.skills.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- CONTACT -->
    <section class="contact">
      <div class="contact__inner">
        <p class="kicker">§ Contact</p>
        <h2 class="contact__title">Have a problem worth solving?</h2>
        <p class="contact__sub">
          Consulting, collaboration, or just a good conversation —
          {" "}<a href={`mailto:${author.email}`}>{author.email}</a>{" "}
          is the fastest way in.
        </p>
        <Button href="/contact" variant="primary" size="lg">
          <Mail slot="icon-left" size={18} />
          Get in touch
        </Button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .home {
    @apply mx-auto max-w-6xl px-4 pb-20;
  }

  /* ── HERO ─────────────────────────────────────────── */
  .hero {
    @apply grid gap-10 py-12 md:py-16 md:grid-cols-[1.4fr_1fr] md:gap-14;
  }

  .prompt {
    @apply inline-flex items-center gap-2 text-xs mb-6;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prompt .caret {
    color: var(--color-accent);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero__name {
    @apply text-4xl md:text-6xl font-bold leading-tight tracking-tight;
    color: var(--color-text);
    font-family: var(--font-sans);
  }
  .hero__name-mark {
    background: linear-gradient(120deg, var(--color-accent), var(--color-accent-hover));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    @apply mt-5 text-base md:text-lg leading-relaxed max-w-xl;
    color: var(--color-muted);
  }
  .hero__lede strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .hero__cta {
    @apply mt-7 flex flex-wrap gap-3;
  }

  .hero__socials {
    @apply mt-8 flex flex-wrap gap-x-5 gap-y-2 list-none p-0 m-0;
  }
  .hero__socials a {
    @apply inline-flex items-center gap-1.5 text-sm font-medium;
    color: var(--color-muted);
    text-decoration: none;
  }
  .hero__socials a:hover {
    color: var(--color-accent);
  }

  /* NOW panel */
  .now {
    @apply rounded-xl p-5 md:p-6 self-start;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
  }
  .now__header {
    @apply flex items-center gap-2 mb-5 pb-4;
    border-bottom: 1px dashed var(--color-border);
  }
  .now__title {
    @apply text-base font-semibold m-0;
    color: var(--color-text);
  }
  .now__dot {
    @apply inline-block w-2 h-2 rounded-full;
    background: #16a34a;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.18);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.18);
    }
    50% {
      box-shadow: 0 0 0 7px rgba(22, 163, 74, 0.05);
    }
  }
  .now__meta {
    @apply ml-auto inline-flex items-center gap-1 text-xs;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .now__list {
    @apply space-y-4 m-0 p-0;
  }
  .now__row {
    @apply m-0;
  }
  .now__row dt {
    @apply text-[11px] uppercase font-semibold mb-1;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }
  .now__row dd {
    @apply m-0;
  }
  .now__row dd a {
    @apply inline-flex items-center gap-1 text-sm font-semibold;
    color: var(--color-text);
    text-decoration: none;
  }
  .now__row dd a:hover {
    color: var(--color-accent);
  }
  .now__row dd p {
    @apply text-sm mt-1 leading-snug;
    color: var(--color-muted);
  }

  /* ── BLOCK (generic section) ──────────────────────── */
  .block {
    @apply py-12 border-t;
    border-color: var(--color-border);
  }
  .block__header {
    @apply flex flex-wrap items-end justify-between gap-4 mb-8;
  }
  .kicker {
    @apply text-xs uppercase mb-1 m-0;
    color: var(--color-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
  }
  .block__title {
    @apply text-2xl md:text-3xl font-bold m-0;
    color: var(--color-text);
    font-family: var(--font-sans);
    letter-spacing: -0.02em;
  }
  .block__more {
    @apply inline-flex items-center gap-1.5 text-sm font-medium;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s ease;
  }
  .block__more:hover {
    gap: 0.625rem;
  }

  /* ── POST LIST ────────────────────────────────────── */
  .post-list {
    @apply list-none p-0 m-0;
  }

  .post {
    @apply grid gap-4 py-5;
    grid-template-columns: 2.5rem 1fr;
    border-top: 1px solid var(--color-border);
  }
  .post:first-child {
    border-top: none;
  }

  .post__num {
    @apply text-sm pt-1;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .post__link {
    @apply block;
    text-decoration: none;
    color: inherit;
  }
  .post__meta {
    @apply text-xs uppercase m-0 mb-2 inline-flex items-center gap-2;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }
  .post__title {
    @apply text-xl md:text-2xl font-semibold m-0 leading-snug;
    color: var(--color-text);
    transition: color 0.2s ease;
  }
  .post__link:hover .post__title {
    color: var(--color-accent);
  }

  .post__excerpt {
    @apply text-base mt-3 leading-relaxed max-w-2xl;
    color: var(--color-muted);
  }
  .post--lead .post__title {
    @apply text-2xl md:text-3xl;
    letter-spacing: -0.015em;
  }
  /* ── PROJECTS GRID ─────────────────────────────── */
  .projects-grid {
    @apply grid gap-6 md:grid-cols-2 lg:grid-cols-3;
  }
  /* ── CURSED TEASER ────────────────────────────────── */
  .cursed {
    @apply py-12;
  }
  .cursed__link {
    @apply block rounded-2xl p-8 md:p-12 relative overflow-hidden;
    background: radial-gradient(1200px 400px at 0% 0%, rgba(99, 179, 237, 0.18), transparent 60%), linear-gradient(180deg, #0b1220 0%, #0a0f1a 100%);
    color: #e2e8f0;
    text-decoration: none;
    border: 1px solid rgba(99, 179, 237, 0.25);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .cursed__link:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 179, 237, 0.55);
  }
  .cursed__head {
    @apply flex items-center gap-2 mb-4;
    color: #fda4af;
  }
  .kicker--invert {
    color: #fda4af;
    margin: 0;
  }
  .cursed__title {
    @apply text-2xl md:text-3xl font-bold m-0 max-w-3xl;
    letter-spacing: -0.02em;
    font-family: var(--font-sans);
    color: #f8fafc;
  }
  .cursed__sub {
    @apply mt-3 text-base md:text-lg max-w-2xl;
    color: #cbd5e1;
  }
  .cursed__cta {
    @apply mt-6 inline-flex items-center gap-2 text-sm font-semibold;
    color: #93c5fd;
    transition: gap 0.2s ease;
  }
  .cursed__link:hover .cursed__cta {
    gap: 0.625rem;
  }

  /* ── STACK ───────────────────────────────────────── */
  .stack {
    @apply grid gap-6 sm:grid-cols-2 lg:grid-cols-4;
  }
  .stack__col {
    @apply rounded-lg p-5;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .stack__name {
    @apply text-sm font-semibold m-0 mb-3 pb-3;
    color: var(--color-text);
    border-bottom: 1px dashed var(--color-border);
  }
  .stack__items {
    @apply list-none p-0 m-0 text-sm;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .stack__items li {
    @apply py-1;
  }
  .stack__items li::before {
    content: "› ";
    color: var(--color-accent);
  }

  /* ── CONTACT ─────────────────────────────────────── */
  .contact {
    @apply py-16 mt-8;
    border-top: 1px solid var(--color-border);
  }
  .contact__inner {
    @apply max-w-2xl;
  }
  .contact__title {
    @apply text-3xl md:text-4xl font-bold mt-2 mb-4;
    color: var(--color-text);
    font-family: var(--font-sans);
    letter-spacing: -0.02em;
  }
  .contact__sub {
    @apply text-base md:text-lg mb-6 leading-relaxed;
    color: var(--color-muted);
  }
  .contact__sub a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
  }
  .contact__sub a:hover {
    color: var(--color-accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt .caret,
    .now__dot {
      animation: none;
    }
  }
</style>
