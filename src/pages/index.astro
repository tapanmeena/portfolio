---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { authors } from "@data/authors";
import { curseStats } from "@data/curses";
import { labEntries } from "@data/lab";
import { Github, Linkedin, Twitter, Mail, Rss, ArrowUpRight } from "@lucide/astro";
import { getPublishedProjects, normalizeTech, isOngoing } from "@utils/projects";

const author = authors["tapan-meena"];

// ── Posts ──────────────────────────────────────────────────────────────
const allPosts = await getCollection("blog");
const posts = allPosts.filter((p) => !p.data.draft).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// ── Projects ───────────────────────────────────────────────────────────
const allProjects = await getCollection("projects");
const projects = getPublishedProjects(allProjects);
const numbered = [...projects].reverse();
const numberOf = new Map(numbered.map((p, i) => [p.id, i + 1]));
const pad = (n: number) => String(n).padStart(2, "0");

const inProgress = projects.filter((p) => p.data.status === "in-progress");
// Pin a project to the "currently" spotlight; falls back to the newest in-progress one.
const spotlightId = "cultbot";
const nowBuilding = projects.find((p) => p.id === spotlightId) ?? inProgress[0];
const nowActive = nowBuilding?.data.status === "in-progress";
const nowLabel = nowActive ? "currently" : "just shipped";

const recentProjects = projects.slice(0, 4);
const recentPosts = posts.slice(0, 4);
const publicLabEntry = labEntries.find((entry) => entry.access === "public");
const privateLabEntry = labEntries.find((entry) => entry.id === "personal-media-cloud");
const restrictedLabEntries = labEntries.filter((entry) => entry.access === "restricted");
const curseYearRange =
  curseStats.earliestYear === curseStats.latestYear ? String(curseStats.earliestYear) : `${curseStats.earliestYear} to ${curseStats.latestYear}`;

// ── Category palette (matches /projects) ──────────────────────────────
const catColor: Record<string, string> = {
  Fintech: "#10b981",
  "Web Apps": "#3b82f6",
  "Web Development": "#3b82f6",
  "Mobile Apps": "#8b5cf6",
  "Desktop Apps": "#06b6d4",
  "CLI Tools": "#f59e0b",
  Libraries: "#ec4899",
  Games: "#ef4444",
  "ML/AI": "#a855f7",
  "IoT/Security": "#14b8a6",
};
const colorOf = (c?: string) => (c && catColor[c]) || "#6366f1";

const monthShort = (d: Date) => d.toLocaleString("default", { month: "short" }).toUpperCase();
const fullDate = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

// ── Tiny stats for the masthead ───────────────────────────────────────
const totalProjects = projects.length;
const totalPosts = posts.length;
const yearsActive = (() => {
  const earliest = projects.reduce((acc, p) => Math.min(acc, new Date(p.data.startDate).getFullYear()), 9999);
  return new Date().getFullYear() - earliest + 1;
})();

// ── Today's date for the dateline ─────────────────────────────────────
const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();

// ── About blurbs ───────────────────────────────────────────────
const experience = author.experience ?? [];
const totalYearsPro = (() => {
  const years = experience.map((e) => e.period.match(/(\d{4})/g)?.map((y) => parseInt(y, 10)) ?? []).flat();
  if (!years.length) return null;
  return new Date().getFullYear() - Math.min(...years);
})();
const pickedCats = ["Programming Languages", "Backend Development", "Cloud & DevOps", "Databases"];
const inlineStack = (author.skills ?? []).filter((g) => pickedCats.includes(g.name)).flatMap((g) => g.skills.slice(0, 4));
const facts: { dt: string; dd: string }[] = [
  { dt: "based", dd: "hyderabad, india · ist" },
  { dt: "role", dd: `${(author.title ?? "").toLowerCase()} · maq software` },
  { dt: "focus", dd: "backends · dev tools · cloud" },
  { dt: "off-screen", dd: "books · chai · long walks" },
];

// Precompute experience helpers (avoids regex literals inside JSX)
const expEntries = experience.map((e) => {
  const yearMatch = e.period.match(/(\d{4})/);
  return {
    title: e.title,
    company: e.company,
    period: e.period,
    periodLower: e.period.toLowerCase(),
    description: e.description ?? "",
    startYear: yearMatch ? yearMatch[0] : "",
    isCurrent: /present|current/i.test(e.period),
  };
});
---

<BaseLayout pageTitle="Tapan Meena — Senior Software Engineer">
  <div class="logbook-home">
    <!-- ─────────── DATELINE ─────────── -->
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
      <span class="dl-sep">·</span>
      <span>hyderabad &nbsp;ist</span>
      <span class="dl-spacer"></span>
      <span class="dl-counts">
        <b>{totalProjects}</b>&nbsp;projects&nbsp; <b>{totalPosts}</b>&nbsp;in&nbsp;the&nbsp;writing&nbsp;log&nbsp; <b>{yearsActive}</b>&nbsp;years
      </span>
    </p>

    <!-- ─────────── MASTHEAD ─────────── -->
    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">an honest log of</span>
        <span class="mast-main">things (A)I've built<br />&amp; learned the hard way</span>
      </h1>
      <p class="mast-by">
        <span>by</span>
        <span class="mast-by-name">Tapan Meena</span>
        <span class="dl-sep">·</span>
        <span>senior supervisor of artificial intelligence</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <!-- ─────────── INTRO + NOW ─────────── -->
    <section class="intro">
      <div class="intro-text">
        <p class="lede">
          I build scalable backends, developer tools, and the occasional Raspberry-Pi trading bot out of <strong>Hyderabad</strong> — lately with help from
          my <strong>artificial friends</strong>. They autocomplete; I take the blame. This is where I keep the receipts — every project, every
          writeup, every cursed lesson — in one running log.
        </p>
        <ul class="quick-nav">
          <li><a href="/projects">→ the workshop log</a></li>
          <li><a href="/lab">→ the machine room</a></li>
          <li><a href="/blog">→ writing</a></li>
          <li><a href="/trading">→ the trading desk</a></li>
          <li><a href="/cursed-knowledge">→ cursed knowledge</a></li>
          <li><a href="/contact">→ get in touch</a></li>
        </ul>
        <ul class="socials" aria-label="Elsewhere">
          {
            author.social?.github && (
              <li>
                <a href={author.social.github} target="_blank" rel="noopener noreferrer">
                  <Github size={13} /> github
                </a>
              </li>
            )
          }
          {
            author.social?.linkedin && (
              <li>
                <a href={author.social.linkedin} target="_blank" rel="noopener noreferrer">
                  <Linkedin size={13} /> linkedin
                </a>
              </li>
            )
          }
          {
            author.social?.twitter && (
              <li>
                <a href={author.social.twitter} target="_blank" rel="noopener noreferrer">
                  <Twitter size={13} /> twitter
                </a>
              </li>
            )
          }
          <li><a href="/rss.xml"><Rss size={13} /> rss</a></li>
          {
            author.email && (
              <li>
                <a href={`mailto:${author.email}`}>
                  <Mail size={13} /> {author.email}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- NOW BOX -->
      <aside class="now">
        <div class="now-head">
          <span class="now-tag">{nowLabel}</span>
          <span class={`now-blip ${nowActive ? "" : "now-blip-shipped"}`} aria-hidden="true"></span>
        </div>
        {
          nowBuilding ? (
            <a href={`/projects/${nowBuilding.id}`} class="now-card" style={`--accent:${colorOf(nowBuilding.data.category)}`}>
              <div class="now-meta">
                <span class="now-num">№{pad(numberOf.get(nowBuilding.id)!)}</span>
                {nowBuilding.data.category && <span class="now-cat">{nowBuilding.data.category.toLowerCase()}</span>}
              </div>
              <h3 class="now-title">
                {nowBuilding.data.title}
                <ArrowUpRight size={14} class="now-arrow" />
              </h3>
              <p class="now-desc">{nowBuilding.data.description}</p>
              <p class="now-stack">
                {nowBuilding.data.techStack.slice(0, 4).join(" · ")}
                {nowBuilding.data.techStack.length > 4 && ` · +${nowBuilding.data.techStack.length - 4}`}
              </p>
            </a>
          ) : (
            <p class="now-empty">— between projects —</p>
          )
        }
        <p class="now-foot">
          mentoring · scaling&nbsp;backends · shipping&nbsp;tiny&nbsp;robots · <a href="/about">more&nbsp;→</a>
        </p>
      </aside>
    </section>

    <!-- ─────────── ABOUT THE AUTHOR ─────────── -->
    <section class="block about">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> about the author</h2>
        <a href="/about" class="block-more">full bio &amp; cv →</a>
      </header>

      <div class="about-grid">
        <div class="about-portrait">
          {author.avatar && <img src={author.avatar} alt={author.name} class="portrait-img" loading="lazy" />}
          <p class="portrait-cap">
            <span class="portrait-fig">fig.&nbsp;0</span>
            <span class="portrait-desc">portrait of the author</span>
          </p>
        </div>

        <div class="about-prose">
          <p class="about-p">
            I'm a senior software engineer with <strong>{totalYearsPro ?? "6+"} years</strong> of shipping production code — currently leading cross-functional
            teams at
            <strong>MAQ Software</strong>, mostly in the <strong>.NET</strong> and
            <strong>Azure</strong> world. I care about clean architecture, fast feedback loops, and dragging junior devs through the same mistakes I once
            made (with fewer scars this time).
          </p>
          <p class="about-p about-p-italic">
            Outside of work, I build small things that scratch a personal itch — a CLI to kill a daily portal click, a fintech bot living on a
            Raspberry Pi, an OCR overlay for macOS — and write down what broke so I don't relearn it next year.
          </p>

          <dl class="facts">
            {
              facts.map((f) => (
                <div class="fact">
                  <dt>{f.dt}</dt>
                  <dd>{f.dd}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      {
        inlineStack.length > 0 && (
          <p class="about-stack" aria-label="Tech I reach for">
            <span class="as-label">reaches&nbsp;for&nbsp;//</span>
            {inlineStack.map((s, i) => (
              <>
                {i > 0 && (
                  <span class="as-sep" aria-hidden="true">
                    {" "}
                    ·{" "}
                  </span>
                )}
                <span class="as-item">{s.toLowerCase()}</span>
              </>
            ))}
          </p>
        )
      }

      {
        experience.length > 0 && (
          <ul class="entries about-exp">
            {expEntries.slice(0, 2).map((e, i) => (
              <li class="entry exp-entry">
                <div class="entry-link static-entry">
                  <div class="e-gutter">
                    <span class="e-num">{pad(expEntries.slice(0, 2).length - i)}</span>
                    <span class="e-month">{e.startYear}</span>
                  </div>
                  <div class="e-body">
                    <div class="e-line e-line-1">
                      <h3 class="e-title">
                        {e.title}
                        <span class="exp-at">@&nbsp;{e.company}</span>
                      </h3>
                      <span class="e-status">
                        {e.isCurrent && <span class="blip blip-pulse" />}
                        {e.periodLower}
                      </span>
                    </div>
                    {e.description && <p class="e-desc">{e.description}</p>}
                  </div>
                </div>
              </li>
            ))}
            {expEntries.length > 2 && (
              <li class="entry exp-entry exp-more">
                <a class="entry-link" href="/about#experience">
                  <div class="e-gutter">
                    <span class="e-num">+{expEntries.length - 2}</span>
                  </div>
                  <div class="e-body">
                    <div class="e-line e-line-1">
                      <h3 class="e-title">
                        earlier roles &amp; the full progression
                        <span class="exp-at">@&nbsp;maq software</span>
                      </h3>
                      <span class="e-status">see full history &rarr;</span>
                    </div>
                  </div>
                </a>
              </li>
            )}
          </ul>
        )
      }
    </section>

    <!-- ─────────── FROM THE LOG ─────────── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> from the workshop log</h2>
        <a href="/projects" class="block-more">browse all {totalProjects} →</a>
      </header>
      <ul class="entries">
        {
          recentProjects.map((p) => {
            const num = numberOf.get(p.id)!;
            const accent = colorOf(p.data.category);
            const start = new Date(p.data.startDate);
            const ongoing = isOngoing(p);
            return (
              <li class="entry" style={`--accent:${accent}`}>
                <a class="entry-link" href={`/projects/${p.id}`}>
                  <div class="e-gutter">
                    <span class="e-num">№{pad(num)}</span>
                    <span class="e-month">
                      {monthShort(start)}&nbsp;{start.getFullYear()}
                    </span>
                  </div>
                  <div class="e-body">
                    <div class="e-line e-line-1">
                      <h3 class="e-title">
                        {p.data.title}
                        {p.data.featured && (
                          <span class="e-star" title="featured">
                            ★
                          </span>
                        )}
                      </h3>
                      <span class="e-status">
                        <span class={`blip ${ongoing ? "blip-pulse" : ""}`} />
                        {p.data.status === "in-progress"
                          ? "active"
                          : p.data.status === "completed"
                            ? "shipped"
                            : p.data.status === "on-hold"
                              ? "shelved"
                              : p.data.status}
                      </span>
                    </div>
                    <p class="e-desc">{p.data.description}</p>
                    <p class="e-stack">
                      {p.data.category && <span class="e-cat">{p.data.category.toLowerCase()}</span>}
                      <span>
                        {p.data.techStack.slice(0, 6).join(" · ")}
                        {p.data.techStack.length > 6 && ` · +${p.data.techStack.length - 6}`}
                      </span>
                    </p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- ─────────── MACHINE ROOM ─────────── -->
    <section class="block machine-room-preview" aria-labelledby="machine-room-heading">
      <header class="block-head">
        <h2 id="machine-room-heading">
          <a href="/lab" class="machine-head-link"><span class="bh-mark">§</span> from the machine room</a>
        </h2>
        <a href="/lab" class="block-more">enter the machine room →</a>
      </header>

      <div class="machine-teaser">
        {
          publicLabEntry?.liveUrl && (
            <div class="machine-teaser-item">
              <span class="machine-teaser-kicker">public build</span>
              <a class="machine-teaser-link" href={publicLabEntry.liveUrl} target="_blank" rel="noopener noreferrer">
                <span>{publicLabEntry.title}</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
              <span class="machine-teaser-meta">live demo · built here</span>
            </div>
          )
        }

        <div class="machine-teaser-item">
          <span class="machine-teaser-kicker">private systems</span>
          <span class="machine-teaser-name">{privateLabEntry?.title ?? "Personal Media Cloud"}</span>
          <span class="machine-teaser-meta">photos · streaming · trusted devices</span>
        </div>

        <div class="machine-teaser-item">
          <span class="machine-teaser-kicker">restricted ops</span>
          <span class="machine-teaser-name">automation + monitoring</span>
          <span class="machine-teaser-meta">{restrictedLabEntries.length} guarded layers · no public routes</span>
        </div>
      </div>
    </section>

    <!-- ─────────── WRITING ─────────── -->
    {
      recentPosts.length > 0 && (
        <section class="block">
          <header class="block-head">
            <h2>
              <span class="bh-mark">§</span> from the writing log
            </h2>
            <a href="/blog" class="block-more">
              all {totalPosts} posts →
            </a>
          </header>
          <ul class="entries">
            {recentPosts.map((post, i) => (
              <li class="entry">
                <a class="entry-link" href={`/blog/${post.id}`}>
                  <div class="e-gutter">
                    <span class="e-num">№{pad(i + 1)}</span>
                    <span class="e-month">
                      {monthShort(post.data.publishedAt)}&nbsp;{post.data.publishedAt.getFullYear()}
                    </span>
                  </div>
                  <div class="e-body">
                    <div class="e-line e-line-1">
                      <h3 class="e-title">{post.data.title}</h3>
                      <span class="e-status e-cat-only">{post.data.category.toLowerCase()}</span>
                    </div>
                    <p class="e-desc">{post.data.description}</p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <p class="e-stack">
                        <span>
                          {post.data.tags
                            .slice(0, 5)
                            .map((t) => `#${t.toLowerCase().replace(/\s+/g, "-")}`)
                            .join(" ")}
                        </span>
                      </p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ─────────── CURSED TEASER ─────────── -->
    <section class="block">
      <a href="/cursed-knowledge" class="cursed">
        <div class="cursed-bg" aria-hidden="true"></div>
        <div class="cursed-meta">
          <span class="cursed-tag">// pinned</span>
          <span class="cursed-blip" aria-hidden="true"></span>
        </div>
        <h2 class="cursed-title">
          things i wish i'd known
          <em> before </em>
          shipping them
        </h2>
        <p class="cursed-desc">
          {curseStats.total} cursed {curseStats.total === 1 ? "entry" : "entries"} from {curseYearRange} — auth gone wrong, SQLite at 1x speed, OCR backed
          by zero reasoning. Tagged by project, sortable by regret.
        </p>
        <span class="cursed-cta">open the grimoire →</span>
      </a>
    </section>

    <!-- ─────────── COLOPHON ─────────── -->
    <footer class="colophon">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <p>
        compiled by hand · set in inter &amp; merriweather · static-rendered with astro ·
        <a href="https://github.com/tapanmeena/portfolio" target="_blank" rel="noopener noreferrer">view source →</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .logbook-home {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 0.6rem;
    color: var(--color-text);
  }

  /* ─── Hairline rule ─── */
  .rule {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  /* ─── Dateline (top strip) ─── */
  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    padding: 0;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }
  .dl-spacer {
    flex: 1;
    min-width: 8px;
  }
  .dl-counts b {
    color: var(--color-text);
    font-weight: 700;
  }

  /* ─── Masthead ─── */
  .mast {
    margin-bottom: 1.6rem;
  }
  .mast-title {
    text-align: center;
    margin: 0.8rem 0;
    line-height: 1;
    font-family: "Merriweather", Georgia, serif;
  }
  .mast-pre {
    display: block;
    font-family: ui-monospace, monospace;
    font-style: normal;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .mast-main {
    display: inline-block;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 5.6vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.05;
  }
  .mast-by {
    text-align: center;
    margin: 0.4rem 0 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
    display: inline-flex;
    width: 100%;
    justify-content: center;
    gap: 6px;
    letter-spacing: 0.04em;
  }
  .mast-by-name {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* ─── Intro / Now grid ─── */
  .intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
    padding: 1.5rem 0 2rem;
  }
  @media (min-width: 820px) {
    .intro {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .lede {
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text);
    margin: 0 0 1.2rem;
    max-width: 600px;
  }
  .lede strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .quick-nav {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: ui-monospace, monospace;
    font-size: 0.92rem;
  }
  .quick-nav a {
    color: var(--color-text);
    text-decoration: none;
    padding: 2px 0;
    transition:
      color 0.15s ease,
      padding-left 0.15s ease;
    display: inline-block;
  }
  .quick-nav a:hover {
    color: var(--color-accent);
    padding-left: 4px;
  }

  .socials {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0.8rem 0 0;
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
  }
