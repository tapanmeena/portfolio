---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { authors } from "@data/authors";
import { getPublishedProjects } from "@utils/projects";
import { Github, Linkedin, Twitter, Mail, Rss } from "@lucide/astro";

const author = authors["tapan-meena"];

// Stats
const allProjects = await getCollection("projects");
const projects = getPublishedProjects(allProjects);
const inProgress = projects.filter((p) => p.data.status === "in-progress");
const completed = projects.filter((p) => p.data.status === "completed");
const allPosts = await getCollection("blog");
const posts = allPosts.filter((p) => !p.data.draft);

const pad = (n: number | string) => String(n).padStart(2, "0");

const stats = [
  { k: "shipped", v: pad(completed.length) },
  { k: "in-flight", v: pad(inProgress.length) },
  { k: "writeups", v: pad(posts.length) },
  { k: "yoe", v: "6+" },
];

// Personal facts
const facts = [
  { k: "based", dd: "hyderabad, india · ist (utc+5:30)" },
  { k: "writes in", dd: "typescript · c# · python · the occasional zsh one-liner" },
  { k: "lives in", dd: "vs code with vim bindings" },
  { k: "deploys to", dd: "a raspberry pi 5 in the next room" },
  { k: "drinks", dd: "filter coffee, no negotiations" },
  { k: "argues for", dd: "boring tech · small PRs · honest changelogs" },
];

// Beliefs (numbered like log entries)
const beliefs = [
  {
    title: "Boring tech, when it fits.",
    body: "I reach for SQLite before Postgres, Fastify before Nest, a cron job before a queue. The exotic choice has to earn its place.",
  },
  {
    title: "Small surface area > clever abstractions.",
    body: "A function that does one thing, named for what it does, beats a beautifully generic helper nobody else can read.",
  },
  {
    title: "Tests for the parts that touch the world.",
    body: "Pure logic deserves coverage. Code that touches networks, brokers, or filesystems demands it.",
  },
  {
    title: "Write the post-mortem in public.",
    body: "That's why /cursed-knowledge exists. Someone is going to make the same mistake — might as well be from my notes.",
  },
];

// Taste table
const taste = [
  { when: "backend http", reach: "fastify", skip: "nest", why: "schema-first, no decorators-as-religion" },
  { when: "database", reach: "sqlite (wal)", skip: "let's add postgres", why: "single file, zero ops, fast enough for 99% of side projects" },
  { when: "validation", reach: "zod", skip: "hand-rolled if/else walls", why: "one schema for config and api body" },
  { when: "styling", reach: "tailwind", skip: "styled-components", why: "stays close to markup, dies with markup" },
  { when: "state", reach: "url + server", skip: "redux, by default", why: "most state isn't state — it's a query param you forgot to write down" },
  { when: "deploy", reach: "docker on a pi", skip: "kubernetes", why: "yagni is a load-bearing principle here" },
  { when: "tests", reach: "vitest", skip: "jest + ts-jest", why: "esm-native, fast, no jest.config.cjs spelunking" },
  { when: "auth", reach: "boring sessions", skip: "jwt-everywhere", why: "cookies were fine; cookies are still fine" },
];

// Experience helpers (no regex literals in JSX)
const MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
function parsePeriodPart(s: string): { year: number; month: number } | null {
  const trimmed = s.trim().toLowerCase();
  if (/present|current/.test(trimmed)) {
    const now = new Date();
    return { year: now.getFullYear(), month: now.getMonth() };
  }
  const m = trimmed.match(/([a-z]{3,})\.?\s+(\d{4})/);
  if (!m) {
    const yOnly = trimmed.match(/(\d{4})/);
    return yOnly ? { year: parseInt(yOnly[1], 10), month: 0 } : null;
  }
  const monIdx = MONTHS.findIndex((mn) => m[1].startsWith(mn));
  return { year: parseInt(m[2], 10), month: monIdx >= 0 ? monIdx : 0 };
}
function monthsBetween(a: { year: number; month: number }, b: { year: number; month: number }) {
  return (b.year - a.year) * 12 + (b.month - a.month);
}
function durationLabel(months: number): string {
  if (months <= 0) return "";
  const yrs = Math.floor(months / 12);
  const mos = months % 12;
  const yPart = yrs > 0 ? `${yrs} yr${yrs === 1 ? "" : "s"}` : "";
  const mPart = mos > 0 ? `${mos} mo${mos === 1 ? "" : "s"}` : "";
  return [yPart, mPart].filter(Boolean).join(" ");
}

const experience = author.experience ?? [];
const expEntries = experience.map((e) => {
  const [startStr, endStr] = e.period.split(/\s*[–—-]\s*/);
  const start = parsePeriodPart(startStr ?? "");
  const end = parsePeriodPart(endStr ?? "present");
  const months = start && end ? monthsBetween(start, end) : 0;
  return {
    ...e,
    periodLower: e.period.toLowerCase(),
    startYear: start ? String(start.year) : "",
    start,
    end,
    months,
    duration: durationLabel(months),
    isCurrent: /present|current/i.test(e.period),
  };
});

// Group consecutive entries by company so role progressions sit under one header
interface CompanyGroup {
  company: string;
  totalMonths: number;
  spanLabel: string;
  totalDuration: string;
  isCurrent: boolean;
  roles: typeof expEntries;
}
const companyGroups: CompanyGroup[] = [];
for (const e of expEntries) {
  const last = companyGroups[companyGroups.length - 1];
  if (last && last.company === e.company) {
    last.roles.push(e);
  } else {
    companyGroups.push({
      company: e.company,
      totalMonths: 0,
      spanLabel: "",
      totalDuration: "",
      isCurrent: false,
      roles: [e],
    });
  }
}
for (const g of companyGroups) {
  const earliest = g.roles[g.roles.length - 1];
  const latest = g.roles[0];
  if (earliest.start && latest.end) {
    g.totalMonths = monthsBetween(earliest.start, latest.end);
    g.totalDuration = durationLabel(g.totalMonths);
  }
  const startBit = earliest.period.split(/\s*[–—-]\s*/)[0]?.trim() ?? "";
  const endBit = latest.period.split(/\s*[–—-]\s*/)[1]?.trim() ?? "";
  g.spanLabel = `${startBit} – ${endBit}`.toLowerCase();
  g.isCurrent = g.roles.some((r) => r.isCurrent);
}

// Inline tech strip
const pickedCats = ["Programming Languages", "Backend Development", "Cloud & DevOps", "Databases"];
const inlineStack = (author.skills ?? []).filter((g) => pickedCats.includes(g.name)).flatMap((g) => g.skills.slice(0, 5));

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();
---

<BaseLayout pageTitle="About — Tapan Meena">
  <div class="page">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;C&nbsp;//&nbsp;biography</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
    </p>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">the human in the loop</span>
        <span class="mast-main">{author.name}</span>
      </h1>
      <p class="mast-by">
        <span>{author.title?.toLowerCase()}</span>
        <span class="dl-sep">·</span>
        <span>{author.location?.toLowerCase()}</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <!-- ── PORTRAIT + BIO ── -->
    <section class="bio">
      <div class="bio-grid">
        <div class="portrait">
          <img src={author.avatar} alt={author.name} class="portrait-img" loading="lazy" />
          <p class="portrait-cap">
            <span class="portrait-fig">fig.&nbsp;0</span>
            <span class="portrait-desc">portrait of the author</span>
          </p>
        </div>

        <div class="bio-prose">
          <p class="bio-p">
            I'm an engineer who likes building the thing more than talking about building the thing. The day job is backend systems and developer
            tools at <strong>MAQ Software</strong>; the off-hours are CLIs, side bots, and writing about both.
          </p>
          <p class="bio-p">
            Lately I've been compiling everything I've learned about markets into <a href="/trading">the trading desk</a> — a three-tier curriculum from
            “what is a stock” to running a book.
          </p>
          <p class="bio-p bio-p-italic">If a project I built saved you ten minutes — that's the whole point.</p>

          <ul class="stats">
            {
              stats.map((s) => (
                <li class="stat">
                  <span class="stat-v">{s.v}</span>
                  <span class="stat-k">{s.k}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        inlineStack.length > 0 && (
          <p class="stack" aria-label="Tech I reach for">
            <span class="stack-label">reaches&nbsp;for&nbsp;//</span>
            {inlineStack.map((s, i) => (
              <>
                {i > 0 && (
                  <span class="stack-sep" aria-hidden="true">
                    {" "}
                    ·{" "}
                  </span>
                )}
                <span class="stack-item">{s.toLowerCase()}</span>
              </>
            ))}
          </p>
        )
      }
    </section>

    <!-- ── HOW I WORK / BELIEFS ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> a few opinions, not very strong</h2>
        <span class="block-meta">— how I work</span>
      </header>
      <ol class="entries">
        {
          beliefs.map((b, i) => (
            <li class="entry static">
              <div class="e-row">
                <div class="e-gutter">
                  <span class="e-num">{pad(i + 1)}</span>
                </div>
                <div class="e-body">
                  <h3 class="e-title">{b.title}</h3>
                  <p class="e-desc">{b.body}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── EXPERIENCE ── -->
    {
      companyGroups.length > 0 && (
        <section class="block" id="experience">
          <header class="block-head">
            <h2>
              <span class="bh-mark">§</span> where I've shipped from
            </h2>
            <span class="block-meta">— experience</span>
          </header>

          <ol class="orgs">
            {companyGroups.map((g) => (
              <li class="org">
                <header class="org-head">
                  <div class="org-title-line">
                    <h3 class="org-name">
                      {g.company}
                      {g.isCurrent && <span class="blip blip-pulse" aria-label="current" />}
                    </h3>
                    <span class="org-span">{g.spanLabel}</span>
                  </div>
                  {g.totalDuration && (
                    <p class="org-meta">
                      <span class="org-meta-tag">tenure&nbsp;//</span>
                      <span>{g.totalDuration}</span>
                      <span class="dl-sep">·</span>
                      <span>
                        {g.roles.length} role{g.roles.length === 1 ? "" : "s"}
                      </span>
                    </p>
                  )}
                </header>

                <ol class="roles">
                  {g.roles.map((r, idx) => (
                    <li class="role">
                      <div class="role-row">
                        <div class="role-gutter">
                          <span class="role-num">{pad(g.roles.length - idx)}</span>
                          {r.isCurrent && <span class="role-now">now</span>}
                        </div>
                        <div class="role-body">
                          <div class="role-line">
                            <h4 class="role-title">{r.title}</h4>
                            <span class="role-period">
                              {r.periodLower}
                              {r.duration && <span class="role-dur"> · {r.duration}</span>}
                            </span>
                          </div>
                          {(r.location || r.description) && (
                            <p class="role-desc">
                              {r.location && <span class="role-loc">{r.location.toLowerCase()} — </span>}
                              {r.description}
                            </p>
                          )}
                          {r.skills && r.skills.length > 0 && (
                            <p class="role-skills">
                              <span class="role-skills-tag">stack&nbsp;//</span>
                              {r.skills.map((s, i) => (
                                <>
                                  {i > 0 && (
                                    <span class="stack-sep" aria-hidden="true">
                                      {" "}
                                      ·{" "}
                                    </span>
                                  )}
                                  <span class="stack-item">{s.toLowerCase()}</span>
                                </>
                              ))}
                            </p>
                          )}
                        </div>
                      </div>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- ── TASTE ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> reach for &middot; reach past</h2>
        <span class="block-meta">— taste, defaults not dogma</span>
      </header>
      <table class="taste">
        <thead>
          <tr>
            <th>when</th>
            <th>reach for</th>
            <th>reach past</th>
            <th class="taste-why">why</th>
          </tr>
        </thead>
        <tbody>
          {
            taste.map((t) => (
              <tr>
                <td class="t-when">{t.when}</td>
                <td class="t-reach">
                  <span class="t-plus">+</span>
                  {t.reach}
                </td>
                <td class="t-skip">
                  <span class="t-minus">−</span>
                  {t.skip}
                </td>
                <td class="t-why">{t.why}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <!-- ── FAST FACTS ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> things I'm willing to admit</h2>
        <span class="block-meta">— personal data, declared</span>
      </header>
      <dl class="kv">
        {
          facts.map((f) => (
            <div class="kv-row">
              <dt>{f.k}</dt>
              <dd>{f.dd}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ── ELSEWHERE ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> elsewhere on the internet</h2>
        <a class="block-meta block-link" href="/contact">— or write to me &rarr;</a>
      </header>
      <ul class="elsewhere">
        {
          author.social?.github && (
            <li>
              <a href={author.social.github} target="_blank" rel="noopener noreferrer">
                <Github size={13} /> github&nbsp;<b>tapanmeena</b>
              </a>
            </li>
          )
        }
        {
          author.social?.linkedin && (
            <li>
              <a href={author.social.linkedin} target="_blank" rel="noopener noreferrer">
                <Linkedin size={13} /> linkedin&nbsp;<b>in/tapanmeena</b>
              </a>
            </li>
          )
        }
        {
          author.social?.twitter && (
            <li>
              <a href={author.social.twitter} target="_blank" rel="noopener noreferrer">
                <Twitter size={13} /> twitter&nbsp;<b>tapanmeena3</b>
              </a>
            </li>
          )
        }
        <li><a href="/rss.xml"><Rss size={13} /> rss&nbsp;<b>/rss.xml</b></a></li>
        {
          author.email && (
            <li>
              <a href={`mailto:${author.email}`}>
                <Mail size={13} /> email&nbsp;<b>{author.email}</b>
              </a>
            </li>
          )
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 5rem;
    color: var(--color-text);
  }

  /* ─── Shared atoms (rule, dateline, mast) ─── */
  .rule {
    display: flex;
    align-items: center;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }

  .mast {
    margin-bottom: 1.6rem;
  }
  .mast-title {
    text-align: center;
    margin: 0.8rem 0;
    line-height: 1;
    font-family: "Merriweather", Georgia, serif;
  }
  .mast-pre {
    display: block;
    font-family: ui-monospace, monospace;
    font-style: normal;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .mast-main {
    display: inline-block;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 5.6vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.05;
  }
  .mast-by {
    text-align: center;
    margin: 0.4rem 0 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  /* ─── Bio + portrait ─── */
  .bio {
    padding: 1rem 0 1.5rem;
  }
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2rem;
    align-items: start;
  }
  @media (min-width: 720px) {
    .bio-grid {
      grid-template-columns: 180px minmax(0, 1fr);
    }
  }

  .portrait {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .portrait-img {
    width: 100%;
    max-width: 180px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border: 1px solid var(--color-border);
    filter: grayscale(0.5) contrast(1.05);
    transition: filter 0.3s ease;
  }
  .portrait:hover .portrait-img {
    filter: grayscale(0) contrast(1);
  }
  .portrait-cap {
    display: flex;
    gap: 8px;
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    color: var(--color-muted);
  }
  .portrait-fig {
    color: var(--color-text);
    font-weight: 700;
  }
  .portrait-desc {
    font-style: italic;
  }

  .bio-prose {
    min-width: 0;
  }
  .bio-p {
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 0.9rem;
    max-width: 640px;
  }
  .bio-p strong {
    font-weight: 700;
  }
  .bio-p-italic {
    font-style: italic;
    color: var(--color-muted);
    font-size: 1rem;
  }

  .stats {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px dashed var(--color-border);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem 1.2rem;
    font-family: ui-monospace, monospace;
  }
  @media (min-width: 540px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .stat-v {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }
  .stat-k {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stack {
    margin: 1.4rem 0 0;
    padding: 0.9rem 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    font-family: ui-monospace, monospace;
    line-height: 1.9;
    overflow-wrap: break-word;
  }
  .stack-label {
    display: inline;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 6px;
  }
  .stack-sep {
    display: inline;
    color: var(--color-border);
    user-select: none;
  }
  .stack-item {
    display: inline;
    font-size: 0.82rem;
    color: var(--color-text);
  }

  /* ─── Block ─── */
  .block {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1rem;
  }
  .block-head h2 {
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-text);
  }
  .bh-mark {
    color: var(--color-accent);
    font-style: normal;
    font-weight: 400;
    opacity: 0.85;
    margin-right: 0.2em;
  }
  .block-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  .block-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .block-link:hover {
    color: var(--color-accent);
  }

  /* ─── Entries (shared with index) ─── */
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .entry {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }
  .entry:first-child {
    border-top: 0;
  }
  .e-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    padding: 0.9rem 0.4rem;
  }
  @media (min-width: 600px) {
    .e-row {
      grid-template-columns: 90px 1fr;
      gap: 22px;
    }
  }

