---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectUniqueCategory, normalizeCategory, categoryToUrl } from "@utils/category";

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter((post) => !post.data.draft);
const uniqueCategories = collectUniqueCategory(publishedPosts);

const categoriesWithCount = uniqueCategories
  .map((category) => {
    const count = publishedPosts.filter((post) => normalizeCategory(post.data.category) === normalizeCategory(category)).length;
    return {
      name: category,
      count,
      latest: publishedPosts
        .filter((p) => normalizeCategory(p.data.category) === normalizeCategory(category))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0],
    };
  })
  .sort((a, b) => b.count - a.count);

const pad = (n: number) => String(n).padStart(2, "0");
const total = publishedPosts.length;

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();
---

<BaseLayout pageTitle="Categories — Tapan Meena">
  <div class="page">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;B&nbsp;//&nbsp;categories</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
    </p>

    <nav class="bread" aria-label="Breadcrumb">
      <a href="/blog" class="bread-back">← back to the writing log</a>
    </nav>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">browse the writing log by</span>
        <span class="mast-main"><em>category</em></span>
      </h1>
      <p class="mast-by">
        <span>{categoriesWithCount.length}&nbsp;categories</span>
        <span class="dl-sep">·</span>
        <span>{total}&nbsp;total posts</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    {
      categoriesWithCount.length > 0 ? (
        <ol class="entries">
          {categoriesWithCount.map((c, i) => (
            <li class="entry">
              <a class="entry-link" href={categoryToUrl(c.name)}>
                <div class="e-gutter">
                  <span class="e-num">{pad(i + 1)}</span>
                  <span class="e-month">
                    {pad(c.count)}&nbsp;post{c.count === 1 ? "" : "s"}
                  </span>
                </div>
                <div class="e-body">
                  <h3 class="e-title">{c.name}</h3>
                  {c.latest && (
                    <p class="e-desc">
                      <span class="e-latest-tag">latest&nbsp;//</span>
                      {c.latest.data.title}
                    </p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty">
          <p>— no categories yet —</p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 5rem;
    color: var(--color-text);
  }

  .rule {
    display: flex;
    align-items: center;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }

  .bread {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
  }
  .bread-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-muted);
    text-decoration: none;
  }
  .bread-back:hover {
    color: var(--color-text);
  }

  .mast {
    margin-bottom: 1.4rem;
  }
  .mast-title {
    text-align: center;
    margin: 0.8rem 0;
    line-height: 1;
    font-family: "Merriweather", Georgia, serif;
  }
  .mast-pre {
    display: block;
    font-family: ui-monospace, monospace;
    font-style: normal;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .mast-main {
    display: inline-block;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 5.6vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.05;
  }
  .mast-by {
    text-align: center;
    margin: 0.4rem 0 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .entry {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }
  .entry:first-child {
    border-top: 0;
  }
  .entry-link {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 22px;
    padding: 0.95rem 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
    position: relative;
  }
  .entry-link::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .entry-link:hover {
    background: var(--color-surface);
  }
  .entry-link:hover::before {
    opacity: 1;
  }

  .e-gutter {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: ui-monospace, monospace;
    padding-top: 2px;
  }
  .e-num {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .e-month {
    font-size: 0.66rem;
    color: var(--color-muted);
    letter-spacing: 0.12em;
  }

  .e-body {
    min-width: 0;
  }
  .e-title {
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 4px;
    color: var(--color-text);
  }
  .entry-link:hover .e-title {
    color: var(--color-accent);
  }
  .e-desc {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.55;
  }
  .e-latest-tag {
    color: var(--color-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.6rem;
    font-weight: 700;
    margin-right: 6px;
  }

  .empty {
    padding: 3rem 1rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-style: italic;
    color: var(--color-muted);
  }
</style>
