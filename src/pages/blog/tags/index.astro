---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectUniqueTags, normalizeTag, tagToUrl } from "@utils/tags";

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter((p) => !p.data.draft);
const uniqueTags = collectUniqueTags(publishedPosts);

const tagsWithCount = uniqueTags
  .map((tag) => {
    const count = publishedPosts.filter((post) => post.data.tags.some((t) => normalizeTag(t) === normalizeTag(tag))).length;
    return { name: tag, slug: normalizeTag(tag), count };
  })
  .sort((a, b) => b.count - a.count);

const total = publishedPosts.length;
const maxCount = tagsWithCount.length ? tagsWithCount[0].count : 1;

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();
---

<BaseLayout pageTitle="Tags — Tapan Meena">
  <div class="page">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;B&nbsp;//&nbsp;tags</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
    </p>

    <nav class="bread" aria-label="Breadcrumb">
      <a href="/blog" class="bread-back">← back to the writing log</a>
    </nav>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">browse the writing log by</span>
        <span class="mast-main"><em>tag</em></span>
      </h1>
      <p class="mast-by">
        <span>{tagsWithCount.length}&nbsp;tags</span>
        <span class="dl-sep">·</span>
        <span>{total}&nbsp;total posts</span>
        <span class="dl-sep">·</span>
        <span>weight = post count</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    {
      tagsWithCount.length === 0 ? (
        <div class="empty">
          <p>— no tags yet —</p>
        </div>
      ) : (
        <p class="cloud" role="list">
          {tagsWithCount.map((t) => {
            const weight = 0.85 + (t.count / maxCount) * 0.85; // 0.85rem → 1.7rem
            return (
              <a role="listitem" href={tagToUrl(t.name)} class="cloud-tag" style={`font-size:${weight.toFixed(3)}rem;`} data-count={t.count}>
                <span class="cloud-hash">#</span>
                {normalizeTag(t.name)}
                <span class="cloud-num">·{t.count}</span>
              </a>
            );
          })}
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 5rem;
    color: var(--color-text);
  }

  .rule {
    display: flex;
    align-items: center;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }

  .bread {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
  }
  .bread-back {
    color: var(--color-muted);
    text-decoration: none;
  }
  .bread-back:hover {
    color: var(--color-text);
  }

  .mast {
    margin-bottom: 1.4rem;
  }
  .mast-title {
    text-align: center;
    margin: 0.8rem 0;
    line-height: 1;
    font-family: "Merriweather", Georgia, serif;
  }
  .mast-pre {
    display: block;
    font-family: ui-monospace, monospace;
    font-style: normal;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .mast-main {
    display: inline-block;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 5.6vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.05;
  }
  .mast-by {
    text-align: center;
    margin: 0.4rem 0 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  /* ─── Tag cloud — typographic, no pills ─── */
  .cloud {
    margin: 1.5rem 0 0;
    padding: 1.5rem 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    line-height: 2.1;
    font-family: ui-monospace, monospace;
    text-align: justify;
    overflow-wrap: break-word;
  }
  .cloud-tag {
    display: inline;
    color: var(--color-text);
    text-decoration: none;
    margin-right: 14px;
    transition: color 0.15s ease;
    vertical-align: baseline;
  }
  .cloud-tag:hover {
    color: var(--color-accent);
  }
  .cloud-hash {
    color: var(--color-muted);
    margin-right: 1px;
  }
  .cloud-tag:hover .cloud-hash {
    color: var(--color-accent);
  }
  .cloud-num {
    color: var(--color-muted);
    font-size: 0.65em;
    margin-left: 3px;
    vertical-align: super;
  }

  .empty {
    padding: 3rem 1rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-style: italic;
    color: var(--color-muted);
  }
</style>
