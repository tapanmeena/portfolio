---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectUniqueCategory, normalizeCategory, categoryToUrl } from "@utils/category";
import { collectUniqueTags, normalizeTag, tagToUrl } from "@utils/tags";

const allPosts = await getCollection("blog");
const posts = allPosts.filter((p) => !p.data.draft).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const totalPosts = posts.length;
const categories = collectUniqueCategory(posts);
const tags = collectUniqueTags(posts);

const categoriesWithCount = categories
  .map((cat) => ({
    name: cat,
    slug: normalizeCategory(cat),
    count: posts.filter((p) => normalizeCategory(p.data.category) === normalizeCategory(cat)).length,
  }))
  .sort((a, b) => b.count - a.count);

const numbered = [...posts].reverse();
const numberOf = new Map(numbered.map((p, i) => [p.id, i + 1]));
const pad = (n: number) => String(n).padStart(2, "0");

// Group by year for easy scanning
function fmtYear(d: Date) {
  return d.getFullYear();
}
const postsByYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = fmtYear(p.data.publishedAt);
  if (!postsByYear.has(y)) postsByYear.set(y, []);
  postsByYear.get(y)!.push(p);
}

const yearList = [...postsByYear.keys()];
const earliest = yearList.length ? Math.min(...yearList) : new Date().getFullYear();
const latest = yearList.length ? Math.max(...yearList) : new Date().getFullYear();

const monthShort = (d: Date) => d.toLocaleString("default", { month: "short" }).toUpperCase();

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();
---

<BaseLayout pageTitle="Writing — Tapan Meena">
  <div class="page">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;B&nbsp;//&nbsp;the&nbsp;writing&nbsp;log</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
      <span class="dl-spacer"></span>
      <span class="dl-counts">{earliest}–{latest}</span>
    </p>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">a slow column —</span>
        <span class="mast-main"><em>the&nbsp;writing&nbsp;log</em></span>
      </h1>
      <p class="mast-by">
        <span>{totalPosts}&nbsp;posts</span>
        <span class="dl-sep">·</span>
        <span>newest first</span>
        <span class="dl-sep">·</span>
        <a class="mast-link" href="/rss.xml">subscribe via rss</a>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <!-- ── BROWSE STRIP ── -->
    <section class="browse">
      <p class="browse-row">
        <span class="ctl-tag">browse&nbsp;by</span>
        <a class="browse-link" href="/blog/category">categories <b>({categoriesWithCount.length})</b></a>
        <span class="dl-sep">·</span>
        <a class="browse-link" href="/blog/tags">tags <b>({tags.length})</b></a>
      </p>
      {
        categoriesWithCount.length > 0 && (
          <p class="browse-cats">
            {categoriesWithCount.map((c, i) => (
              <>
                {i > 0 && (
                  <span class="dl-sep" aria-hidden="true">
                    {" "}
                    ·{" "}
                  </span>
                )}
                <a class="cat-chip" href={categoryToUrl(c.name)}>
                  {c.name.toLowerCase()}
                  <span class="cat-num">·{c.count}</span>
                </a>
              </>
            ))}
          </p>
        )
      }
    </section>

    <!-- ── ENTRIES ── -->
    {
      posts.length === 0 ? (
        <div class="empty">
          <p>— no posts yet. check back soon —</p>
        </div>
      ) : (
        [...postsByYear.entries()].map(([year, yearPosts]) => (
          <section class="yr">
            <header class="yr-meta">
              <span>{year}</span>
              <span class="dl-sep">·</span>
              <span>
                {yearPosts.length} post{yearPosts.length === 1 ? "" : "s"}
              </span>
            </header>
            <ol class="entries">
              {yearPosts.map((post) => {
                const num = numberOf.get(post.id)!;
                const d = post.data.publishedAt;
                return (
                  <li class="entry">
                    <a class="entry-link" href={`/blog/${post.id}`}>
                      <div class="e-gutter">
                        <span class="e-num">№{pad(num)}</span>
                        <span class="e-month">
                          {monthShort(d)}&nbsp;{String(d.getDate()).padStart(2, "0")}
                        </span>
                      </div>
                      <div class="e-body">
                        <div class="e-line">
                          <h3 class="e-title">{post.data.title}</h3>
                          <span class="e-status">{post.data.category.toLowerCase()}</span>
                        </div>
                        {post.data.description && <p class="e-desc">{post.data.description}</p>}
                        {post.data.tags && post.data.tags.length > 0 && (
                          <p class="e-tags">
                            {post.data.tags.slice(0, 6).map((t, ti) => (
                              <>
                                {ti > 0 && (
                                  <span class="e-tag-sep" aria-hidden="true">
                                    {" "}
                                    ·{" "}
                                  </span>
                                )}
                                <span class="e-tag">#{normalizeTag(t)}</span>
                              </>
                            ))}
                            {post.data.tags.length > 6 && <span class="e-tag-more">&nbsp;+{post.data.tags.length - 6}</span>}
                          </p>
                        )}
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 5rem;
    color: var(--color-text);
  }

  .rule {
    display: flex;
    align-items: center;
    margin: 0.4rem 0;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.85;
  }
  .rule-tick {
    width: 1px;
    height: 8px;
    background: var(--color-text);
    opacity: 0.85;
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .dl-issue {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dl-sep {
    opacity: 0.5;
  }
  .dl-spacer {
    flex: 1;
    min-width: 8px;
  }
  .dl-counts {
    font-family: ui-monospace, monospace;
    color: var(--color-text);
    font-weight: 700;
  }

  .mast {
    margin-bottom: 1.4rem;
  }
  .mast-title {
    text-align: center;
    margin: 0.8rem 0;
    line-height: 1;
    font-family: "Merriweather", Georgia, serif;
  }
  .mast-pre {
    display: block;
    font-family: ui-monospace, monospace;
    font-style: normal;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }
  .mast-main {
    display: inline-block;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 5.6vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.05;
  }
  .mast-main em {
    font-style: italic;
  }
  .mast-by {
    text-align: center;
    margin: 0.4rem 0 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .mast-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .mast-link:hover {
    color: var(--color-accent);
  }

  /* ─── Browse strip ─── */
  .browse {
    padding: 0.9rem 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    margin-bottom: 1.5rem;
    font-family: ui-monospace, monospace;
  }
  .browse-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    margin: 0;
    font-size: 0.78rem;
  }
  .ctl-tag {
    color: var(--color-muted);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.66rem;
    margin-right: 2px;
  }
  .ctl-tag::after {
    content: ":";
    margin-left: 2px;
  }
  .browse-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .browse-link:hover {
    color: var(--color-accent);
  }
  .browse-link b {
    color: var(--color-muted);
    font-weight: 500;
  }

  .browse-cats {
    margin: 0.7rem 0 0;
    line-height: 1.9;
    font-size: 0.78rem;
    color: var(--color-muted);
    overflow-wrap: break-word;
  }
  .cat-chip {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .cat-chip:hover {
    color: var(--color-accent);
  }
  .cat-num {
    color: var(--color-muted);
    margin-left: 2px;
    font-size: 0.92em;
  }

  /* ─── Year groups ─── */
  .yr {
    padding: 0 0 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .yr:last-of-type {
    border-bottom: 0;
  }
  .yr-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0.4rem 0 0.9rem;
    border-bottom: 1px dashed var(--color-border);
    margin-bottom: 0.7rem;
  }
  .yr-meta span:first-child {
    color: var(--color-text);
    font-weight: 700;
  }

  /* ─── Entries ─── */
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .entry {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }
  .entry:first-child {
    border-top: 0;
  }
  .entry-link {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    padding: 0.95rem 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
    position: relative;
  }
  @media (min-width: 600px) {
    .entry-link {
      grid-template-columns: 90px 1fr;
      gap: 22px;
    }
  }
  .entry-link::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .entry-link:hover {
    background: var(--color-surface);
  }
  .entry-link:hover::before {
    opacity: 1;
  }

  .e-gutter {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: ui-monospace, monospace;
    padding-top: 2px;
  }
  .e-num {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .e-month {
    font-size: 0.66rem;
    color: var(--color-muted);
    letter-spacing: 0.16em;
  }

  .e-body {
    min-width: 0;
  }
  .e-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .e-title {
    font-family: "Merriweather", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: var(--color-text);
    max-width: 720px;
  }
  .entry-link:hover .e-title {
    color: var(--color-accent);
  }
  .e-status {
    flex-shrink: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    color: var(--color-accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .e-desc {
    margin: 4px 0 8px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 720px;
  }
  .e-tags {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .e-tag-sep {
    color: var(--color-border);
    user-select: none;
  }
  .e-tag-more {
    color: var(--color-text);
  }

  .empty {
    padding: 3rem 1rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-style: italic;
    color: var(--color-muted);
  }
</style>
