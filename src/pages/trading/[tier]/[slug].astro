---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import { calculateReadTime } from "@utils/readTime";
import { TIER_META, getTier, tierUrl, chapterUrl, nextTier, parseId, pad, type Tier } from "@utils/trading";

export async function getStaticPaths() {
  const all = await getCollection("trading");
  return all
    .filter((entry) => entry.data.tier !== "special")
    .map((entry) => {
      const parsed = parseId(entry.id);
      return {
        params: { tier: parsed?.tier ?? entry.data.tier, slug: parsed?.slug ?? entry.id },
        props: { entry },
      };
    });
}

const { entry } = Astro.props as { entry: CollectionEntry<"trading"> };
const { Content, headings } = await render(entry);

const { title, description, tier, order } = entry.data;
const meta = TIER_META[tier as Tier];

const all = await getCollection("trading");
const tierChapters = getTier(all, tier as Tier);
const idx = tierChapters.findIndex((c) => c.id === entry.id);
const prev = idx > 0 ? tierChapters[idx - 1] : null;
const next = idx >= 0 && idx < tierChapters.length - 1 ? tierChapters[idx + 1] : null;
const isLastInTier = !next;
const nextT = nextTier(tier as Tier);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const readTime = calculateReadTime(entry.body ?? "");
const wordCount = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
---

<BaseLayout pageTitle={`${title} — ${meta.label} · the trading desk`}>
  <article class="chap" style={`--tier-color:${meta.color}`}>
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;02</span>
      <span class="dl-sep">·</span>
      <span>tier&nbsp;{meta.abbr}&nbsp;//&nbsp;ch.&nbsp;{pad(order)}&nbsp;of&nbsp;{pad(tierChapters.length)}</span>
      <span class="dl-sep">·</span>
      <span>{meta.label} course</span>
    </p>

    <nav class="bread" aria-label="Breadcrumb">
      <a href="/trading" class="bread-back"><ArrowLeft size={12} /> trading desk</a>
      <span class="bread-sep">/</span>
      <a href={tierUrl(tier as Tier)} class="bread-back">{meta.label}</a>
    </nav>

    <header class="head">
      <div class="rule" aria-hidden="true"><span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span></div>
      <div class="head-meta">
        <span class="signal" aria-hidden="true">{meta.signal}</span>
        <span class="hm-num">№{pad(order)}</span>
        <a class="hm-cat" href={tierUrl(tier as Tier)}>{meta.label}</a>
        <span class="hm-by">· chapter</span>
      </div>

      <h1 class="head-title">{title}</h1>
      {description && <p class="head-lede">{description}</p>}

      <dl class="head-facts">
        <div class="fact"><dt>read</dt><dd>~{readTime} min</dd></div>
        <div class="fact"><dt>length</dt><dd>{wordCount.toLocaleString()} words</dd></div>
        <div class="fact"><dt>position</dt><dd>{pad(order)} of {pad(tierChapters.length)}</dd></div>
      </dl>

      <div class="rule" aria-hidden="true"><span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span></div>
    </header>

    <div class="body">
      <aside class="margin">
        {
          toc.length > 0 && (
            <div class="m-block m-hide-mobile">
              <h2 class="m-head">contents</h2>
              <ol class="m-toc">
                {toc.map((h, i) => (
                  <li class={`m-toc-item m-toc-d${h.depth}`}>
                    <a href={`#${h.slug}`} data-toc={h.slug}>
                      <span class="m-toc-num">{pad(i + 1)}</span>
                      <span class="m-toc-text">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        <div class="m-block m-hide-mobile">
          <h2 class="m-head">tier</h2>
          <ol class="m-tier">
            {
              tierChapters.map((c) => (
                <li class:list={["m-tier-item", { active: c.id === entry.id }]}>
                  <a href={chapterUrl(c)}>
                    <span class="m-tier-num">{pad(c.data.order)}</span>
                    <span class="m-tier-text">{c.data.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="m-block">
          <h2 class="m-head">disclaimer</h2>
          <p class="m-about">
            educational content. not financial advice. <a href="/trading">course overview →</a>
          </p>
        </div>
      </aside>

      <section class="article">
        <div class="prose">
          <Content />
        </div>
        <div class="end-rule" aria-hidden="true">
          <span>—</span>
          <span class="end-mark">§</span>
          <span>—</span>
        </div>

        {
          isLastInTier && nextT && (
            <aside class="next-tier">
              <p class="nt-kicker">end of {meta.label} course</p>
              <h2 class="nt-title">ready for the {TIER_META[nextT].label} course?</h2>
              <p class="nt-blurb">{TIER_META[nextT].blurb}</p>
              <a class="nt-cta" href={tierUrl(nextT)} style={`--tier-color:${TIER_META[nextT].color}`}>
                start {TIER_META[nextT].label} <ArrowRight size={14} />
              </a>
            </aside>
          )
        }
      </section>
    </div>

    <nav class="pn" aria-label="Adjacent chapters">
      {
        prev ? (
          <a href={chapterUrl(prev)} class="pn-link pn-prev">
            <span class="pn-arrow">
              <ArrowLeft size={14} />
            </span>
            <span class="pn-meta">
              <span class="pn-label">← ch. {pad(prev.data.order)}</span>
              <span class="pn-title">{prev.data.title}</span>
            </span>
          </a>
        ) : (
          <span class="pn-edge">— first chapter —</span>
        )
      }
      {
        next ? (
          <a href={chapterUrl(next)} class="pn-link pn-next">
            <span class="pn-meta">
              <span class="pn-label">ch. {pad(next.data.order)} →</span>
              <span class="pn-title">{next.data.title}</span>
            </span>
            <span class="pn-arrow">
              <ArrowRight size={14} />
            </span>
          </a>
        ) : (
          <span class="pn-edge">— last in tier —</span>
        )
      }
    </nav>
  </article>

  <script is:inline>
    const tocLinks = Array.from(document.querySelectorAll("[data-toc]"));
    if (tocLinks.length) {
      const map = new Map();
      tocLinks.forEach((l) => {
        const id = l.getAttribute("data-toc");
        const h = id ? document.getElementById(id) : null;
        if (h) map.set(h, l);
      });
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const link = map.get(e.target);
            if (!link) return;
            if (e.isIntersecting) {
              tocLinks.forEach((l) => l.classList.remove("active"));
              link.classList.add("active");
            }
          });
        },
        { rootMargin: "-20% 0px -65% 0px", threshold: 0 },
      );
      map.forEach((_l, h) => io.observe(h));
    }
    tocLinks.forEach((l) => {
      l.addEventListener("click", (e) => {
        const id = l.getAttribute("data-toc");
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY - 88;
        window.scrollTo({ top, behavior: "smooth" });
        history.replaceState(null, "", "#" + id);
      });
    });
  </script>

  <style>
    @reference "tailwindcss";

    .chap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1.25rem 1.25rem 5rem;
      color: var(--color-text);
    }
    .rule {
      display: flex;
      align-items: center;
      margin: 0.4rem 0;
    }
    .rule-line {
      flex: 1;
      height: 1px;
      background: var(--color-text);
      opacity: 0.85;
    }
    .rule-tick {
      width: 1px;
      height: 8px;
      background: var(--color-text);
      opacity: 0.85;
    }

    .dateline {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 8px;
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      color: var(--color-muted);
      margin: 0 0 0.6rem;
      letter-spacing: 0.04em;
    }
    .dl-issue {
      color: var(--color-text);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .dl-sep {
      opacity: 0.5;
    }

    .bread {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
      font-family: ui-monospace, monospace;
      font-size: 0.72rem;
      color: var(--color-muted);
      margin-bottom: 1rem;
      letter-spacing: 0.04em;
    }
    .bread-back {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--color-muted);
      text-decoration: none;
    }
    .bread-back:hover {
      color: var(--color-text);
    }
    .bread-sep {
      opacity: 0.5;
    }

    .head-meta {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-family: ui-monospace, monospace;
      font-size: 0.74rem;
      color: var(--color-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0.6rem 0 0.5rem;
    }
    .signal {
      color: var(--tier-color);
      font-size: 0.85rem;
    }
    .hm-cat {
      color: var(--tier-color);
      font-weight: 700;
      text-decoration: none;
    }
    .head-title {
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(2rem, 5vw, 2.8rem);
      margin: 0 0 0.5rem;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .head-lede {
      font-size: 1rem;
      line-height: 1.55;
      max-width: 60ch;
      opacity: 0.85;
      margin: 0 0 1rem;
    }
    .head-facts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.4rem;
      margin: 0;
    }
    .fact {
      display: flex;
      gap: 0.4rem;
      font-size: 0.78rem;
      align-items: baseline;
    }
    .fact dt {
      font-family: ui-monospace, monospace;
      color: var(--color-muted);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .fact dd {
      margin: 0;
      opacity: 0.9;
    }

    .body {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 2.5rem;
      margin-top: 1.5rem;
      align-items: start;
    }
    @media (max-width: 900px) {
      .body {
        grid-template-columns: 1fr;
      }
      .margin {
        order: 2;
        border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
        padding-top: 1rem;
        position: static;
        max-height: none;
        overflow: visible;
      }
      .m-hide-mobile {
        display: none;
      }
    }

    .margin {
      font-size: 0.82rem;
      position: sticky;
      top: 88px;
      align-self: start;
      max-height: calc(100vh - 104px);
      overflow-y: auto;
      padding-right: 0.4rem;
      scrollbar-width: thin;
    }
    .margin .m-block {
      margin-bottom: 1.6rem;
    }
    .m-head {
      font-family: ui-monospace, monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin: 0 0 0.5rem;
    }
    .m-toc,
    .m-tier {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.25rem;
    }
    .m-toc-item a,
    .m-tier-item a {
      display: grid;
      grid-template-columns: 1.6rem 1fr;
      gap: 0.4rem;
      padding: 0.2rem 0;
      color: var(--color-muted);
      text-decoration: none;
      line-height: 1.35;
      transition: color 0.15s ease;
    }
    .m-toc-item a:hover,
    .m-tier-item a:hover,
    .m-toc-item a.active {
      color: var(--tier-color);
    }
    .m-tier-item.active a {
      color: var(--color-text);
      font-weight: 600;
    }
    .m-toc-num,
    .m-tier-num {
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      opacity: 0.7;
    }
    .m-toc-d3 {
      padding-left: 1.2rem;
      font-size: 0.78rem;
    }
    .m-about {
      line-height: 1.5;
      opacity: 0.8;
    }
    .m-about a {
      color: var(--tier-color);
      text-decoration: none;
    }

    .article {
      min-width: 0;
    }

    .end-rule {
      display: flex;
      gap: 0.8rem;
      align-items: center;
      justify-content: center;
      margin: 2.5rem 0 1.5rem;
      color: var(--color-muted);
      font-family: ui-monospace, monospace;
      font-size: 0.85rem;
    }
    .end-mark {
      font-size: 1.1rem;
    }

    .next-tier {
      margin-top: 1rem;
      padding: 1.2rem 1.2rem 1.4rem;
      border: 1px solid color-mix(in srgb, var(--tier-color) 30%, transparent);
      border-left: 3px solid var(--tier-color);
      background: color-mix(in srgb, var(--tier-color) 5%, transparent);
    }
    .nt-kicker {
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin: 0 0 0.4rem;
    }
    .nt-title {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.5rem;
      margin: 0 0 0.5rem;
    }
    .nt-blurb {
      font-size: 0.95rem;
      line-height: 1.5;
      opacity: 0.88;
      margin: 0 0 0.8rem;
    }
    .nt-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 0.9rem;
      border: 1px solid var(--tier-color);
      color: var(--tier-color);
      text-decoration: none;
      font-family: ui-monospace, monospace;
      font-size: 0.82rem;
      letter-spacing: 0.04em;
    }
    .nt-cta:hover {
      background: var(--tier-color);
      color: white;
    }

    .pn {
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    }
    .pn-link {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--color-text);
      text-decoration: none;
      max-width: 48%;
    }
    .pn-link:hover {
      color: var(--tier-color);
    }
    .pn-meta {
      display: grid;
      gap: 0.15rem;
    }
    .pn-label {
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      color: var(--color-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .pn-title {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1rem;
    }
    .pn-next {
      margin-left: auto;
      text-align: right;
    }
    .pn-next .pn-meta {
      justify-items: end;
    }
    .pn-edge {
      font-family: ui-monospace, monospace;
      font-size: 0.72rem;
      color: var(--color-muted);
      letter-spacing: 0.06em;
    }

    /* Prose: reuse blog styles by mirroring the essentials */
    .prose :global(h2) {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.6rem;
      margin: 2rem 0 0.8rem;
      letter-spacing: -0.01em;
      scroll-margin-top: 88px;
    }
    .prose :global(h3) {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.25rem;
      margin: 1.4rem 0 0.5rem;
      scroll-margin-top: 88px;
    }
    .prose :global(p) {
      line-height: 1.7;
      margin: 0.7rem 0;
      font-size: 1rem;
    }
    .prose :global(ul),
    .prose :global(ol) {
      line-height: 1.7;
      padding-left: 1.4rem;
      margin: 0.7rem 0;
    }
    .prose :global(li) {
      margin: 0.25rem 0;
    }
    .prose :global(a) {
      color: var(--tier-color);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose :global(a:hover) {
      text-decoration-thickness: 2px;
    }
    .prose :global(code) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.88em;
      background: color-mix(in srgb, var(--color-text) 8%, transparent);
      padding: 0.1em 0.35em;
      border-radius: 3px;
    }
    .prose :global(pre) {
      background: color-mix(in srgb, var(--color-text) 6%, transparent);
      padding: 0.8rem 1rem;
      border-radius: 4px;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.55;
    }
    .prose :global(pre code) {
      background: none;
      padding: 0;
    }
    .prose :global(blockquote) {
      border-left: 3px solid var(--tier-color);
      padding: 0.4rem 0 0.4rem 1rem;
      margin: 1rem 0;
      font-style: italic;
      opacity: 0.88;
      background: color-mix(in srgb, var(--tier-color) 4%, transparent);
    }
    /* Positive / negative scenario callouts (".pn-callout > .pn-good / .pn-bad") */
    .prose :global(.pn-callout) {
      display: grid;
      gap: 0;
      margin: 1.2rem 0;
      border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
      border-radius: 4px;
      overflow: hidden;
    }
    .prose :global(.pn-callout p) {
      margin: 0;
      padding: 0.7rem 0.9rem 0.7rem 0.85rem;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .prose :global(.pn-callout .pn-tag) {
      display: inline-block;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.18rem 0.45rem;
      border-radius: 2px;
      white-space: nowrap;
      margin-right: 0.55rem;
      vertical-align: 0.08em;
    }
    .prose :global(.pn-callout .pn-good) {
      background: color-mix(in srgb, #10b981 8%, transparent);
      border-left: 3px solid #10b981;
    }
    .prose :global(.pn-callout .pn-bad) {
      background: color-mix(in srgb, #ef4444 8%, transparent);
      border-left: 3px solid #ef4444;
      border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    }
    .prose :global(.pn-callout .pn-good .pn-tag) {
      background: #10b981;
      color: #fff;
    }
    .prose :global(.pn-callout .pn-bad .pn-tag) {
      background: #ef4444;
      color: #fff;
    }
    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.92rem;
    }
    .prose :global(th),
    .prose :global(td) {
      padding: 0.5rem 0.6rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
      text-align: left;
      vertical-align: top;
    }
    .prose :global(th) {
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .prose :global(hr) {
      border: none;
      border-top: 1px dashed color-mix(in srgb, var(--color-text) 25%, transparent);
      margin: 2rem 0;
    }
    .prose :global(strong) {
      font-weight: 700;
    }
    .prose :global(p:has(> img:only-child)) {
      margin: 1.4rem 0 0.4rem;
      text-align: center;
    }
    .prose :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 0 auto;
      border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
      background: color-mix(in srgb, var(--color-text) 3%, transparent);
      border-radius: 4px;
    }
    .prose :global(p:has(> img:only-child) + p > em:only-child) {
      display: block;
      text-align: center;
      font-size: 0.82rem;
      color: var(--color-muted);
      margin-top: -0.4rem;
    }
  </style>
</BaseLayout>
