---
import BaseLayout from "@layouts/BaseLayout.astro";
import { authors } from "@data/authors";
import { Mail, Github, Linkedin, Twitter, Globe, Rss, Copy, CheckCircle2, Send } from "@lucide/astro";

const author = authors["tapan-meena"];

// ── Channels ─────────────────────────────────────────────────────────
type Channel = {
  key: string;
  label: string;
  handle: string;
  href: string;
  icon: any;
  bestFor: string;
  primary?: boolean;
  external?: boolean;
};
const channels: Channel[] = [
  {
    key: "email",
    label: "email",
    handle: author.email ?? "",
    href: author.email ? `mailto:${author.email}` : "#",
    icon: Mail,
    bestFor: "consulting · long-form questions · anything serious",
    primary: true,
  },
  {
    key: "github",
    label: "github",
    handle: "tapanmeena",
    href: author.social?.github ?? "#",
    icon: Github,
    bestFor: "code · bug reports · pull requests",
    external: true,
  },
  {
    key: "linkedin",
    label: "linkedin",
    handle: "in/tapanmeena",
    href: author.social?.linkedin ?? "#",
    icon: Linkedin,
    bestFor: "introductions · roles · professional context",
    external: true,
  },
  {
    key: "twitter",
    label: "twitter",
    handle: "tapanmeena3",
    href: author.social?.twitter ?? "#",
    icon: Twitter,
    bestFor: "fast hellos · public conversation",
    external: true,
  },
  {
    key: "rss",
    label: "rss",
    handle: "/rss.xml",
    href: "/rss.xml",
    icon: Rss,
    bestFor: "follow new writeups in your feed reader",
  },
];

const pad = (n: number | string) => String(n).padStart(2, "0");

// ── Compose template ─────────────────────────────────────────────────
const defaultSubject = "Hi Tapan — let's talk";
const defaultBody = `Hi Tapan,

A bit about me / the project:

What I'm hoping to discuss:

When works for you in the next two weeks?

— `;
const mailto = author.email ? `mailto:${author.email}?subject=${encodeURIComponent(defaultSubject)}&body=${encodeURIComponent(defaultBody)}` : "#";
const copyTemplate = `To: ${author.email}\nSubject: ${defaultSubject}\n\n${defaultBody}`;

// ── Topics ───────────────────────────────────────────────────────────
const topics = [
  { kind: "consulting", text: "backend architecture, broker / api integrations, developer tooling." },
  { kind: "open source", text: "any project you see in /projects — issues and pull requests welcome." },
  { kind: "mentoring", text: "career advice for early-career engineers — happy to chat." },
  { kind: "just hello", text: "if something I wrote helped you, I'd genuinely love to hear about it." },
];

const today = new Date();
const datelineDay = today.toLocaleDateString("en-US", { weekday: "long" }).toLowerCase();
const datelineDate = today.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toLowerCase();
---

<BaseLayout pageTitle="Contact — Tapan Meena">
  <div class="page">
    <p class="dateline">
      <span class="dl-issue">vol.&nbsp;01</span>
      <span class="dl-sep">·</span>
      <span>section&nbsp;D&nbsp;//&nbsp;correspondence</span>
      <span class="dl-sep">·</span>
      <span>{datelineDay}, {datelineDate}</span>
    </p>

    <header class="mast">
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
      <h1 class="mast-title">
        <span class="mast-pre">to the editor</span>
        <span class="mast-main"><em>say&nbsp;hi.</em></span>
      </h1>
      <p class="mast-by">
        <span>I read everything that lands in my inbox.</span>
        <span class="dl-sep">·</span>
        <span>I reply to most of it.</span>
      </p>
      <div class="rule" aria-hidden="true">
        <span class="rule-tick"></span><span class="rule-line"></span><span class="rule-tick"></span>
      </div>
    </header>

    <!-- ── AVAILABILITY STRIP ── -->
    <ul class="avail" aria-label="Availability">
      <li class="av">
        <span class="av-blip" aria-hidden="true"></span>
        <span class="av-k">status</span>
        <span class="av-v">open to interesting work</span>
      </li>
      <li class="av">
        <span class="av-k">replies</span>
        <span class="av-v">~24h on weekdays</span>
      </li>
      <li class="av">
        <span class="av-k">timezone</span>
        <span class="av-v">{author.location?.toLowerCase()} · ist (utc+5:30)</span>
      </li>
    </ul>

    <!-- ── CHANNELS ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> pick a channel</h2>
        <span class="block-meta">— ordered by how I prefer to be reached</span>
      </header>

      <ul class="entries channels">
        {
          channels
            .filter((c) => c.handle)
            .map((c, i) => (
              <li class={`entry ch ${c.primary ? "ch-primary" : ""}`}>
                <a class="entry-link" href={c.href} target={c.external ? "_blank" : undefined} rel={c.external ? "noopener noreferrer" : undefined}>
                  <div class="e-gutter">
                    <span class="e-num">{pad(i + 1)}</span>
                    <span class="e-month">
                      <c.icon size={11} />
                    </span>
                  </div>
                  <div class="e-body">
                    <div class="e-line">
                      <h3 class="e-title">
                        {c.label}
                        <span class="ch-handle">{c.handle}</span>
                        {c.primary && <span class="ch-pin">// preferred</span>}
                      </h3>
                      <span class="ch-arrow" aria-hidden="true">
                        →
                      </span>
                    </div>
                    <p class="e-desc">{c.bestFor}</p>
                  </div>
                </a>
                {c.primary && c.handle && (
                  <button type="button" class="copy-btn" data-copy={c.handle} aria-label={`Copy ${c.label}`} title="Copy email">
                    <Copy size={11} class="copy-icon" />
                    <CheckCircle2 size={11} class="copy-check" />
                    <span class="copy-text">copy</span>
                  </button>
                )}
              </li>
            ))
        }
      </ul>
    </section>

    <!-- ── WHAT TO WRITE ABOUT ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> what I'm interested in</h2>
        <span class="block-meta">— write to me about</span>
      </header>
      <dl class="kv">
        {
          topics.map((t) => (
            <div class="kv-row">
              <dt>{t.kind}</dt>
              <dd>{t.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ── COMPOSE TEMPLATE ── -->
    <section class="block">
      <header class="block-head">
        <h2><span class="bh-mark">§</span> a starting point</h2>
        <span class="block-meta">— optional template</span>
      </header>

      <article class="letter">
        <header class="letter-head">
          <p><span class="lh-k">From:</span> <span class="lh-v">you@somewhere.com</span></p>
          <p><span class="lh-k">To:</span> <span class="lh-v">{author.email}</span></p>
          <p><span class="lh-k">Subject:</span> <span class="lh-v">{defaultSubject}</span></p>
        </header>
        <pre class="letter-body">{defaultBody}<span class="letter-sig">{author.name?.split(" ")[0] ?? "you"}</span></pre>

        <div class="letter-actions">
          <a href={mailto} class="act act-primary">
            <Send size={13} />
            <span>open in mail client</span>
          </a>
          <button type="button" class="act copy-btn" data-copy={copyTemplate} id="copy-template">
            <Copy size={11} class="copy-icon" />
            <CheckCircle2 size={11} class="copy-check" />
            <span class="copy-text">copy template</span>
          </button>
        </div>

        <p class="letter-hint">
          <span class="hint-mark">tip&nbsp;//</span>
          include one sentence about what you're working on. it almost always gets a faster reply.
        </p>
      </article>
    </section>

    <!-- ── SIGN-OFF ── -->
    <section class="signoff">
      <p class="so-line"><em>— talk soon,</em></p>
      <p class="so-name">{author.name}</p>
    </section>
  </div>

  <script is:inline>
    const COPY_RESET_MS = 1600;
    document.querySelectorAll("[data-copy]").forEach((btn) => {
      const label = btn.querySelector(".copy-text");
      const defaultLabel = label?.textContent ?? "copy";
      let resetTimer;

      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        const text = btn.getAttribute("data-copy");
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
        }
        btn.classList.add("is-copied");
        if (label) label.textContent = "copied";
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          btn.classList.remove("is-copied");
          if (label) label.textContent = defaultLabel;
        }, COPY_RESET_MS);
      });
    });
  </script>

  <style>
    @reference "tailwindcss";

    .page {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1.25rem 1.25rem 2rem;
      color: var(--color-text);
    }

    .rule {
      display: flex;
      align-items: center;
      margin: 0.4rem 0;
    }
    .rule-line {
      flex: 1;
      height: 1px;
      background: var(--color-text);
      opacity: 0.85;
    }
    .rule-tick {
      width: 1px;
      height: 8px;
      background: var(--color-text);
      opacity: 0.85;
    }

    .dateline {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 8px;
      margin: 0 0 0.6rem;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.7rem;
      color: var(--color-muted);
      letter-spacing: 0.04em;
    }
    .dl-issue {
      color: var(--color-text);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .dl-sep {
      opacity: 0.5;
    }

    .mast {
      margin-bottom: 1.6rem;
    }
    .mast-title {
      text-align: center;
      margin: 0.8rem 0;
      line-height: 1;
      font-family: "Merriweather", Georgia, serif;
    }
    .mast-pre {
      display: block;
      font-family: ui-monospace, monospace;
      font-style: normal;
      font-weight: 400;
      font-size: 0.72rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 0.7rem;
    }
    .mast-main {
      display: inline-block;
      font-weight: 700;
      font-style: italic;
      font-size: clamp(2.4rem, 6.4vw, 4rem);
      letter-spacing: -0.02em;
      color: var(--color-text);
      line-height: 1.05;
    }
    .mast-by {
      text-align: center;
      margin: 0.4rem 0 0.5rem;
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--color-muted);
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }

    /* ─── Availability strip ─── */
    .avail {
      list-style: none;
      margin: 0 0 0.6rem;
      padding: 0.8rem 0;
      border-top: 1px dashed var(--color-border);
      border-bottom: 1px dashed var(--color-border);
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px 16px;
      font-family: ui-monospace, monospace;
    }
    @media (min-width: 720px) {
      .avail {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .av {
      display: flex;
      align-items: baseline;
      gap: 6px;
      flex-wrap: wrap;
    }
    .av-blip {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #16a34a;
      display: inline-block;
      animation: blip 1.8s infinite;
      align-self: center;
    }
    @keyframes blip {
      0% {
        box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
      }
      70% {
        box-shadow: 0 0 0 6px rgba(22, 163, 74, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(22, 163, 74, 0);
      }
    }
    .av-k {
      font-size: 0.62rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-muted);
      font-weight: 600;
    }
    .av-k::after {
      content: ":";
      opacity: 0.5;
      margin-left: 1px;
    }
    .av-v {
      font-size: 0.82rem;
      color: var(--color-text);
    }

    /* ─── Block ─── */
    .block {
      margin: 2.5rem 0 0;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }
    .block-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 1rem;
    }
    .block-head h2 {
      font-family: "Merriweather", Georgia, serif;
      font-style: italic;
      font-weight: 700;
      font-size: 1.5rem;
      margin: 0;
      color: var(--color-text);
    }
    .bh-mark {
      color: var(--color-accent);
      font-style: normal;
      font-weight: 400;
      opacity: 0.85;
      margin-right: 0.2em;
    }
    .block-meta {
      font-family: ui-monospace, monospace;
      font-size: 0.74rem;
      color: var(--color-muted);
      letter-spacing: 0.06em;
    }

    /* ─── Entries (shared with index/projects) ─── */
    .entries {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }
    .entry {
      border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
      position: relative;
    }
    .entry:first-child {
      border-top: 0;
    }
    .entry-link {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 14px;
      padding: 0.95rem 0.4rem;
      text-decoration: none;
      color: inherit;
      transition: background 0.18s ease;
      position: relative;
    }
    @media (min-width: 600px) {
      .entry-link {
        grid-template-columns: 90px 1fr;
        gap: 22px;
      }
    }
    .entry-link::before {
      content: "";
      position: absolute;
      left: -8px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--color-accent);
      opacity: 0;
      transition: opacity 0.18s ease;
    }
    .entry-link:hover {
      background: var(--color-surface);
    }
    .entry-link:hover::before {
      opacity: 1;
    }

    .e-gutter {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-family: ui-monospace, monospace;
      padding-top: 4px;
      align-items: flex-start;
    }
    .e-num {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text);
    }
    .e-month {
      font-size: 0.66rem;
      color: var(--color-muted);
      display: inline-flex;
      align-items: center;
    }

    .e-body {
      min-width: 0;
    }
    .e-line {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 4px;
    }
    .e-title {
      font-family: "Merriweather", Georgia, serif;
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1.3;
      margin: 0;
      color: var(--color-text);
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }
    .entry-link:hover .e-title {
      color: var(--color-accent);
    }
    .ch-handle {
      font-family: ui-monospace, monospace;
      font-style: normal;
      font-weight: 500;
      font-size: 0.82rem;
      color: var(--color-muted);
    }
    .entry-link:hover .ch-handle {
      color: var(--color-text);
    }
    .ch-pin {
      font-family: ui-monospace, monospace;
      font-style: normal;
      font-weight: 600;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-accent);
    }
    .ch-arrow {
      font-family: ui-monospace, monospace;
      color: var(--color-muted);
      flex-shrink: 0;
      transition:
        transform 0.18s ease,
        color 0.18s ease;
    }
    .entry-link:hover .ch-arrow {
      color: var(--color-accent);
      transform: translateX(3px);
    }
    .e-desc {
      margin: 0;
      font-size: 0.88rem;
      line-height: 1.55;
      color: var(--color-muted);
    }

    .copy-btn {
      position: absolute;
      top: 50%;
      right: 6px;
      transform: translateY(-50%);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
      color: var(--color-muted);
      font-family: ui-monospace, monospace;
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      cursor: pointer;
      border-radius: 3px;
      transition:
        color 0.15s ease,
        border-color 0.15s ease;
    }
    .copy-btn:hover {
      color: var(--color-text);
      border-color: var(--color-text);
    }
    .copy-btn .copy-check {
      display: none;
      color: #10b981;
    }
    .copy-btn.is-copied .copy-icon {
      display: none;
    }
    .copy-btn.is-copied .copy-check {
      display: inline-flex;
    }
    .copy-btn.is-copied .copy-text {
      color: #10b981;
    }
    .copy-btn.is-copied {
      color: #10b981;
      border-color: #10b981;
    }
    .copy-btn.is-copied .copy-text {
      display: inline-flex;
    }
    .copy-text {
      display: inline-flex;
    }

    /* ─── KV (topics list) ─── */
    .kv {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      font-family: ui-monospace, monospace;
    }
    .kv-row {
      display: grid;
      grid-template-columns: 130px 1fr;
      gap: 16px;
      padding: 0.7rem 0.2rem;
      border-bottom: 1px dashed var(--color-border);
      align-items: baseline;
    }
    .kv-row:last-child {
      border-bottom: 0;
    }
    .kv dt {
      margin: 0;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
      font-weight: 600;
    }
    .kv dd {
      margin: 0;
      font-size: 0.88rem;
      color: var(--color-text);
      line-height: 1.55;
    }

    /* ─── Letter (compose) ─── */
    .letter {
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      padding: 1.25rem 1.4rem;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .letter-head {
      padding-bottom: 0.7rem;
      margin-bottom: 0.9rem;
      border-bottom: 1px dashed var(--color-border);
    }
    .letter-head p {
      margin: 0;
      padding: 2px 0;
      font-size: 0.82rem;
      color: var(--color-text);
    }
    .lh-k {
      color: var(--color-muted);
      margin-right: 6px;
    }
    .lh-v {
      color: var(--color-text);
    }
    .letter-body {
      margin: 0 0 1rem;
      padding: 0;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.88rem;
      line-height: 1.7;
      color: var(--color-text);
      white-space: pre-wrap;
      word-wrap: break-word;
      background: transparent;
      border: 0;
    }
    .letter-sig {
      display: inline;
      font-family: "Merriweather", Georgia, serif;
      font-style: italic;
      color: var(--color-text);
    }
    .letter-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      padding-top: 0.6rem;
      border-top: 1px dashed var(--color-border);
    }
    .act {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 10px;
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--color-text);
      text-decoration: none;
      border: 1px solid var(--color-border);
      background: transparent;
      cursor: pointer;
      border-radius: 3px;
      transition:
        color 0.15s ease,
        border-color 0.15s ease,
        background 0.15s ease;
    }
    .act:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }
    .act-primary {
      color: var(--color-bg);
      background: var(--color-text);
      border-color: var(--color-text);
    }
    .act-primary:hover {
      background: var(--color-accent);
      color: var(--color-bg);
      border-color: var(--color-accent);
    }
    .letter-actions .copy-btn {
      position: static;
      transform: none;
    }
    .letter-hint {
      margin: 0.9rem 0 0;
      font-family: ui-monospace, monospace;
      font-size: 0.74rem;
      color: var(--color-muted);
      line-height: 1.6;
    }
    .hint-mark {
      color: var(--color-accent);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: 0.62rem;
      font-weight: 700;
      margin-right: 4px;
    }

    /* ─── Sign-off ─── */
    .signoff {
      margin-top: 3rem;
      text-align: center;
      padding: 2rem 0 0;
      border-top: 1px solid var(--color-border);
    }
    .so-line {
      margin: 0 0 0.4rem;
      font-family: "Merriweather", Georgia, serif;
      font-size: 1.4rem;
      font-style: italic;
      color: var(--color-text);
    }
    .so-name {
      margin: 0;
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--color-muted);
      letter-spacing: 0.06em;
    }

    @media (prefers-reduced-motion: reduce) {
      .av-blip {
        animation: none !important;
      }
    }
  </style>
</BaseLayout>
