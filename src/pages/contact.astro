---
import BaseLayout from "@layouts/BaseLayout.astro";
import { authors } from "@data/authors";
import {
  Mail,
  Github,
  Linkedin,
  Twitter,
  Globe,
  MapPin,
  Clock,
  Copy,
  CheckCircle2,
  Send,
  Briefcase,
  Code2,
  MessagesSquare,
  Coffee,
} from "@lucide/astro";

const author = authors["tapan-meena"];

// Channels — ordered by how I prefer to be reached.
const channels = [
  {
    key: "email",
    label: "email",
    handle: author.email ?? "",
    href: author.email ? `mailto:${author.email}` : "#",
    icon: Mail,
    bestFor: "consulting · long-form questions · anything serious",
    copyable: true,
    primary: true,
  },
  {
    key: "github",
    label: "github",
    handle: "@tapanmeena",
    href: author.social?.github ?? "#",
    icon: Github,
    bestFor: "code · bug reports · pull requests",
    copyable: false,
    primary: false,
  },
  {
    key: "linkedin",
    label: "linkedin",
    handle: "in/tapanmeena",
    href: author.social?.linkedin ?? "#",
    icon: Linkedin,
    bestFor: "introductions · roles · professional context",
    copyable: false,
    primary: false,
  },
  {
    key: "twitter",
    label: "twitter",
    handle: "@tapanmeena3",
    href: author.social?.twitter ?? "#",
    icon: Twitter,
    bestFor: "fast hellos · public conversation",
    copyable: false,
    primary: false,
  },
  {
    key: "website",
    label: "website",
    handle: "tapanmeena.com",
    href: author.social?.website ?? "/",
    icon: Globe,
    bestFor: "you're already here.",
    copyable: false,
    primary: false,
  },
].filter((c) => c.handle);

// Default email payload used by the "compose" helper.
const defaultSubject = "Hi Tapan — let's talk";
const defaultBody = `Hi Tapan,

A bit about me / the project:

What I'm hoping to discuss:

When works for you in the next two weeks?

— `;

const mailto =
  author.email
    ? `mailto:${author.email}?subject=${encodeURIComponent(defaultSubject)}&body=${encodeURIComponent(defaultBody)}`
    : "#";

// "Best to write me about" rows.
const writeAbout = [
  { icon: Briefcase, kind: "Consulting", text: "Backend architecture, broker / API integrations, developer tooling." },
  { icon: Code2, kind: "Code", text: "Open source collaboration on any project you see in /projects." },
  { icon: MessagesSquare, kind: "Mentoring", text: "Career advice for early-career engineers — happy to chat." },
  { icon: Coffee, kind: "Just hello", text: "If something I wrote helped you, I'd genuinely love to hear about it." },
];
---

<BaseLayout pageTitle="Contact">
  <div class="contact">
    <!-- HERO -->
    <section class="hero">
      <p class="prompt">
        <span class="prompt__user">tm@blog</span><span class="prompt__sep">:</span><span class="prompt__path">~/contact</span><span class="prompt__dollar">$</span>
        <span class="prompt__cmd">cat contact.md</span>
      </p>
      <h1 class="hero__title">
        Say <span class="hero__mark">hi</span>.
      </h1>
      <p class="hero__lede">
        I read everything that lands in my inbox. I reply to most of it. The fastest way in is
        {" "}<a href={`mailto:${author.email}`} class="hero__email">{author.email}</a>;
        the slowest is <span class="hero__strike">a calendar invite without context</span>.
      </p>

      <!-- Status row -->
      <ul class="status" aria-label="Availability">
        <li class="status__item">
          <span class="status__dot status__dot--green"></span>
          <span class="status__k">status</span>
          <span class="status__v">open to interesting work</span>
        </li>
        <li class="status__item">
          <Clock size={12} />
          <span class="status__k">replies</span>
          <span class="status__v">~24h on weekdays</span>
        </li>
        <li class="status__item">
          <MapPin size={12} />
          <span class="status__k">timezone</span>
          <span class="status__v">{author.location} · IST (UTC+5:30)</span>
        </li>
      </ul>
    </section>

    <!-- CHANNELS -->
    <section class="block">
      <header class="block__header">
        <div>
          <p class="kicker">§ Channels</p>
          <h2 class="block__title">Pick the one that fits</h2>
        </div>
      </header>

      <ul class="channels">
        {
          channels.map((c) => (
            <li class:list={["channel", { "channel--primary": c.primary }]}>
              <a
                href={c.href}
                class="channel__main"
                target={c.href.startsWith("http") ? "_blank" : undefined}
                rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                aria-label={`Contact via ${c.label}`}
              >
                <span class="channel__icon">
                  <c.icon size={16} />
                </span>
                <span class="channel__label">{c.label}</span>
                <span class="channel__handle">{c.handle}</span>
                <span class="channel__best">{c.bestFor}</span>
                <span class="channel__arrow" aria-hidden="true">→</span>
              </a>
              {c.copyable && c.handle && (
                <button
                  type="button"
                  class="channel__copy"
                  data-copy={c.handle}
                  aria-label={`Copy ${c.label}`}
                  title="Copy"
                >
                  <Copy size={14} class="channel__copy-icon" />
                  <CheckCircle2 size={14} class="channel__copy-check" />
                </button>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- WHAT TO WRITE ABOUT -->
    <section class="block">
      <header class="block__header">
        <div>
          <p class="kicker">§ Write to me about</p>
          <h2 class="block__title">What I'm interested in</h2>
        </div>
      </header>

      <ul class="topics">
        {
          writeAbout.map((t) => (
            <li class="topic">
              <span class="topic__icon">
                <t.icon size={16} />
              </span>
              <div>
                <p class="topic__kind">{t.kind}</p>
                <p class="topic__text">{t.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- COMPOSE -->
    <section class="block compose-block">
      <header class="block__header">
        <div>
          <p class="kicker">§ Compose</p>
          <h2 class="block__title">A starting point</h2>
        </div>
      </header>

      <div class="compose">
        <div class="compose__chrome" aria-hidden="true">
          <span class="compose__dot"></span>
          <span class="compose__dot"></span>
          <span class="compose__dot"></span>
          <span class="compose__file">draft.eml</span>
        </div>

        <div class="compose__head">
          <p><span class="compose__k">From:</span> <span class="compose__v">you@somewhere.com</span></p>
          <p><span class="compose__k">To:</span> <span class="compose__v">{author.email}</span></p>
          <p><span class="compose__k">Subject:</span> <span class="compose__v">{defaultSubject}</span></p>
        </div>

        <pre class="compose__body">{defaultBody}{author.name?.split(" ")[0] ?? "you"}</pre>

        <div class="compose__actions">
          <a href={mailto} class="btn btn--primary">
            <Send size={14} />
            Open in mail client
          </a>
          <button
            type="button"
            class="btn btn--ghost"
            data-copy={`To: ${author.email}\nSubject: ${defaultSubject}\n\n${defaultBody}`}
            id="copy-template"
          >
            <Copy size={14} class="btn__copy-icon" />
            <CheckCircle2 size={14} class="btn__copy-check" />
            <span class="btn__copy-text">Copy template</span>
          </button>
        </div>

        <p class="compose__hint">
          Tip: include a sentence about what you're working on. It almost always gets a faster reply.
        </p>
      </div>
    </section>

    <!-- SIGN-OFF -->
    <section class="signoff">
      <p class="signoff__line">
        <span class="prompt__dollar">$</span>
        <span>echo "talk soon" &gt;&gt; inbox</span>
      </p>
      <p class="signoff__sub">— {author.name}</p>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const COPY_RESET_MS = 1600;

  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Fallback: select-and-copy via temp textarea
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
      }
      btn.classList.add("is-copied");
      setTimeout(() => btn.classList.remove("is-copied"), COPY_RESET_MS);
    });
  });
</script>

<style>
  @reference "tailwindcss";

  .contact {
    @apply mx-auto max-w-4xl px-4 pb-20;
  }

  /* ── HERO ────────────────────────────────────────── */
  .hero {
    @apply pt-12 pb-10 md:pt-16 md:pb-12;
  }
  .prompt {
    @apply inline-flex flex-wrap items-center gap-1.5 text-xs mb-6 m-0;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prompt__user { color: var(--color-text); font-weight: 600; }
  .prompt__path { color: var(--color-accent); }
  .prompt__sep,
  .prompt__dollar { color: var(--color-muted); }
  .prompt__cmd { color: var(--color-text); }

  .hero__title {
    @apply text-4xl md:text-6xl font-bold leading-tight tracking-tight m-0;
    color: var(--color-text);
    font-family: var(--font-sans);
  }
  .hero__mark {
    background: linear-gradient(120deg, var(--color-accent), var(--color-accent-hover));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lede {
    @apply mt-5 text-base md:text-lg leading-relaxed max-w-2xl;
    color: var(--color-muted);
  }
  .hero__email {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
  }
  .hero__email:hover { color: var(--color-accent-hover); }
  .hero__strike { text-decoration: line-through; opacity: 0.7; }

  /* Status row */
  .status {
    @apply mt-7 flex flex-wrap gap-x-6 gap-y-2 list-none p-0 m-0 text-xs;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .status__item {
    @apply inline-flex items-center gap-1.5;
    color: var(--color-muted);
  }
  .status__k {
    color: var(--color-muted);
    opacity: 0.75;
  }
  .status__k::after { content: ":"; }
  .status__v { color: var(--color-text); }
  .status__dot {
    @apply inline-block w-1.5 h-1.5 rounded-full;
  }
  .status__dot--green {
    background: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.18);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.18); }
    50%      { box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.05); }
  }

  /* ── BLOCK ───────────────────────────────────────── */
  .block {
    @apply py-10 border-t;
    border-color: var(--color-border);
  }
  .block__header {
    @apply mb-6;
  }
  .kicker {
    @apply text-xs uppercase mb-1 m-0;
    color: var(--color-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
  }
  .block__title {
    @apply text-2xl md:text-3xl font-bold m-0;
    color: var(--color-text);
    font-family: var(--font-sans);
    letter-spacing: -0.02em;
  }

  /* ── CHANNELS ────────────────────────────────────── */
  .channels {
    @apply list-none p-0 m-0;
    border-top: 1px solid var(--color-border);
  }
  .channel {
    @apply relative flex items-stretch;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.18s ease;
  }
  .channel:hover {
    background-color: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }
  .channel--primary .channel__label { color: var(--color-accent); }

  .channel__main {
    @apply flex flex-1 items-center gap-3 md:gap-5 py-4 px-2 md:px-3 no-underline;
    color: inherit;
    display: grid;
    grid-template-columns: auto auto 1fr auto auto;
    align-items: center;
    column-gap: 0.875rem;
  }
  .channel__icon {
    color: var(--color-accent);
    display: inline-flex;
    width: 1.5rem;
    justify-content: center;
  }
  .channel__label {
    @apply text-sm font-semibold;
    color: var(--color-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    min-width: 4.5rem;
  }
  .channel__handle {
    @apply text-sm;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    word-break: break-all;
  }
  .channel__best {
    @apply hidden md:block text-xs text-right ml-auto;
    color: var(--color-muted);
    opacity: 0.85;
    max-width: 22rem;
  }
  .channel__arrow {
    @apply text-base;
    color: var(--color-muted);
    transition: transform 0.18s ease, color 0.18s ease;
  }
  .channel__main:hover .channel__arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  /* Copy button */
  .channel__copy {
    @apply relative inline-flex items-center justify-center w-9 mr-1;
    border: none;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.18s ease;
  }
  .channel__copy:hover { color: var(--color-accent); }
  .channel__copy-check {
    position: absolute;
    opacity: 0;
    transform: scale(0.6);
    color: #16a34a;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .channel__copy.is-copied .channel__copy-icon {
    opacity: 0;
  }
  .channel__copy.is-copied .channel__copy-check {
    opacity: 1;
    transform: scale(1);
  }

  /* ── TOPICS ──────────────────────────────────────── */
  .topics {
    @apply list-none p-0 m-0 grid gap-4 sm:grid-cols-2;
  }
  .topic {
    @apply flex items-start gap-3 p-4 rounded-lg;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .topic__icon {
    @apply inline-flex items-center justify-center w-8 h-8 rounded-md shrink-0;
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }
  .topic__kind {
    @apply text-sm font-semibold m-0 mb-0.5;
    color: var(--color-text);
  }
  .topic__text {
    @apply text-sm m-0 leading-relaxed;
    color: var(--color-muted);
  }

  /* ── COMPOSE ─────────────────────────────────────── */
  .compose {
    @apply rounded-xl overflow-hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .compose__chrome {
    @apply flex items-center gap-2 px-4 py-2.5;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .compose__dot {
    @apply inline-block w-2.5 h-2.5 rounded-full;
    background-color: var(--color-border);
  }
  .compose__file {
    @apply ml-2 text-xs;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .compose__head {
    @apply px-5 pt-4 pb-3;
    border-bottom: 1px dashed var(--color-border);
  }
  .compose__head p {
    @apply m-0 py-0.5 text-sm;
    color: var(--color-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .compose__k {
    color: var(--color-muted);
    display: inline-block;
    min-width: 5rem;
  }
  .compose__v { color: var(--color-text); }

  .compose__body {
    @apply px-5 py-4 m-0 text-sm leading-relaxed whitespace-pre-wrap;
    color: var(--color-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background-color: transparent;
  }

  .compose__actions {
    @apply flex flex-wrap gap-3 px-5 py-4;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }
  .compose__hint {
    @apply px-5 py-3 text-xs m-0;
    color: var(--color-muted);
    border-top: 1px dashed var(--color-border);
    background-color: var(--color-bg);
  }

  /* Buttons (local, monospace flavor to match the panel) */
  .btn {
    @apply inline-flex items-center gap-2 px-3.5 py-2 rounded-md text-sm font-semibold;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .btn--primary {
    background: var(--color-accent);
    color: white;
  }
  .btn--primary:hover {
    background: var(--color-accent-hover);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
    position: relative;
  }
  .btn--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .btn__copy-check {
    position: absolute;
    left: 0.875rem;
    opacity: 0;
    color: #16a34a;
    transition: opacity 0.2s ease;
  }
  .btn--ghost.is-copied .btn__copy-icon { opacity: 0; }
  .btn--ghost.is-copied .btn__copy-check { opacity: 1; }
  .btn--ghost.is-copied .btn__copy-text::after {
    content: "  ✓ copied";
    color: #16a34a;
  }
  .btn--ghost.is-copied .btn__copy-text {
    /* swap original text via mask */
    font-size: 0;
  }
  .btn--ghost.is-copied .btn__copy-text::after {
    font-size: 0.875rem;
  }

  /* ── SIGN-OFF ────────────────────────────────────── */
  .signoff {
    @apply mt-12 pt-6;
    border-top: 1px dashed var(--color-border);
  }
  .signoff__line {
    @apply text-sm m-0 inline-flex items-center gap-1.5;
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .signoff__sub {
    @apply text-sm mt-2 m-0;
    color: var(--color-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* ── RESPONSIVE TIGHTEN ──────────────────────────── */
  @media (max-width: 720px) {
    .channel__main {
      grid-template-columns: auto auto 1fr auto;
      column-gap: 0.625rem;
      padding-left: 0.5rem;
    }
    .channel__handle { font-size: 0.8125rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status__dot--green { animation: none; }
    .channel__main:hover .channel__arrow { transform: none; }
  }
</style>
